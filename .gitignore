# Keep proprietary/local inputs out of version control, including unknown files.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/docs/
/docs/**
!/docs/research/
!/docs/research/*.md
!/docs/research/*.json
!/docs/superpowers/
!/docs/superpowers/specs/
!/docs/superpowers/specs/*.md
!/docs/superpowers/plans/
!/docs/superpowers/plans/*.md
!/tools/
/tools/**
!/tools/*.py
!/tests/
/tests/**
!/tests/*.py
!/tests/*.cpp
!/tests/*.movie
!/tests/native/
!/tests/native/CMakeLists.txt
!/tests/native/*.cpp
!/patches/
/patches/**
!/patches/*.patch
!/games/
/games/**
!/games/sakura/
!/games/sakura/game.cfg
!/config/
/config/**
!/config/*.json

!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/VERSION
!/docs/releases/
!/docs/releases/*.md
!/assets/
/assets/**
!/assets/generated/
!/assets/generated/backgrounds/
!/assets/generated/backgrounds/*.png
!/assets/generated/backgrounds/*.json
!/assets/generated/backgrounds/*.md
!/assets/generated/pc-backgrounds/
!/assets/generated/pc-backgrounds/*.png
!/assets/generated/pc-backgrounds/*.json
!/assets/generated/pc-backgrounds/*.md
