# Keep proprietary/local inputs out of version control, including unknown files.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/docs/
/docs/**
!/docs/research/
!/docs/research/*.md
!/docs/research/*.json
!/docs/superpowers/
!/docs/superpowers/specs/
!/docs/superpowers/specs/*.md
!/docs/superpowers/plans/
!/docs/superpowers/plans/*.md
!/tools/
/tools/**
!/tools/*.py
!/tests/
/tests/**
!/tests/*.py
!/tests/*.cpp
!/tests/*.movie
!/tests/native/
!/tests/native/CMakeLists.txt
!/tests/native/*.cpp
!/patches/
/patches/**
!/patches/*.patch
!/games/
/games/**
!/games/sakura/
!/games/sakura/game.cfg
!/config/
/config/**
!/config/*.json
