# Keep proprietary/local inputs out of version control, including unknown files.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/docs/
/docs/**
!/docs/PENDIENTES.md
!/docs/PENDIENTES-HECHO.md
!/docs/HANDOFF.md
!/docs/ESTADO_ACTUAL.md
!/docs/SHARDS.md
!/docs/research/
!/docs/research/*.md
!/docs/research/*.json
!/docs/superpowers/
!/docs/superpowers/specs/
!/docs/superpowers/specs/*.md
!/docs/superpowers/plans/
!/docs/superpowers/plans/*.md
!/tools/
/tools/**
!/tools/*.py
!/tools/es/
!/tools/es/*.py
!/tools/controller_mapper.cpp
!/tools/controller_capture.h
!/tools/vdp_profile_sampler.h
!/tests/
/tests/**
!/tests/*.py
!/tests/*.cpp
!/tests/*.movie
!/tests/native/
!/tests/native/CMakeLists.txt
!/tests/native/*.cpp
!/patches/
/patches/**
!/patches/*.patch
!/patches/platform/
!/patches/platform/r36s-original-only.patch
!/patches/platform/r36s-aot-pages.patch
!/patches/platform/SaturnTaisen.sh
!/patches/platform/ga36-hd-2x-pilot.patch
!/patches/platform/ga36-sdl3-fbdev.patch
!/patches/platform/ga36-armhf-state.patch
!/patches/platform/ga36-diagnostic-wide.patch
!/patches/platform/ga36-launch.sh
!/patches/platform/saturntaisen-ga36.puppy
!/patches/platform/saturntaisen-ga36-en.puppy
!/games/
/games/**
!/games/sakura/
!/games/sakura/game.cfg
!/config/
/config/**
!/config/*.json

!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/VERSION
!/docs/releases/
!/docs/releases/*.md
!/docs/releases/v0.2.0-test.2-validation.json
!/docs/releases/v0.2.0-test.3-validation.json
!/assets/
/assets/**
!/assets/generated/
!/assets/generated/backgrounds/
!/assets/generated/backgrounds/*.png
!/assets/generated/backgrounds/*.json
!/assets/generated/backgrounds/*.md
!/assets/generated/pc-backgrounds/
!/assets/generated/pc-backgrounds/*.png
!/assets/generated/pc-backgrounds/*.json
!/assets/generated/pc-backgrounds/*.md
!/assets/generated/screen-backgrounds/
!/assets/generated/screen-backgrounds/*.png
!/assets/generated/screen-backgrounds/*.json
!/assets/generated/screen-backgrounds/*.md
!/assets/generated/tactical-extensions/
!/assets/generated/tactical-extensions/*.png
!/assets/generated/tactical-extensions/*.json
!/assets/generated/tactical-extensions/*.md

!/docs/releases/v0.2.0-test.4-validation.json
!/docs/releases/v0.2.2-alpha-validation.json
# Taisen language patches (video layer is a release asset only)
!/parches/
/parches/**
!/parches/parches.json
!/parches/CREDITOS.md
!/parches/ingles-v*-disc?.xdelta
!/parches/espanol-v*-disc?.xdelta
!/recomp-launcher.json
!/recomplauncher.json
