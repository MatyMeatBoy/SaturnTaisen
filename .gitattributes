# Line endings: LF in the repository and working copy, independent of core.autocrlf.
* text=auto eol=lf
*.png binary
*.xdelta binary
*.bat text eol=crlf
*.ps1 text eol=crlf
*.py text eol=lf
*.cpp text eol=lf
*.md text eol=lf
*.json text eol=lf
*.cfg text eol=lf
*.movie text eol=lf
# Unified-diff context uses a mandatory leading space, including blank lines.
# Keep patch bytes stable and do not flag that context as source whitespace.
*.patch -text whitespace=-blank-at-eol,-blank-at-eof
