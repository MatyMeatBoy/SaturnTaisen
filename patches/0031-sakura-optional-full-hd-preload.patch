             portraitPack.Open(std::filesystem::u8path(port.opt.settingsPath).parent_path()/"mods/hd-portraits",std::filesystem::u8path(port.opt.pcAssetsPath));
+        if(renderer && satrecomp::FeatureValue("hd_preload")==1) {
+            const bool usePc=!port.opt.pcAssetsPath.empty() && satrecomp::FeatureValue("pc_hd_backgrounds")==0;
+            const bool usePortraits=satrecomp::FeatureValue("pc_hd_portraits")==0;
+            const size_t portraitCount=usePortraits?portraitPack.VariantCount():0;
+            size_t backgroundCount=0;for(const auto& item:backdrops)if(!item.pc || usePc)backgroundCount++;
+            const size_t total=backgroundCount+portraitCount;
+            auto progress=[&](size_t done) {
+                int w=0,h=0;SDL_GetRenderOutputSize(renderer,&w,&h);
+                SDL_SetWindowTitle(window,("SaturnTaisenFirst - Precargando HD " + std::to_string(done)+"/"+std::to_string(total)).c_str());
+                SDL_SetRenderDrawColor(renderer,244,225,221,255);SDL_RenderClear(renderer);
+                const SDL_FRect rail{w*.15f,h*.48f,w*.7f,16},fill{rail.x,rail.y,total?rail.w*float(done)/float(total):rail.w,rail.h};
+                SDL_SetRenderDrawColor(renderer,220,185,191,255);SDL_RenderFillRect(renderer,&rail);
+                SDL_SetRenderDrawColor(renderer,167,67,98,255);SDL_RenderFillRect(renderer,&fill);SDL_RenderPresent(renderer);SDL_PumpEvents();
+            };
+            progress(0);size_t done=0,loaded=0;
+            for(auto& item:backdrops)if(!item.pc || usePc) {
+                item.attempted=true;
+                for(const auto& file:item.files) {
+                    item.texture=item.pc?LoadPcBackdrop(renderer,file,port.opt.pcAssetsPath,item.id,item.cacheDir,&item.pixels):
+                        LoadBackdrop(renderer,file,item.nativePalette,item.cacheDir,&item.pixels);
+                    if(item.texture) {loaded++;break;}
+                }
+                progress(++done);
+            }
+            if(usePortraits)portraitPack.Preload([&](size_t ready,size_t){progress(backgroundCount+ready);});
+            backgroundWarmupStarted=true;
+            if(std::getenv("SATRECOMP_HD_STATS"))fprintf(stderr,"HD preload: backgrounds=%zu/%zu portrait_variants=%zu\n",loaded,backgroundCount,portraitCount);
+            SDL_SetWindowTitle(window,"SaturnTaisenFirst 0.2-dev");
+        }
         SDL_SetRenderVSync(renderer, 0);
         return true;
     };
