+void Port::PrepareDialogueCatalog(std::span<const uint8_t> knownAtlas) {
+    if (dialogueCatalogTried || opt.headless || gpu || satrecomp::FeatureValue("presentation_mode") != 1 ||
+        satrecomp::FeatureValue("text_style") != 0 || !KnownEnglishAtlas(knownAtlas)) return;
+    dialogueCatalogTried = true;
+    const auto started = std::chrono::steady_clock::now();
+    auto catalog = std::make_shared<DialoguePreload>();
+    for (const auto &name : discFiles.Names()) {
+        if (!name.ends_with("TBL.BIN")) continue;
+        std::vector<uint8_t> bytes;
+        const size_t remaining = 8 * 1024 * 1024 - catalog->SourceBytes();
+        if (discFiles.ReadBounded(name, bytes, std::min(size_t(4 * 1024 * 1024), remaining)))
+            catalog->Add(name, bytes);
+    }
+    catalog->Seal();
+    if (std::getenv("SATRECOMP_DIALOGUE_TRACE")) {
+        const auto elapsed = std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now() - started).count();
+        fprintf(stderr,"dialogue preload: tables=%zu records=%zu ready=%zu bytes=%zu us=%lld\n",
+            catalog->TableCount(),catalog->RecordCount(),catalog->ReadyCount(),catalog->SourceBytes(),
+            static_cast<long long>(elapsed));
+    }
+    std::lock_guard lock(fbMutex);
+    dialogueCatalog = std::move(catalog);
+}
