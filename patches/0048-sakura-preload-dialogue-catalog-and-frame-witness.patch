+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+#include "dialogue_catalog.h"
+#include "glyph_text.h"
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstring>
+#include <utility>
+
+namespace port {
+
+struct DialogueWitness {
+    bool valid = false;
+    uint32_t table = 0, record = 0, offset = 0; // Offset from first text byte, including the NUL position.
+    bool operator==(const DialogueWitness&) const = default;
+};
+
+struct PreloadedDialogueLine {
+    uint32_t rawOffset = 0; // Offset from the record's first text byte.
+    std::u32string text;
+};
+
+struct PreloadedDialogueRecord {
+    uint32_t id = 0, index = 0, offset = 0; // Offset from the table start to the four-byte prefix.
+    uint16_t prefix0 = 0, prefix1 = 0;
+    std::string raw;
+    std::array<PreloadedDialogueLine,4> lines;
+    uint32_t lineCount = 0;
+    bool simple = false;
+};
+
+struct PreloadedDialogueTable {
+    std::string name;
+    uint64_t fingerprint = 0;
+    std::vector<uint8_t> bytes;
+    std::vector<PreloadedDialogueRecord> records;
+};
+
+class DialoguePreload {
+public:
+    static constexpr size_t MaxTables = 128;
+    static constexpr size_t MaxSourceBytes = 8 * 1024 * 1024;
+    static constexpr size_t MaxRecords = 65535;
+
+    bool Add(std::string name, std::span<const uint8_t> bytes) {
+        if (sealed_ || name.empty() || tables_.size() >= MaxTables ||
+            bytes.size() > MaxSourceBytes - sourceBytes_ || bytes.size() < 16 ||
+            std::any_of(tables_.begin(), tables_.end(), [&](const auto& table) { return table.name == name; }))
+            return false;
+        const uint64_t start = uint64_t(ReadBe32(bytes)) * 2;
+        if (start < 16 || (start - 8) / 8 > MaxRecords - recordCount_) return false;
+
+        std::vector<DialogueRecord> parsed;
+        if (!ParseEnglishTable(bytes, parsed)) return false;
+        PreloadedDialogueTable table;
+        table.name = std::move(name);
+        table.fingerprint = AtlasFingerprint(bytes);
+        table.bytes.assign(bytes.begin(), bytes.end());
+        table.records.reserve(parsed.size());
+        size_t ready = 0;
+        for (auto& item : parsed) {
+            PreloadedDialogueRecord record;
+            record.id = item.id;
+            record.index = static_cast<uint32_t>(table.records.size());
+            record.offset = item.offset;
+            record.prefix0 = item.prefix0;
+            record.prefix1 = item.prefix1;
+            record.raw = std::move(item.raw);
+            record.simple = PrepareLines(record);
+            ready += record.simple;
+            table.records.push_back(std::move(record));
+        }
+        tables_.push_back(std::move(table));
+        recordCount_ += parsed.size();
+        readyCount_ += ready;
+        sourceBytes_ += bytes.size();
+        return true;
+    }
+
+    void Seal() { sealed_ = true; }
+    bool Sealed() const { return sealed_; }
+    size_t TableCount() const { return tables_.size(); }
+    size_t RecordCount() const { return recordCount_; }
+    size_t ReadyCount() const { return readyCount_; }
+    size_t SourceBytes() const { return sourceBytes_; }
+    std::span<const PreloadedDialogueTable> Tables() const {
+        return sealed_ ? std::span<const PreloadedDialogueTable>(tables_) : std::span<const PreloadedDialogueTable>();
+    }
+
+    const PreloadedDialogueRecord* Get(DialogueWitness witness) const {
+        if (!sealed_ || !witness.valid || witness.table >= tables_.size()) return nullptr;
+        const auto& records = tables_[witness.table].records;
+        if (witness.record >= records.size() || witness.offset > records[witness.record].raw.size()) return nullptr;
+        return &records[witness.record];
+    }
+
+    DialogueWitness Locate(std::span<const uint8_t> low, std::span<const uint8_t> high) const {
+        constexpr size_t bankSize = 0x100000, tableAt = 0x24000, pointerAt = 0x6851c;
+        constexpr uint32_t tableAddress = 0x00224000;
+        if (!sealed_ || low.size() != bankSize || high.size() != bankSize) return {};
+        const uint32_t pointer = ReadBe32(high.subspan(pointerAt, 4));
+        if (pointer < tableAddress || pointer - tableAddress >= bankSize - tableAt) return {};
+        const size_t offset = pointer - tableAddress;
+        auto tableBytes = low.subspan(tableAt);
+        size_t matched = tables_.size();
+        for (size_t i = 0; i < tables_.size(); ++i) {
+            const auto& bytes = tables_[i].bytes;
+            if (bytes.size() > tableBytes.size() || std::memcmp(bytes.data(), tableBytes.data(), bytes.size())) continue;
+            if (matched != tables_.size()) return {};
+            matched = i;
+        }
+        if (matched == tables_.size()) return {};
+        const auto& records = tables_[matched].records;
+        auto next = std::upper_bound(records.begin(), records.end(), offset,
+            [](size_t address, const auto& record) { return address < record.offset; });
+        if (next == records.begin()) return {};
+        const auto& record = *--next;
+        const size_t text = record.offset + 4;
+        if (offset < text || offset - text > record.raw.size()) return {};
+        return {true, static_cast<uint32_t>(matched), record.index, static_cast<uint32_t>(offset - text)};
+    }
+
+private:
+    static uint32_t ReadBe32(std::span<const uint8_t> data) {
+        return uint32_t(data[0]) << 24 | uint32_t(data[1]) << 16 | uint32_t(data[2]) << 8 | data[3];
+    }
+
+    static bool PrepareLines(PreloadedDialogueRecord& record) {
+        std::array<PreloadedDialogueLine,4> lines;
+        size_t row = 0;
+        for (size_t i = 0; i < record.raw.size(); ++i) {
+            const auto byte = static_cast<uint8_t>(record.raw[i]);
+            if (byte == '\r') {
+                if (++row == lines.size()) return false;
+                lines[row].rawOffset = static_cast<uint32_t>(i + 1);
+                continue;
+            }
+            const char32_t character = GlyphCodepoint(byte);
+            if (!character || lines[row].text.size() == 31) return false;
+            lines[row].text.push_back(character);
+        }
+        record.lineCount = static_cast<uint32_t>(row + 1);
+        record.lines = std::move(lines);
+        return true;
+    }
+
+    std::vector<PreloadedDialogueTable> tables_;
+    size_t recordCount_ = 0, readyCount_ = 0, sourceBytes_ = 0;
+    bool sealed_ = false;
+};
+
+} // namespace port
