+bool DiscFiles::ReadBounded(const std::string &name, std::vector<uint8_t> &data, size_t maxBytes) const {
+    data.clear();
+    const auto it = m_files.find(Upper(name));
+    if (it == m_files.end() || it->second.size > maxBytes) return false;
+    const auto &file = it->second;
+    // Exact allocation and wide arithmetic avoid rounded-sector size overflow.
+    std::vector<uint8_t> result(file.size);
+    std::array<uint8_t, 2048> sector{};
+    for (size_t at = 0; at < result.size(); at += sector.size()) {
+        const uint64_t lba = uint64_t(file.lba) + at / sector.size();
+        if (lba > UINT32_MAX - 150 || !ReadSector(uint32_t(lba), sector.data())) return false;
+        const size_t count = std::min(sector.size(), result.size() - at);
+        std::memcpy(result.data() + at, sector.data(), count);
+    }
+    data = std::move(result);
+    return true;
+}
+
 bool DiscFiles::ReadFirstFile(std::vector<uint8_t> &data) const {
     return m_first.lba && ReadExtent(m_first, data);
 }
