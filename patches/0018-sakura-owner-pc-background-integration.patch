+        {"KABE00","KABE0100",0xB805053B9EA1CCD8ull,165760},
+        {"KABE01","KABE0101",0x635B6C1F4B077F64ull,186953},
+        {"KABE10","KABE0200",0xB88BB5C43A5BF56Eull,187651},
+        {"KABE11","KABE0201",0xCFBB0D1193F6DFAEull,223730},
+        {"KABE20","KABE0300",0x10835D5EBF005031ull,193425},
+        {"KABE21","KABE0301",0x40452520DC936E84ull,213058},
+        {"KABE30","KABE0400",0x9820B24D1902B87Bull,153874},
+        {"KABE31","KABE0401",0x6539600A34FB8A30ull,189404},
+        {"KABE40","KABE0500",0x11CA09A975FA131Bull,188769},
+        {"KABE41","KABE0501",0x14932637FCD5AE46ull,190241},
+        {"KABE50","KABE0600",0xADE63261E4500827ull,134589},
+        {"KABE51","KABE0601",0x8FDC83CE46C82441ull,194127},
+        {"KABE60","KABE0700",0xA7127701C9833ED0ull,207467},
+        {"KABE61","KABE0701",0xCB5C96B5F3A25834ull,235094},
+        {"KABE70","KABE0800",0x82E4B9C7222605FCull,151754},
+        {"KABE71","KABE0801",0x042E7EA37AEE1A53ull,206876},
+        {"KABE80","KABE0900",0xDC90BCADA6DEDE99ull,177315},
+        {"KABE81","KABE0901",0x3F3011FA7AA7124Aull,200070},
+        {"KABE90","KABE1000",0x37A95B9744D6E9A1ull,157709},
+        {"KABE91","KABE1000",0x37A95B9744D6E9A1ull,157709},
+    };
+    for(const auto& entry:entries)if(entry.saturn==id)return &entry;
+    return nullptr;
+}
