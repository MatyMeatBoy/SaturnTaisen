diff --git a/port/pc_backdrop.h b/port/pc_backdrop.h
new file mode 100644
index 0000000..bff275d
--- /dev/null
+++ b/port/pc_backdrop.h
@@ -0,0 +1,74 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include "backdrop.h"
+#include "pc_spr.h"
+#include "pc_backdrop_ids.h"
+#include <algorithm>
+namespace port {
+inline SDL_Surface* NormalizePcBackdrop(SDL_Surface* master,std::span<const uint32_t> native) {
+    if(!master || native.empty() || native.size()>640*480)return nullptr;
+    auto key=[](uint32_t p){return ((p&255)>>3)<<10|(((p>>8)&255)>>3)<<5|(((p>>16)&255)>>3);};
+    std::array<bool,32768> seen{};std::vector<uint32_t> palette;
+    for(auto p:native)if(!seen[key(p)]) {seen[key(p)]=true;palette.push_back(p|0xFF000000u);}
+    auto* logical=SDL_CreateSurface(864,486,SDL_PIXELFORMAT_ABGR8888);if(!logical)return nullptr;
+    SDL_SetSurfaceBlendMode(master,SDL_BLENDMODE_NONE);
+    if(!SDL_BlitSurfaceScaled(master,nullptr,logical,nullptr,SDL_SCALEMODE_NEAREST)) {SDL_DestroySurface(logical);return nullptr;}
+    std::array<uint32_t,32768> mapped{};
+    for(int y=0;y<logical->h;y++) {
+        auto* row=reinterpret_cast<uint32_t*>(static_cast<uint8_t*>(logical->pixels)+y*logical->pitch);
+        for(int x=0;x<logical->w;x++) {
+            const auto q=key(row[x]);
+            if(!mapped[q]) {
+                const int r=int(q>>10)*255/31,g=int((q>>5)&31)*255/31,b=int(q&31)*255/31;
+                int best=200000;uint32_t chosen=palette.front();
+                for(auto p:palette) {
+                    const int dr=r-int(p&255),dg=g-int((p>>8)&255),db=b-int((p>>16)&255);
+                    const int distance=dr*dr+dg*dg+db*db;
+                    if(distance<best) {best=distance;chosen=p;if(!distance)break;}
+                }
+                mapped[q]=chosen;
+            }
+            row[x]=mapped[q];
+        }
+    }
+    return logical;
+}
+inline bool ReadPcBackdropFile(const std::filesystem::path& file,std::vector<uint8_t>& bytes,size_t limit) {
+    std::ifstream in(file,std::ios::binary|std::ios::ate);
+    if(!in || in.tellg()<=0 || static_cast<uint64_t>(in.tellg())>limit)return false;
+    bytes.resize(static_cast<size_t>(in.tellg()));in.seekg(0);
+    return bool(in.read(reinterpret_cast<char*>(bytes.data()),bytes.size()));
+}
+inline uint64_t PcBackdropHash(std::span<const uint8_t> bytes,uint64_t hash=14695981039346656037ull) {
+    for(auto byte:bytes)hash=(hash^byte)*1099511628211ull;
+    return hash;
+}
+inline SDL_Texture* LoadPcBackdrop(SDL_Renderer* renderer,const std::filesystem::path& masterFile,const std::filesystem::path& pcRoot,std::string_view saturn,const std::filesystem::path& cacheDir,std::vector<uint32_t>* pixels,bool requireCache=false) {
+    if(requireCache && cacheDir.empty())return nullptr;
+    const auto* info=PcBackdropFor(saturn);if(!info)return nullptr;
+    std::vector<uint8_t> source,master;
+    if(!ReadPcBackdropFile(pcRoot/"SAKURA1"/"WALL"/(std::string(info->id)+".SPR"),source,4*1024*1024) ||
+       source.size()!=info->bytes || PcBackdropHash(source)!=info->fingerprint ||
+       !ReadPcBackdropFile(masterFile,master,16*1024*1024))return nullptr;
+    const auto hash=PcBackdropHash(master,info->fingerprint);
+    std::filesystem::path cache;SDL_Surface* logical=nullptr;
+    if(!cacheDir.empty()) {
+        cache=cacheDir/(std::string(info->id)+"-pc864-v1-"+std::to_string(hash)+".png");
+        logical=SDL_LoadPNG(cache.string().c_str());
+        if(logical && (logical->w!=864 || logical->h!=486)) {SDL_DestroySurface(logical);logical=nullptr;}
+    }
+    if(!logical) {
+        std::vector<PcSprite> images;std::string error;
+        if(!DecodePcSprites(source,images,error) || images.size()!=1 || images[0].width!=640 || images[0].height!=480)return nullptr;
+        auto* bitmap=SDL_LoadPNG(masterFile.string().c_str());
+        logical=NormalizePcBackdrop(bitmap,images[0].pixels);if(bitmap)SDL_DestroySurface(bitmap);
+        if(!logical)return nullptr;
+        if(!cache.empty()) {
+            std::error_code ignored;std::filesystem::create_directories(cacheDir,ignored);
+            const bool saved=!ignored && SDL_SavePNG(logical,cache.string().c_str());
+            if(!saved && requireCache) {SDL_DestroySurface(logical);return nullptr;}
+        }
+    }
+    return BackdropTexture(renderer,logical,pixels);
+}
+}
