 #include <string_view>
 namespace port {
 struct VerifiedBodyFace { uint64_t hash; unsigned width, height, pcIndex; int pcX=-1, pcY=-1; };
+struct VerifiedBakedFace {
+    uint64_t hash=0;
+    unsigned width=0, height=0;
+    int x=0, y=0;
+    constexpr bool matches(uint64_t pixels, unsigned w, unsigned h, int dx, int dy) const {
+        return hash && hash==pixels && width==w && height==h && x==dx && y==dy;
+    }
