diff --git a/port/bg1207_verified_pan.h b/port/bg1207_verified_pan.h
new file mode 100644
--- /dev/null
+++ b/port/bg1207_verified_pan.h
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+#include "bg2533_verified_pan.h"
+
+namespace port {
+inline constexpr unsigned kBG1207Width = 512;
+inline constexpr unsigned kBG1207Height = 144;
+inline constexpr size_t kBG1207Bytes = 79952;
+inline constexpr uint64_t kBG1207Palette = 0x6EE7138F39DF8CFEull;
+inline constexpr uint64_t kBG1207Cells = 0x7F3401C09AF54AA3ull;
+
+inline std::optional<unsigned> FindBG1207Offset(
+    std::span<const uint32_t> picture, std::span<const uint32_t> frame,
+    std::span<const uint8_t> top, bool opaqueActorLayer) {
+    if (picture.size() != kBG1207Width * kBG1207Height || frame.size() != kPanFrameWidth * kPanFrameHeight ||
+        top.size() != frame.size()) return {};
+    const auto agrees = [&](unsigned start, unsigned x, unsigned y) {
+        const auto at = (y + kPanPictureOffsetY) * kPanFrameWidth + x + kPanPictureOffsetX;
+        const auto expected = picture[y * kBG1207Width + start + x];
+        if (top[at] == 4) return (frame[at] & 0xFFFFFF) == expected;
+        return top[at] == 2 && opaqueActorLayer;
+    };
+    std::optional<unsigned> result;
+    for (unsigned offset = 0; offset <= kBG1207Width - kPanInsetWidth; ++offset) {
+        if (!agrees(offset, 17, 13) || !agrees(offset, 139, 77) || !agrees(offset, 247, 114)) continue;
+        bool verified = true;
+        unsigned foreground = 0;
+        for (unsigned y = 0; y < kBG1207Height && verified; ++y) {
+            for (unsigned x = 0; x < kPanInsetWidth; ++x) {
+                const auto at = (y + kPanPictureOffsetY) * kPanFrameWidth + x + kPanPictureOffsetX;
+                // Keep the verified foreground small so the native viewport identifies the crop.
+                if (!agrees(offset, x, y) || (top[at] == 2 && ++foreground > 1024)) {
+                    verified = false;
+                    break;
+                }
+            }
+        }
+        if (!verified) continue;
+        if (result) return {};
+        result = offset;
+    }
+    return result;
+}
+}
