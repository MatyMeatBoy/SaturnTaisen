+    // TW1: second key of a scene picture whose palette is shared with another picture: FNV-1a 64 of the `bytes` of cell data that start at
+    // the picture's first cell. The game copies the cell data of the picture to VRAM in order, one 8x8 cell of 64 bytes after the other
+    // (two character numbers apart), and the map names each of them once; the map's other entries repeat a filler cell. So the first cell is
+    // the lowest character number the first page names exactly once. Same hash as `cells_fnv` in config/hd-scene-bg-map.json. Only meant for
+    // palettes in kSceneBgAmbiguous (it walks the 64x64 names of the page).
+    uint64_t BackgroundCellFingerprint(uint32 layer, uint32 bytes) const {
+        if(layer<1 || layer>5)return 0;
+        const auto& bg=m_regs2.bgParams[layer-1];
+        std::vector<uint8> uses(0x8000,0);
+        for(uint32 entry=0;entry<64*64;entry++) {
+            uint32 number;
+            if(bg.twoWordChar)number=Vram2Long(bg.pageBaseAddresses[0]+entry*4)&0x7FFF;
+            else {   // the one word pattern name of layers.cpp (OneWordChar): number bits plus the supplementary bits of the register
+                const uint32 word=Vram2Word(bg.pageBaseAddresses[0]+entry*2);
+                const bool fourCell=bg.cellSizeShift!=0;
+                const uint32 numberBits=bg.extChar?12:10,supplStart=2*fourCell+2*bg.extChar;
+                number=(word&((1u<<numberBits)-1))<<(2*fourCell);
+                number|=((bg.supplScrollCharNum&0x1F)>>supplStart)<<(10+supplStart);
+                if(fourCell)number|=bg.supplScrollCharNum&3;
+                number&=0x7FFF;
+            }
+            if(uses[number]<2)uses[number]++;
+        }
+        uint32 first=0x8000;
+        for(uint32 number=0;number<0x8000;number++)if(uses[number]==1) {first=number;break;}
+        if(first==0x8000)return 0;
+        const uint32 address=first*0x20;   // a character number counts units of 0x20 bytes
+        uint64_t hash=14695981039346656037ull;
+        for(uint32 i=0;i<bytes;i++)hash=(hash^m_mem.vram2[(address+i)&0x7FFFF])*1099511628211ull;
+        return hash;
+    }
+    // Debug aid (TW1): writes the whole VDP2 VRAM (512 KB) to a file and returns the address the layer's first character points at.
+    uint32 DumpBackgroundVram(uint32 layer,const char* path) const {
+        if(layer<1 || layer>5)return 0;
+        if(FILE* f=fopen(path,"wb")) {fwrite(m_mem.vram2,1,0x80000,f);fclose(f);}
+        const auto& bg=m_regs2.bgParams[layer-1];
+        return bg.pageBaseAddresses[0];
+    }
     std::array<int16_t,3> BackgroundColorOffset(uint32 layer=5) const {
         if(layer>6 || !m_regs2.colorOffsetEnable[layer])return {};
         const auto& offset=m_regs2.colorOffset[m_regs2.colorOffsetSelect[layer]];
