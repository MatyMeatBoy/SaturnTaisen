@@ -0,0 +1,66 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace port {
+
+struct EveRect {
+    int x;
+    int y;
+    int width;
+    int height;
+    constexpr bool operator==(const EveRect&) const = default;
+};
+
+inline constexpr std::uint64_t kEve202Palette = 0x0D97B7C3CC0B3C31;
+inline constexpr EveRect kEve202NativeRect{16, 8, 288, 144};
+inline constexpr EveRect kEve202PcCrop{0, 20, 564, 282};
+inline constexpr int kEve202PcWidth = 576;
+inline constexpr int kEve202PcHeight = 320;
+inline constexpr char kEve202PcFile[] = "SAKURA2/BG/BBG202.SPR";
+inline constexpr unsigned kEve202PcImage = 0;
+
+struct EveInsetFrame {
+    std::span<const std::uint8_t> source;
+    std::uint64_t layer5Palette;
+    int width;
+    int height;
+    bool layer5OpaqueAtUnitScroll;
+};
+
+inline bool IsEve202Inset(const EveInsetFrame& frame) {
+    constexpr int nativeWidth = 320;
+    constexpr int nativeHeight = 224;
+    constexpr std::uint8_t insetLayer = 5;
+    if (frame.layer5Palette != kEve202Palette || !frame.layer5OpaqueAtUnitScroll ||
+        frame.width != nativeWidth || frame.height != nativeHeight ||
+        frame.source.size() != nativeWidth * nativeHeight) {
+        return false;
+    }
+
+    for (int y = 0; y < nativeHeight; ++y) {
+        for (int x = 0; x < nativeWidth; ++x) {
+            const bool insideInset = x >= kEve202NativeRect.x &&
+                                     x < kEve202NativeRect.x + kEve202NativeRect.width &&
+                                     y >= kEve202NativeRect.y &&
+                                     y < kEve202NativeRect.y + kEve202NativeRect.height;
+            if (insideInset != (frame.source[std::size_t(y) * nativeWidth + x] == insetLayer)) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+constexpr EveRect Eve202Destination(int canvasX, int canvasY, int integerScale) {
+    return {
+        canvasX + kEve202NativeRect.x * integerScale,
+        canvasY + kEve202NativeRect.y * integerScale,
+        kEve202NativeRect.width * integerScale,
+        kEve202NativeRect.height * integerScale,
+    };
+}
+
+}  // namespace port
