diff --git a/port/dev_states.h b/port/dev_states.h
new file mode 100644
index 0000000..169886b
--- /dev/null
+++ b/port/dev_states.h
@@ -0,0 +1,17 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// Save states, load states, quick states and the reset point are tools for testing the game (owner rule 2026-11-19: the game is played
+// naturally and these never reach the players). They work in development builds and are switched off whenever a `release.marker` file
+// sits beside the executable, which tools/package_release.py writes into every package.
+#pragma once
+#include <SDL3/SDL.h>
+#include <filesystem>
+namespace port {
+inline bool DevStatesAllowed() {
+    static const bool allowed = [] {
+        const char* folder = SDL_GetBasePath();
+        std::error_code error;
+        return !(folder && std::filesystem::exists(std::filesystem::u8path(folder) / "release.marker", error));
+    }();
+    return allowed;
+}
+}
