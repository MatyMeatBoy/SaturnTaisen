@@ -9,6 +9,25 @@ inline IntegerViewport CoverInteger(int width,int height,int columns,int lines)
     const int k=std::max({1,1+(width-1)/columns,1+(height-1)/lines});
     return {(width-columns*k)/2,(height-lines*k)/2,columns*k,lines*k,k};
 }
+inline bool IsOldPictureShadow(int x,int y,int layer) {
+    return layer==3 && x>=20 && x<308 && y>=153 && y<156;
+}
+struct SceneZoomLayout {
+    bool valid=false;
+    IntegerViewport picture{},dialogue{};
+    int shadow=0,gap=0;
+};
+inline SceneZoomLayout FitSceneZoom(int width,int height,int dialogueWidth,int dialogueLines,int groupLines) {
+    if(width<=0 || height<=0 || dialogueWidth<=0 || dialogueLines<=0 || groupLines<=0)return {};
+    const int boxScale=std::min(width/dialogueWidth,height/groupLines);
+    if(boxScale<1)return {};
+    const int gap=std::max(1,boxScale/3);
+    const int pictureScale=std::min(width/296,(height-dialogueLines*boxScale-gap)/148);
+    if(pictureScale<1)return {};
+    const int shadow=4*pictureScale;
+    return {true,{(width-288*pictureScale)/2,0,288*pictureScale,144*pictureScale,pictureScale},
+        {(width-dialogueWidth*boxScale)/2,height-dialogueLines*boxScale,dialogueWidth*boxScale,dialogueLines*boxScale,boxScale},shadow,gap};
+}
 struct SceneLayout {
     bool recognized=false,movieOnly=false;
     int x=0,y=0,w=0,h=0;
