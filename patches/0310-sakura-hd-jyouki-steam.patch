+                        std::vector<uint8_t> bytes;
+                        std::string error;
+                        constexpr size_t fileSize = 27574;
+                        if (!ReadPcBackdropFile(path, bytes, fileSize) || bytes.size() != fileSize ||
+                            PcBackdropHash(bytes) != 0x00BDF79E82007CFCull ||
+                            !DecodePcSprites(bytes, images, error)) return std::vector<PcSprite>{};
+                        std::erase_if(images, [](const auto& image) {
+                            if (image.index >= std::size(steamFrames)) return true;
+                            const auto& shape = steamFrames[image.index];
+                            return image.width != 2 * shape.width || image.height != 2 * shape.height ||
+                                   image.pixels.size() != size_t(image.width) * image.height;
+                        });
+                        return images;
+                    });
+            }
+            if (steamPending.valid() && steamPending.wait_for(std::chrono::seconds(0)) == std::future_status::ready)
+                steamArt = steamPending.get();
+            const auto art = std::ranges::find_if(steamArt, [index](const auto& image) {return image.index == index;});
+            if (art == steamArt.end()) continue;
+
+            // Reject pixels within the bounds of subsequent draws. A
+            // non-axis-aligned or otherwise unknown draw keeps this puff native.
+            std::vector<EveRect> covers;
+            bool safe = true;
+            for (auto later = std::next(it); later != planes.sprites.end(); ++later) {
+                const auto& w = later->command.words;
+                const unsigned type = w[0] & 15;
+                if (type >= 8) continue;
+                int cols = ((w[5] >> 8) & 63) * 8, rows = w[5] & 255;
+                if (type == 2) {
+                    const int x = coord(w[6]), y = coord(w[7]), right = coord(w[8]), bottom = coord(w[11]);
+                    if (right < x || bottom < y || coord(w[9]) != y || coord(w[10]) != right ||
+                        coord(w[12]) != x || coord(w[13]) != bottom) { safe = false; break; }
+                    cols = right - x + 1; rows = bottom - y + 1;
+                } else if (type != 0) { safe = false; break; }
+                if (later->x < it->x + int(width) && later->x + std::max(cols, 1) > it->x &&
+                    later->y < it->y + int(height) && later->y + std::max(rows, 1) > it->y)
+                    covers.push_back({later->x, later->y, std::max(cols, 1), std::max(rows, 1)});
+            }
+            if (!safe) continue;
+            const unsigned stride = 2 * width;
+            std::fill_n(steamPixels.begin(), 4 * width * height, 0);
+            const bool flip = (cmd[0] & 0x10) != 0;
+            bool drew = false;
+            for (unsigned y = 0; y < height; ++y) for (unsigned x = 0; x < width; ++x) {
+                const int sx = it->x + int(x), sy = it->y + int(y);
