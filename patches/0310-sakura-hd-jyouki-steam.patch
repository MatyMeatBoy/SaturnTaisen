+            const auto& cmd = it->command.words;
+            if ((cmd[0] & 0xFFEF) != 0x1000 || cmd[2] != 0x0080 || cmd[3] != 0xC560 ||
+                it->x < -40 || it->x >= 320 || it->y < -32 || it->y >= 100) continue;
+            const unsigned width = ((cmd[5] >> 8) & 63) * 8, height = cmd[5] & 255;
+            if (it->pixels.size() != size_t(width) * height / 2 ||
+                width == 0 || height == 0 || width > 40 || height > 32) continue;
