 // Runs the helper over the player's files: what they chose (any disc, image or folder: the rest is looked for
 // beside it) and the «roms» folder. Discs and the PC edition (HD mod) come out of the same step.
+bool PreparedUpdateNeeded(const launcher::PageContext& page) {
+    std::ifstream version(page.program_folder/"VERSION");
+    std::ifstream applied(page.folder/"prepared-release.txt");
+    std::string current,prepared;
+    return std::getline(version,current) && !current.empty() &&
+           (!std::getline(applied,prepared) || prepared!=current);
+}
