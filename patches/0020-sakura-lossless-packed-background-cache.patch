diff --git a/port/background_codec.h b/port/background_codec.h
new file mode 100644
index 0000000..3118409
--- /dev/null
+++ b/port/background_codec.h
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <algorithm>
+#include <utility>
+#include <cstdint>
+#include <span>
+#include <unordered_map>
+#include <vector>
+#include <zlib.h>
+namespace port {
+inline constexpr size_t kMaxBackgroundPixels=864*486;
+struct PackedBackgroundPixels {unsigned format=0;std::vector<uint8_t> bytes;};
+struct StoredBackgroundPixels {unsigned codec=0;std::vector<uint8_t> bytes;};
+inline PackedBackgroundPixels PackBackgroundPixels(std::span<const uint32_t> pixels) {
+    if(pixels.empty() || pixels.size()>kMaxBackgroundPixels)return {};
+    PackedBackgroundPixels result;result.bytes.resize(pixels.size()*4);
+    std::unordered_map<uint32_t,uint16_t> indices;indices.reserve(257);
+    std::vector<uint32_t> palette;std::vector<uint8_t> indexed;indexed.reserve(pixels.size());
+    bool canIndex=true,shift=true,full=true;
+    for(size_t i=0;i<pixels.size();i++) {
+        const auto p=pixels[i];
+        for(int c=0;c<4;c++)result.bytes[i*4+c]=static_cast<uint8_t>(p>>(8*c));
+        if((p>>24)!=255)shift=full=false;
+        for(unsigned c=0;c<3;c++) {
+            const unsigned value=(p>>(8*c))&255;
+            shift&=value==((value>>3)<<3);full&=value==((value>>3)*255/31);
+        }
+        if(canIndex) {
+            auto [entry,inserted]=indices.emplace(p,static_cast<uint16_t>(palette.size()));
+            if(inserted) {
+                if(palette.size()==256) {canIndex=false;continue;}
+                palette.push_back(p);
+            }
+            indexed.push_back(static_cast<uint8_t>(entry->second));
+        }
+    }
+    if(shift || full) {
+        result.format=shift?2:3;result.bytes.resize(pixels.size()*2);
+        for(size_t i=0;i<pixels.size();i++) {
+            const uint32_t p=pixels[i];const unsigned value=((p&255)>>3)<<10|(((p>>8)&255)>>3)<<5|(((p>>16)&255)>>3);
+            result.bytes[i*2]=static_cast<uint8_t>(value);result.bytes[i*2+1]=static_cast<uint8_t>(value>>8);
+        }
+    }
+    if(canIndex && 2+palette.size()*4+pixels.size()<result.bytes.size()) {
+        result.format=1;result.bytes.resize(2+palette.size()*4+pixels.size());
+        result.bytes[0]=static_cast<uint8_t>(palette.size());result.bytes[1]=static_cast<uint8_t>(palette.size()>>8);
+        for(size_t i=0;i<palette.size();i++)for(int c=0;c<4;c++)result.bytes[2+i*4+c]=static_cast<uint8_t>(palette[i]>>(8*c));
+        std::copy(indexed.begin(),indexed.end(),result.bytes.begin()+2+palette.size()*4);
+    }
+    return result;
+}
+inline bool UnpackBackgroundPixels(std::span<const uint8_t> bytes,unsigned format,size_t count,std::vector<uint32_t>& pixels) {
+    pixels.clear();
+    if(!count || count>kMaxBackgroundPixels || format>3)return false;
+    size_t paletteCount=0,offset=0;
+    if(format==0 && bytes.size()!=count*4)return false;
+    if(format>=2 && bytes.size()!=count*2)return false;
+    if(format==1) {
+        if(bytes.size()<2)return false;
+        paletteCount=bytes[0]|(unsigned(bytes[1])<<8);offset=2+paletteCount*4;
+        if(!paletteCount || paletteCount>256 || bytes.size()!=offset+count)return false;
+    }
+    pixels.resize(count);
+    for(size_t i=0;i<count;i++) {
+        if(format<=1) {
+            size_t at=i*4;
+            if(format==1) {
+                const unsigned index=bytes[offset+i];
+                if(index>=paletteCount) {pixels.clear();return false;}
+                at=2+index*4;
+            }
+            pixels[i]=uint32_t(bytes[at])|(uint32_t(bytes[at+1])<<8)|(uint32_t(bytes[at+2])<<16)|(uint32_t(bytes[at+3])<<24);
+        } else {
+            const unsigned value=bytes[i*2]|(unsigned(bytes[i*2+1])<<8);
+            if(value&0x8000) {pixels.clear();return false;}
+            auto expand=[&](unsigned n){return format==2?n<<3:n*255/31;};
+            pixels[i]=0xFF000000u|expand((value>>10)&31)|(expand((value>>5)&31)<<8)|(expand(value&31)<<16);
+        }
+    }
+    return true;
+}
+inline StoredBackgroundPixels CompressBackgroundPixels(std::span<const uint8_t> bytes,bool compress) {
+    if(bytes.empty() || bytes.size()>kMaxBackgroundPixels*4)return {};
+    StoredBackgroundPixels result{0,std::vector<uint8_t>(bytes.begin(),bytes.end())};
+    if(compress) {
+        uLongf size=compressBound(static_cast<uLong>(bytes.size()));std::vector<uint8_t> packed(size);
+        if(compress2(packed.data(),&size,bytes.data(),static_cast<uLong>(bytes.size()),Z_BEST_SPEED)==Z_OK && size<bytes.size()) {
+            packed.resize(size);result={1,std::move(packed)};
+        }
+    }
+    return result;
+}
+inline bool DecompressBackgroundPixels(std::span<const uint8_t> bytes,unsigned codec,size_t expected,std::vector<uint8_t>& output) {
+    output.clear();
+    if(!expected || expected>kMaxBackgroundPixels*4 || codec>1 || bytes.empty() || bytes.size()>expected)return false;
+    if(!codec) {
+        if(bytes.size()!=expected)return false;
+        output.assign(bytes.begin(),bytes.end());return true;
+    }
+    output.resize(expected);uLongf size=static_cast<uLongf>(expected);uLong sourceSize=static_cast<uLong>(bytes.size());
+    if(uncompress2(output.data(),&size,bytes.data(),&sourceSize)!=Z_OK || size!=expected || sourceSize!=bytes.size()) {output.clear();return false;}
+    return true;
+}
+}
