diff --git a/port/title_flash.h b/port/title_flash.h
new file mode 100644
index 0000000..aa67ab3
--- /dev/null
+++ b/port/title_flash.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <optional>
+#include <span>
+
+namespace port {
+// LOGO.SH2's observed direct-RGB full-screen flash, not a generic flat-frame rule.
+// Metadata and pixels must belong to the same presented framebuffer.
+template<class Sprite>
+std::optional<uint32_t> AnalyzeTitleFlash(std::span<const uint32_t> frame,
+        std::span<const uint8_t> source, uint64_t titlePalette,
+        std::span<const Sprite> sprites) {
+    constexpr size_t area=320*224;
+    if(titlePalette!=0x91E480C617AD7F6Cull || frame.size()!=area || source.size()!=area ||
+       sprites.empty() || sprites.size()>4096) return {};
+    const Sprite* flash=nullptr;
+    for(auto at=sprites.rbegin();at!=sprites.rend();++at) {
+        if((at->command.words[0]&15)>=8) continue;
+        flash=&*at;break;
+    }
+    if(!flash) return {};
+    const auto& cmd=flash->command.words;
+    if(cmd[0]!=0x1000 || cmd[2]!=0x00a8 || cmd[3]!=0 || cmd[5]!=0x28e0 ||
+       flash->x!=0 || flash->y!=0 || flash->pixels.size()!=area*2) return {};
+    // Exact observed surface. A partially covered petal field must not be promoted.
+    for(size_t i=0;i<flash->pixels.size();i+=2)
+        if(flash->pixels[i]!=0xff || flash->pixels[i+1]!=0xbf) return {};
+    const auto color=frame.front();
+    if((color>>24)!=0xff ||
+       !std::all_of(frame.begin(),frame.end(),[&](auto p){return p==color;}) ||
+       !std::all_of(source.begin(),source.end(),[](auto layer){return layer==0;})) return {};
+    return color;
+}
+}
