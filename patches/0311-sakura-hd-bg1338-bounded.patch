diff --git a/port/bounded_plate.h b/port/bounded_plate.h
new file mode 100644
--- /dev/null
+++ b/port/bounded_plate.h
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace port {
+struct BoundedPlateRegistration {
+    double scaleX, scaleY, offsetX, offsetY;
+    std::array<double, 3> gain, lift;
+    int preserveTopRows, topFeather, rimFeather;
+};
+
+inline std::vector<uint32_t> RegisterBoundedPlate(std::span<const uint32_t> native,
+        std::span<const uint32_t> donor, int width, int height, int donorWidth, int donorHeight,
+        const BoundedPlateRegistration& geometry) {
+    if (width <= 0 || height <= 0 || donorWidth < 2 || donorHeight < 2 ||
+        native.size() != size_t(width) * height || donor.size() != size_t(donorWidth) * donorHeight) return {};
+    using Rgb = std::array<double, 3>;
+    const auto unpack = [](uint32_t pixel) -> Rgb {
+        return {double(pixel & 255), double((pixel >> 8) & 255), double((pixel >> 16) & 255)};
+    };
+    const auto smoothstep = [](double t) {
+        t = std::clamp(t, 0.0, 1.0);
+        return t * t * (3 - 2 * t);
+    };
+    const int w = width * 2, h = height * 2;
+    std::vector<Rgb> registered(size_t(w) * h), toneDelta(registered.size()), scratch(registered.size());
+    std::vector<double> weight(registered.size());
+    for (int y = 0; y < h; ++y) for (int x = 0; x < w; ++x) {
+        const auto at = size_t(y) * w + x;
+        const double nx = (x + 0.5) / 2, ny = (y + 0.5) / 2;
+        const double px = nx * geometry.scaleX + geometry.offsetX - 0.5;
+        const double py = ny * geometry.scaleY + geometry.offsetY - 0.5;
+        const int ix = std::clamp(int(px), 0, donorWidth - 2);
+        const int iy = std::clamp(int(py), 0, donorHeight - 2);
+        const double xf = std::clamp(px - ix, 0.0, 1.0), yf = std::clamp(py - iy, 0.0, 1.0);
+        const auto first = size_t(iy) * donorWidth + ix;
+        const auto a = unpack(donor[first]), b = unpack(donor[first + 1]);
+        const auto c = unpack(donor[first + donorWidth]), d = unpack(donor[first + donorWidth + 1]);
+        const auto nativeRgb = unpack(native[size_t(y / 2) * width + x / 2]);
+        for (int channel = 0; channel < 3; ++channel) {
+            const auto top = a[channel] * (1 - xf) + b[channel] * xf;
+            const auto bottom = c[channel] * (1 - xf) + d[channel] * xf;
+            registered[at][channel] = std::clamp((top * (1 - yf) + bottom * yf) *
+                geometry.gain[channel] + geometry.lift[channel], 0.0, 255.0);
+            toneDelta[at][channel] = nativeRgb[channel] - registered[at][channel];
+        }
+        if (px < 0 || py < 0 || px >= donorWidth - 1 || py >= donorHeight - 1) continue;
+        const auto top = smoothstep((ny - geometry.preserveTopRows) / geometry.topFeather);
+        const auto rim = smoothstep(std::min({nx - 1, width - 1 - nx, height - 1 - ny}) / geometry.rimFeather);
+        weight[at] = top * rim;
+    }
+    // Three separable box passes approximate a Gaussian and leave the donor's fine detail intact.
+    constexpr int radius = 13, diameter = 2 * radius + 1;
+    const auto blur = [&](bool vertical) {
+        const int lineCount = vertical ? w : h;
+        const int lineLength = vertical ? h : w;
+        for (int line = 0; line < lineCount; ++line) {
+            const auto at = [&](int n) {
+                n = std::clamp(n, 0, lineLength - 1);
+                return vertical ? size_t(n) * w + line : size_t(line) * w + n;
+            };
+            Rgb sum{};
+            for (int n = -radius; n <= radius; ++n)
+                for (int c = 0; c < 3; ++c) sum[c] += toneDelta[at(n)][c];
+            for (int n = 0; n < lineLength; ++n) {
+                for (int c = 0; c < 3; ++c) {
+                    scratch[at(n)][c] = sum[c] / diameter;
+                    sum[c] += toneDelta[at(n + radius + 1)][c] - toneDelta[at(n - radius)][c];
+                }
+            }
+        }
+        toneDelta.swap(scratch);
+    };
+    for (int pass = 0; pass < 3; ++pass) {
+        blur(false);
+        blur(true);
+    }
+    std::vector<uint32_t> result(registered.size());
+    for (int y = 0; y < h; ++y) for (int x = 0; x < w; ++x) {
+        const auto at = size_t(y) * w + x;
+        if (weight[at] == 0) continue;
+        const uint32_t original = native[size_t(y / 2) * width + x / 2];
+        const auto nativeRgb = unpack(original);
+        uint32_t pixel = 0xFF000000u;
+        for (int c = 0; c < 3; ++c) {
+            const auto corrected = std::clamp(registered[at][c] + toneDelta[at][c], 0.0, 255.0);
+            pixel |= uint32_t(std::lround(nativeRgb[c] * (1 - weight[at]) + corrected * weight[at])) << (8 * c);
+        }
+        if (pixel != original) result[at] = pixel;
+    }
+    return result;
+}
+} // namespace port
