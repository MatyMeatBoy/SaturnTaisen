+bool Renderer::TacticalGroundMatches() const {
+    const auto& map = ::port::tactical_ground::kStage01;
+    const auto& bg = m_regs2.bgParams[3];
+    return m_captureTacticalGround && !m_tacticalGround.empty() &&
+        m_presentation.mapSignature == map.mapSignature && bg.pageBaseAddresses[0] == map.groundPage &&
+        !bg.bitmap && !bg.mosaicEnable && !bg.vcellScrollEnable && m_scroll[2].incH == 256 &&
+        bg.scrollIncV == 256 && !bg.colorCalcEnable &&
+        (!m_regs2.colorOffsetEnable[4] || !m_regs2.colorOffset[m_regs2.colorOffsetSelect[4]].nonZero);
+}
+
+uint32 Renderer::TacticalGroundSample(sint32 screenX) const {
+    const auto& bg = m_regs2.bgParams[3];
+    const auto& scroll = m_scroll[2];
+    const auto worldX = (sint32(scroll.fracX + bg.scrollAmountH) >> 8) + screenX;
+    const auto worldY = sint32(scroll.fracY + bg.scrollAmountV) >> 8;
+    return ::port::tactical_ground::Sample(m_tacticalGround, ::port::tactical_ground::kStage01, worldX, worldY);
+}
