+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+#include "pc_spr.h"
+#include "prepared_hd.h"
+
+namespace port::tactical_ground {
+
+struct Entry {
+    const char* path;
+    size_t bytes;
+    uint64_t assetHash;
+    uint64_t mapSignature;
+    uint32_t groundPage;
+    unsigned worldWidth, worldHeight, mapEndX;
+};
+
+// MAP01_A, ordinal zero, uses two source pixels per world unit.
+inline constexpr Entry kStage01{
+    "SAKURA2/MAP/MAP01/MAP01_A.SPR", 1786365, 0xF7205A4FCC95F748ull,
+    0x1CAF3218B4B0F9F0ull, 0x40000, 704, 480, 656,
+};
+
+inline std::vector<uint32_t> Load(const std::filesystem::path& root, const Entry& entry) {
+    std::ifstream input(root / entry.path, std::ios::binary | std::ios::ate);
+    if (!input || input.tellg() != std::streampos(entry.bytes)) return {};
+    std::vector<uint8_t> bytes(entry.bytes);
+    input.seekg(0);
+    if (!input.read(reinterpret_cast<char*>(bytes.data()), bytes.size()) ||
+        input.peek() != std::char_traits<char>::eof() || input.bad() ||
+        PreparedHash(bytes) != entry.assetHash)
+        return {};
+    std::vector<PcSprite> images;
+    std::string error;
+    if (!DecodePcSprites(bytes, images, error) || images.size() != 1 ||
+        images.front().index != 0 || images.front().width != entry.worldWidth * 2 ||
+        images.front().height != entry.worldHeight * 2)
+        return {};
+    const auto& image = images.front();
+    std::vector<uint32_t> ground;
+    ground.reserve(size_t(entry.worldWidth) * entry.worldHeight);
+    for (unsigned y = 0; y < image.height; y += 2) {
+        for (unsigned x = 0; x < image.width; x += 2) {
+            const auto pixel = image.pixels[size_t(y) * image.width + x];
+            constexpr uint32_t kCyan = 0x00FFFF00;
+            ground.push_back((pixel & 0x00FFFFFF) == kCyan || !(pixel >> 24) ? 0 : pixel);
+        }
+    }
+    return ground;
+}
+
+inline uint32_t Sample(std::span<const uint32_t> ground, const Entry& entry, int x, int y) {
+    if (unsigned(x) >= entry.mapEndX || unsigned(y) >= entry.worldHeight ||
+        ground.size() != size_t(entry.worldWidth) * entry.worldHeight)
+        return 0;
+    return ground[size_t(y) * entry.worldWidth + x];
+}
+
+} // namespace port::tactical_ground
