+// TP2: one table for every scroll picture the Saturn shows through its 288x144 NBG2 window.
+//
+// Rule shared by all rows. The Saturn window (kPanInsetWidth x kPanPictureHeight, at 16,8 of the 320x224 frame) slides over a larger
+// native picture along ONE axis. The PC art is the same picture at 2x, so for a verified native offset n:
+//   scroll axis: PC start 2n, length 2 x window length
+//   cross axis : the PC art is larger than 2x the window by an even margin; the crop is centred in it
+//                (horizontal 1024x320 -> y 16, vertical 576xN -> x 0).
+// A row is therefore (picture, axis, native size, PC size) plus the pins that identify the files and the live layer. Adding a picture
+// is a data change (tools/gen_scroll_pictures.py derives every row from the Saturn BIN and the PC SPR).
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <span>
+
+#include "bg1207_verified_pan.h"
+#include "bg2248_verified_pan.h"
+
+namespace port {
+enum class ScrollAxis : uint8_t { Horizontal, Vertical };
+// Plain: the whole window is NBG2 (other layers keep the native composition).
+// ActorForeground: a small opaque NBG0 actor in front is kept (BG1207).
+// EdgeRamp: the last two tile columns of the native file are game-supplied edge, eased in with a ramp (BG2533, pinned by palette alone).
+enum class ScrollStyle : uint8_t { Plain, ActorForeground, EdgeRamp };
+
+struct ScrollPicture {
+    const char* name;
+    ScrollAxis axis;
+    unsigned width, height;       // native picture
+    size_t nativeBytes;
+    uint64_t nativeFnv;
+    uint64_t palette;             // BackgroundPaletteFingerprint(4)
+    uint64_t cells;               // BackgroundCellFingerprint(4, 41472); 0: identified by the palette alone
+    const char* pcFile;
+    size_t pcBytes;
+    uint64_t pcFnv;
+    unsigned pcWidth, pcHeight;   // subimage 0 of the PC file
+    ScrollStyle style;
+};
+
+inline constexpr ScrollPicture kScrollPictures[] = {
+#include "scroll_picture_rows.h"
+};
+inline constexpr size_t kScrollPictureCount = sizeof(kScrollPictures) / sizeof(kScrollPictures[0]);
+
+struct ScrollCrop {
+    unsigned x, y, w, h;
+};
+
+inline constexpr unsigned ScrollRange(const ScrollPicture& row) {
+    return row.axis == ScrollAxis::Horizontal ? row.width - kPanInsetWidth : row.height - kPanPictureHeight;
+}
+
+// PC rectangle for a native scroll offset (the rule above).
+inline constexpr ScrollCrop ScrollPcCrop(const ScrollPicture& row, unsigned offset) {
+    return row.axis == ScrollAxis::Horizontal
+        ? ScrollCrop{2 * offset, (row.pcHeight - 2 * kPanPictureHeight) / 2, 2 * kPanInsetWidth, 2 * kPanPictureHeight}
+        : ScrollCrop{(row.pcWidth - 2 * kPanInsetWidth) / 2, 2 * offset, 2 * kPanInsetWidth, 2 * kPanPictureHeight};
+}
+
+// The row obeys the rule: the window scrolls on one axis only, the PC art is 2x on it and leaves an even centred margin on the other.
+inline constexpr bool ScrollRowValid(const ScrollPicture& row) {
+    if (row.axis == ScrollAxis::Horizontal)
+        return row.height == kPanPictureHeight && row.width > kPanInsetWidth && row.pcWidth == 2 * row.width &&
+               row.pcHeight >= 2 * kPanPictureHeight && (row.pcHeight - 2 * kPanPictureHeight) % 2 == 0;
+    return row.width == kPanInsetWidth && row.height > kPanPictureHeight && row.pcHeight == 2 * row.height &&
+           row.pcWidth >= 2 * kPanInsetWidth && (row.pcWidth - 2 * kPanInsetWidth) % 2 == 0;
+}
+
+// The row whose live layer-4 keys match. `cellKey` is only called when a palette matches (it walks the map page).
+template <typename CellKey>
+inline const ScrollPicture* FindScrollPicture(uint64_t palette, CellKey&& cellKey) {
+    std::optional<uint64_t> cells;
+    for (const auto& row : kScrollPictures) {
+        if (row.palette != palette) continue;
+        if (!row.cells) return &row;
+        if (!cells) cells = cellKey();
+        if (*cells == row.cells) return &row;
+    }
+    return nullptr;
+}
+
+inline std::optional<unsigned> FindScrollOffset(const ScrollPicture& row, std::span<const uint32_t> picture,
+                                                std::span<const uint32_t> frame, std::span<const uint8_t> top,
+                                                bool opaqueActorLayer) {
+    return row.axis == ScrollAxis::Horizontal
+        ? FindHorizontalPanOffset(picture, frame, top, opaqueActorLayer, row.width)
+        : FindVerticalPanOffset(picture, frame, top, row.height);
+}
+
+inline std::vector<uint32_t> DecodeScrollPicture(const ScrollPicture& row, std::span<const uint8_t> bytes) {
+    return DecodePinnedPan(bytes, row.width, row.height, row.nativeBytes, row.nativeFnv);
+}
+}
