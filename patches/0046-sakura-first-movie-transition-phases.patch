diff --git a/port/movie_phase.h b/port/movie_phase.h
new file mode 100644
index 0000000..20e10fb
--- /dev/null
+++ b/port/movie_phase.h
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <span>
+namespace port {
+inline uint64_t MoviePhaseHash(std::span<const uint8_t> bytes) {
+ uint64_t hash=0xcbf29ce484222325ull;for(auto byte:bytes){hash^=byte;hash*=0x100000001b3ull;}return hash;
+}
+inline bool KnownFirstMovieScript(std::span<const uint8_t> bytes) {
+ return bytes.size()==15404 && MoviePhaseHash(bytes)==0x5DA24532C9356735ull;
+}
+inline uint32_t FirstMovieCursor(std::span<const uint8_t> high) {
+ if(high.size()!=0x100000)return 0;
+ const auto* p=high.data()+0x685B4;
+ return uint32_t(p[0])<<24|uint32_t(p[1])<<16|uint32_t(p[2])<<8|p[3];
+}
+// verifiedScript is the hash-checked complete 0100.BIN, loaded once from disc.
+// Capture with the framebuffer, before run-ahead restores authoritative RAM.
+inline bool CaptureFirstMoviePhase(std::span<const uint8_t> low,std::span<const uint8_t> high,
+                                  std::span<const uint8_t> verifiedScript) {
+ if(low.size()!=0x100000 || high.size()!=0x100000 || verifiedScript.size()!=15404)return false;
+ const uint32_t cursor=FirstMovieCursor(high);
+ if(cursor!=0x204006 && cursor!=0x204462 && cursor!=0x204ED8 &&
+    cursor!=0x204EDE && cursor!=0x204EE4 && cursor!=0x204EE6)return false;
+ return std::equal(verifiedScript.begin(),verifiedScript.end(),low.begin()+0x4000);
+}
+template<typename Sprite>
+bool OnlyFirstMovieOrnaments(std::span<const Sprite> sprites) {
+ if(sprites.size()>4096)return false;
+ unsigned footers=0,badges=0;
+ for(const auto& sprite:sprites) {
+  const auto& cmd=sprite.command.words;const auto type=cmd[0]&15;
+  if(type>=8)continue; // clipping/local-coordinate commands do not draw.
+  if(type!=0 || (cmd[0]&0x8030) || cmd[2]!=0xA0)return false;
+  const auto pixels=std::span<const uint8_t>(sprite.pixels);
+  if(cmd[3]==0xC500 && cmd[5]==0x2640 && sprite.x==8 && sprite.y==152 &&
+     pixels.size()==304*64 && MoviePhaseHash(pixels)==0x924C9C726F152DB2ull) {
+   if(++footers>2)return false;
+  } else if((cmd[3]==0xC400 || cmd[3]==0x4400) && cmd[5]==0x0530 && sprite.x==16 && sprite.y==160 &&
+     pixels.size()==40*48 && MoviePhaseHash(pixels)==0x7CA30C1792ED4682ull) {
+   if(++badges>1)return false;
+  } else return false;
+ }
+ return true; // No sprite is valid too: the old shadow can outlive the footer.
+}
+inline bool FirstMovieBlankFrame(bool phase,std::span<const uint8_t> source,bool ornaments) {
+ if(!phase || !ornaments || source.size()!=320*224)return false;
+ size_t floral=0;
+ for(int y=0;y<224;y++)for(int x=0;x<320;x++) {
+  const auto layer=source[size_t(y)*320+x];
+  if(layer==5){floral++;continue;}
+  if(layer==0 && x>=8 && x<312 && y>=152 && y<216)continue;
+  if(layer==3 && x>=9 && x<315 && y>=8 && y<220)continue;
+  return false;
+ }
+ return floral>=1000;
+}
+}
