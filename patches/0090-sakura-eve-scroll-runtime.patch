index cab6820..4d83c00 100644
--- a/port/presentation_layout.h
+++ b/port/presentation_layout.h
@@ -153,4 +153,18 @@ inline SceneLayout AnalyzePresentation(const std::vector<uint8_t>& source,int wi
     if(movie>30000 && actor==0 && text==0) return {true,true,16,8,288,144};
     return {true,false,left,top,right-left+1,bottom-top+1};
 }
+// T105e: an EVE scene has its 288x144 picture on layer 5 (the PC picture replaces it), so the picture is not among layers 1, 2 and 4 and
+// AnalyzePresentation gives up. The inset must be layer 5 almost entirely; the box under it is layers 0 and 3 from y=153 (layers 2 and 4 are the plane around it), and the
+// group is reported from the top of the inset as in a narrative scene.
+inline SceneLayout AnalyzeEvePresentation(const std::vector<uint8_t>& source,int width,int height) {
+    if(width!=320 || height!=224 || source.size()!=320*224)return {};
+    int inset=0,frame=0,left=320,right=-1,bottom=-1;
+    for(int y=0;y<224;y++)for(int x=0;x<320;x++) {
+        const int layer=source[size_t(y)*320+x];
+        if(y>=8 && y<152 && x>=16 && x<304)inset+=layer==5;
+        if(y>=153 && y<220 && x>=9 && x<315 && (layer==0 || layer==3)) {left=std::min(left,x);right=std::max(right,x);bottom=std::max(bottom,y);frame+=layer==0;}
+    }
+    if(inset<12000 || frame<100 || right<left)return {};
+    return {true,false,left,8,right-left+1,bottom-8+1};
+}
 }
diff --git a/port/scroll_eve.h b/port/scroll_eve.h
new file mode 100644
index 0000000..c280406
--- /dev/null
+++ b/port/scroll_eve.h
@@ -0,0 +1,28 @@
+#pragma once
+// T105: pure geometry for drawing a PC picture inside a 288x144 Saturn inset from a fitted crop window.
+#include <algorithm>
+#include <cstdint>
+namespace port {
+struct FRect {float x=0,y=0,w=0,h=0;};
+struct WindowClip {bool valid=false;FRect source;FRect target;};
+// `window` is where the inset sits in PC picture pixels (it may overhang the picture). The part of the window that lies inside
+// the PC picture (pcW x pcH) is returned as the source rectangle together with its place inside `inset` (the destination
+// rectangle of the whole window); anything outside the picture stays whatever was drawn under it (black).
+inline WindowClip ClipWindowToPicture(const int window[4],unsigned pcW,unsigned pcH,const FRect& inset) {
+    WindowClip out;
+    if(window[2]<=0 || window[3]<=0 || !pcW || !pcH || inset.w<=0 || inset.h<=0)return out;
+    const float x0=std::max(float(window[0]),0.0f),y0=std::max(float(window[1]),0.0f);
+    const float x1=std::min(float(window[0]+window[2]),float(pcW)),y1=std::min(float(window[1]+window[3]),float(pcH));
+    if(x1<=x0 || y1<=y0)return out;
+    const float kx=inset.w/float(window[2]),ky=inset.h/float(window[3]);
+    out.source={x0,y0,x1-x0,y1-y0};
+    out.target={inset.x+(x0-float(window[0]))*kx,inset.y+(y0-float(window[1]))*ky,(x1-x0)*kx,(y1-y0)*ky};
+    out.valid=true;
+    return out;
+}
+// A layer can stand for a fixed picture only when nothing moves it: no scroll, unit increments and no line or cell effects.
+struct LayerMotion {int32_t x=0,y=0;uint32_t incH=0x100,incV=0x100;bool lineEffects=false;};
+inline bool LayerIsStatic(const LayerMotion& m) {
+    return m.x==0 && m.y==0 && m.incH==0x100 && m.incV==0x100 && !m.lineEffects;
+}
+}
