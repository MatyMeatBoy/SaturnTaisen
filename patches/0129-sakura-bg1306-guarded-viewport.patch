diff --git a/port/bg1306_viewport.h b/port/bg1306_viewport.h
new file mode 100644
--- /dev/null
+++ b/port/bg1306_viewport.h
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+#include <cstdint>
+#include <span>
+
+namespace port {
+inline bool MatchesBG1306Viewport(std::span<const uint32_t> picture, std::span<const uint32_t> frame,
+                                  std::span<const uint8_t> layers, uint8_t layer) {
+    if ((layer != 2 && layer != 4) || picture.size() != 288 * 144 ||
+        frame.size() != 320 * 224 || layers.size() != frame.size()) return false;
+    for (unsigned y = 0; y < 144; ++y) {
+        for (unsigned x = 0; x < 288; ++x) {
+            const auto at = (y + 8) * 320 + x + 16;
+            if (layers[at] != layer || (frame[at] & 0xFFFFFFu) != picture[y * 288 + x])
+                return false;
+        }
+    }
+    return true;
+}
+}
