+inline std::optional<PanelMix> UniformPictureShadowRecipe(std::span<const PanelMix> panels,
+                                                         std::span<const PanelMix> covers) {
+    if(panels.size()!=320*224 || covers.size()!=320*224)return {};
+    std::optional<PanelMix> result;
+    for(int y=12;y<152;y++)for(int x=304;x<308;x++) {
+        const size_t at=size_t(y)*320+x;
+        const auto& recipe=panels[at].lowerWeight?panels[at]:covers[at];
+        if(!recipe.lowerWeight || recipe.lowerWeight>32 || (recipe.topRgb&0xFFFFFF)!=0x505050)return {};
+        if(result && (result->lowerWeight!=recipe.lowerWeight || result->postMixOffset!=recipe.postMixOffset))return {};
+        if(!result)result=recipe;
+    }
+    return result;
+}
