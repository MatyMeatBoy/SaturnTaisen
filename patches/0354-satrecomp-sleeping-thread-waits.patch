@@ -77,9 +77,18 @@ public:
         if (m_done.load(std::memory_order_acquire) == head) return;
         syncs++;
         const auto start = std::chrono::steady_clock::now();
+        // (a short wait in place, then asleep until the worker says it has caught up: a core turning round here
+        // is one the worker, or the other threads, could be using)
         for (unsigned spins = 0; m_done.load(std::memory_order_acquire) != head; spins++) {
-            if (spins < 20000) Relax();
-            else std::this_thread::yield();
+            if (spins < kSpinsBeforeSleep) {
+                Relax();
+                continue;
+            }
+            std::unique_lock<std::mutex> lock(m_doneMutex);
+            m_syncWaiting.store(true, std::memory_order_seq_cst);
+            m_doneWake.wait_for(lock, std::chrono::milliseconds(1),
+                                [&] { return m_done.load(std::memory_order_seq_cst) == head; });
+            m_syncWaiting.store(false, std::memory_order_seq_cst);
         }
         waitNs += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
             std::chrono::steady_clock::now() - start).count());
@@ -93,8 +102,23 @@ private:
