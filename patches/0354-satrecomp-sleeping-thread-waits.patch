     std::mutex m_mutex;
     std::condition_variable m_wake;
+    std::atomic<bool> m_syncWaiting{false};
+    std::mutex m_doneMutex;
+    std::condition_variable m_doneWake;
+    void TellDone() {
+        if (m_syncWaiting.load(std::memory_order_seq_cst)) [[unlikely]] {
+            std::lock_guard<std::mutex> lock(m_doneMutex);
+            m_doneWake.notify_one();
+        }
+    }
     std::thread m_thread;
 
+    // (an ARMv7 handheld's four cores are all busy: little turning before sleeping; a PC's are not)
+#if defined(__arm__) || defined(__aarch64__)
+    static constexpr unsigned kSpinsBeforeSleep = 2000;
+#else
+    static constexpr unsigned kSpinsBeforeSleep = 20000;
+#endif
     static void Relax() {
 #if defined(__arm__) || defined(__aarch64__)
         __asm__ __volatile__("yield");
@@ -126,9 +150,13 @@ private:
                 execute(m_ring[tail & (kSize - 1)]);
                 tail++;
                 m_tail.store(tail, std::memory_order_release);
-                if ((tail & 15) == 0) m_done.store(tail, std::memory_order_release);
+                if ((tail & 15) == 0) {
+                    m_done.store(tail, std::memory_order_release);
+                    TellDone();
+                }
             }
             m_done.store(tail, std::memory_order_release);
+            TellDone();
             busyNs += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
                 std::chrono::steady_clock::now() - start).count());
         }
