+// A 24x24 normalised grey signature of an RGBA picture (transparent pixels count as mid-grey), used to tell which
+// PC part a Saturn face frame is: the two are compared by correlation.
+inline std::vector<float> BodySignature(const std::vector<uint32_t>& pixels,unsigned width,unsigned height) {
+    constexpr unsigned N=24;
+    std::vector<float> out(N*N,0.0f);
+    if(!width || !height || pixels.size()!=size_t(width)*height)return out;
+    for(unsigned gy=0;gy<N;gy++)for(unsigned gx=0;gx<N;gx++) {
+        const unsigned x0=gx*width/N,x1=std::max(x0+1,(gx+1)*width/N),y0=gy*height/N,y1=std::max(y0+1,(gy+1)*height/N);
+        double sum=0;unsigned count=0;
+        for(unsigned y=y0;y<y1 && y<height;y++)for(unsigned x=x0;x<x1 && x<width;x++) {
+            const uint32_t p=pixels[size_t(y)*width+x];
+            const double alpha=(p>>24)/255.0,lum=0.299*(p&255)+0.587*((p>>8)&255)+0.114*((p>>16)&255);
+            sum+=lum*alpha+128.0*(1.0-alpha);count++;
+        }
+        out[gy*N+gx]=float(count?sum/count:128.0);
+    }
+    double mean=0;for(float v:out)mean+=v;mean/=out.size();
+    double norm=0;for(float& v:out){v=float(v-mean);norm+=double(v)*v;}
+    norm=std::sqrt(norm);if(norm<1e-6)norm=1.0;
+    for(float& v:out)v=float(v/norm);
+    return out;
+}
 
