--- a/port/glyph_text.h
+++ b/port/glyph_text.h
@@ -3,6 +3,7 @@
 #include <cstdint>
 #include <cstring>
 #include <span>
+#include <string>
 namespace port {
 inline uint64_t AtlasFingerprint(std::span<const uint8_t> data) {
     uint64_t hash=14695981039346656037ull;
@@ -21,4 +22,35 @@ inline char DecodeGlyph(std::span<const uint8_t> atlas,std::span<const uint8_t>
     }
     return result;
 }
+inline char32_t GlyphCodepoint(unsigned code) {
+    static constexpr char32_t punctuation[]={0x20AC,0,0x201A,0x0192,0x201E,0x2026,0x2020,0x2021,
+        0x02C6,0x2030,0x0160,0x2039,0x0152,0,0x017D,0,0,0x2018,0x2019,0x201C,0x201D,0x2022,
+        0x2013,0x2014,0x02DC,0x2122,0x0161,0x203A,0x0153,0,0x017E,0x0178};
+    if(code>=128 && code<160)return punctuation[code-128];
+    return (code>=32 && code<=126) || (code>=160 && code<=255)?char32_t(code):0;
+}
+inline char32_t DecodeCodepoint(std::span<const uint8_t> atlas,std::span<const uint8_t> tile) {
+    if(atlas.size()!=32768 || tile.size()!=128)return 0;
+    char32_t result=0;
+    for(int ascii=32;ascii<=126;ascii++)if(!std::memcmp(atlas.data()+(ascii-1)*128,tile.data(),128)) {
+        if(result)return 0;
+        result=char32_t(ascii);
+    }
+    if(result)return result; // prefer canonical ASCII over identical CP1252 aliases
+    for(unsigned code=128;code<=255;code++)if(const auto unicode=GlyphCodepoint(code);
+            unicode && !std::memcmp(atlas.data()+(code-1)*128,tile.data(),128)) {
+        if(result && result!=unicode)return 0;
+        result=unicode;
+    }
+    return result;
+}
+inline std::string GlyphUtf8(char32_t code) {
+    std::string result;
+    if(code<=0x7F)result+=char(code);
+    else if(code<=0x7FF) {result+=char(0xC0|(code>>6));result+=char(0x80|(code&63));}
+    else if(code>=0xD800 && code<=0xDFFF)return {};
+    else if(code<=0xFFFF) {result+=char(0xE0|(code>>12));result+=char(0x80|((code>>6)&63));result+=char(0x80|(code&63));}
+    else if(code<=0x10FFFF) {result+=char(0xF0|(code>>18));result+=char(0x80|((code>>12)&63));result+=char(0x80|((code>>6)&63));result+=char(0x80|(code&63));}
+    return result;
+}
 }
