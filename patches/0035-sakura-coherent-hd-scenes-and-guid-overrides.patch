 }
 // Native dialogue interior, excluding the speaker portrait and ornate frame.
-inline constexpr int kTextLeft=56,kTextTop=160,kTextRight=304,kTextBottom=208;
+inline constexpr int kTextLeft=56,kTextTop=160,kTextRight=304,kTextBottom=212;
+// Recognition includes the original bitmap descenders. HD drawing has its
+// own safe interior and a fixed baseline shared by every revealed row.
+inline float NarrativeRowTop(int nativeY,int scale) {
+    // Four native rows start at 160,172,184,196. Keep their fixed order but
+    // recover one pixel per row, leaving room for the HD font's descenders.
