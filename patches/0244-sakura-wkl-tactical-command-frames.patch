new file mode 100644
--- /dev/null
+++ b/port/tactical_command_frames.h
@@ -0,0 +1,27 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+#include "item_card_table.h"
+
+namespace port {
+inline constexpr auto kCommandFrameFile = "SAKURA2/SYSTEM/SLGSYS02.SPR";
+inline constexpr uint64_t kCommandFrameFileHash = 0x90AF0140ADACB4B6ull;
+inline constexpr size_t kCommandFrameFileSize = 73290;
+inline constexpr uint64_t kCommandFrameLutHash = 0x316D5850CBF9E6ADull;
+inline constexpr int kCommandFrameColorShift = -4;
+
+struct TacticalCommandFrame {
+    ItemCardEntry art;
+    int width, height;
+};
+inline constexpr TacticalCommandFrame kTacticalCommandFrames[]{
+    {{0x549B32456EF87DB3ull, kCommandFrameLutHash, kCommandFrameFile, 2}, 40, 48},
+    {{0xD46C77EFDE420A6Full, kCommandFrameLutHash, kCommandFrameFile, 4}, 40, 80},
+};
+
+inline const TacticalCommandFrame* CommandFrame(const ItemCardEntry* entry) {
+    for (const auto& frame : kTacticalCommandFrames)
+        if (&frame.art == entry) return &frame;
+    return nullptr;
+}
+} // namespace port
