@@ -34,6 +34,16 @@ class Archive;
 
 namespace satrecomp::video {
 
+// When what a VDP2 normal screen line is made from last changed (layers.cpp keeps lines made since): one counter, and
+// the number it had at the last write to each 4 KiB page of VDP2 VRAM, each 256 bytes of colour RAM, and at the last
+// change to everything (a register, a write with no known address, a reset or a loaded state)
+struct Vdp2Stamps {
+    uint64 counter = 1, everything = 1;
+    uint64 vramPage[128] = {}, cramPart[16] = {};
+    void All() { everything = ++counter; }
+};
+extern Vdp2Stamps g_vdp2Stamps;
+
 // Where the machine keeps the video chips' memory
 struct Memory {
     uint8 *vram1 = nullptr; // VDP1 VRAM, 0x80000 bytes
@@ -254,7 +264,10 @@ public:
