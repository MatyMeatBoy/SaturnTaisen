-    void NoteVideoMemoryWrite() { m_stateGen++; }
+    void NoteVideoMemoryWrite() { m_stateGen++; g_vdp2Stamps.All(); }
+    // (a write whose address is known: VDP2 VRAM at `address`, or colour RAM)
+    void NoteVram2Write(uint32 address) { m_stateGen++; g_vdp2Stamps.vramPage[(address >> 12) & 127] = ++g_vdp2Stamps.counter; }
+    void NoteCramWrite(uint32 address) { m_stateGen++; g_vdp2Stamps.cramPart[(address >> 8) & 15] = ++g_vdp2Stamps.counter; }
