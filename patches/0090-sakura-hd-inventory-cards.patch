+void Renderer::TrackItemCommand(const PresentationSprite& sprite) {
+    const auto& command=sprite.command.words;
+    if((command[0]&0x3F)!=0 || command[2]!=0x00A0 || command[3]!=0xC600 || command[5]!=0x0E70 ||
+       sprite.x<0 || sprite.x>320-kItemCardSize || sprite.y<0 || sprite.y>224-kItemCardSize)
+        return;
+    const auto hash=ItemFingerprint(sprite.pixels);
+    for(const auto& entry : ::port::kItemCards) {
+        if(entry.texture!=hash)continue;
+        auto& captured=m_drawnItemCard[m_captureDrawFB];
+        if(captured) {
+            // Only one card may own pixels for a draw pass.
+            captured.reset();m_itemCaptureActive=false;
+            return;
+        }
+        captured.emplace();
+        captured->entry=&entry;
+        captured->serial=++m_itemCardSerial;
+        captured->x=sprite.x;captured->y=sprite.y;
+        m_itemWriting=true;
+        return;
+    }
