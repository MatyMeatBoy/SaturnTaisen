diff --git a/port/bg2093_dream.h b/port/bg2093_dream.h
new file mode 100644
--- /dev/null
+++ b/port/bg2093_dream.h
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+#include "panel_compositing.h"
+
+namespace port {
+
+inline constexpr uint64_t kBG2093Palette = 0x65D40E5ACD068572ull;
+inline constexpr uint64_t kBG2093Cells = 0x0D797A594AB587CDull;
+inline constexpr uint64_t kBG2093UpperPalette = 0xCBC4C20C2E46BEE0ull;
+inline constexpr int kBG2093Width = 288, kBG2093Height = 144;
+
+struct DreamBlendPixel {
+    PanelMix mix;
+    uint32_t lowerRgb = 0;
+};
+
+inline bool BuildBG2093Composite(std::span<const DreamBlendPixel> captures,
+                                 std::span<const uint32_t> nativePicture,
+                                 std::span<const uint32_t> nativeFrame,
+                                 std::span<const uint32_t> donor,
+                                 std::span<uint32_t> output) {
+    constexpr int width = kBG2093Width, height = kBG2093Height;
+    if (captures.size() != width * height || nativePicture.size() != 320 * height ||
+        nativeFrame.size() != 320 * 224 || donor.size() != 640 * height * 2 ||
+        output.size() != width * height * 4)
+        return false;
+
+    std::array<unsigned, height> origins{};
+    for (int y = 0; y < height; ++y) {
+        const auto line = captures.subspan(y * width, width);
+        const auto nativeRow = nativePicture.subspan(y * 320, 320);
+        unsigned matches = 0;
+        for (unsigned left = 0; left <= 320 - width; ++left) {
+            if (std::equal(line.begin(), line.end(), nativeRow.begin() + left,
+                    [](const DreamBlendPixel& pixel, uint32_t native) {
+                        return pixel.lowerRgb == native;
+                    })) {
+                origins[y] = left;
+                ++matches;
+            }
+        }
+        if (matches != 1) return false;
+        for (int x = 0; x < width; ++x) {
+            const auto& pixel = line[x];
+            const auto frame = nativeFrame[(y + 8) * 320 + x + 16] | 0xff000000u;
+            if (!pixel.mix.lowerWeight || CompositePanelPixel(pixel.mix, pixel.lowerRgb, frame) != frame)
+                return false;
+        }
+    }
+    for (int y = 0; y < height * 2; ++y) {
+        const auto line = captures.subspan((y / 2) * width, width);
+        const auto pc = donor.subspan(y * 640 + origins[y / 2] * 2, width * 2);
+        for (int x = 0; x < width * 2; ++x)
+            output[y * width * 2 + x] = CompositePanelPixel(line[x / 2].mix, pc[x], 0xff000000u);
+    }
+    return true;
+}
+
+// Fit the pinned PC subimage to the 2x native world before applying a row origin.
+inline std::vector<uint32_t> RegisterBG2093Donor(std::span<const uint32_t> source) {
+    constexpr int sourceWidth = 592, sourceHeight = 320, width = 640, height = 288;
+    if (source.size() != sourceWidth * sourceHeight) return {};
+    std::vector<uint32_t> out(width * height);
+    for (int y = 0; y < height; ++y) {
+        const double py = std::clamp((y + 0.5) * (320.0 / 288.0) - 0.5, 0.0, 319.0);
+        const int y0 = int(py), y1 = std::min(y0 + 1, sourceHeight - 1);
+        const double fy = py - y0;
+        for (int x = 0; x < width; ++x) {
+            const double px = std::clamp(22.5 + (x + 0.5) * (514.2 / 576.0) - 0.5, 0.0, 591.0);
+            const int x0 = int(px), x1 = std::min(x0 + 1, sourceWidth - 1);
+            const double fx = px - x0;
+            const auto a = source[y0 * sourceWidth + x0], b = source[y0 * sourceWidth + x1];
+            const auto c = source[y1 * sourceWidth + x0], d = source[y1 * sourceWidth + x1];
+            uint32_t color = 0xff000000u;
+            for (unsigned shift : {0u, 8u, 16u}) {
+                const double top = ((a >> shift) & 255) * (1 - fx) + ((b >> shift) & 255) * fx;
+                const double below = ((c >> shift) & 255) * (1 - fx) + ((d >> shift) & 255) * fx;
+                color |= static_cast<uint32_t>(top * (1 - fy) + below * fy) << shift;
+            }
+            out[y * width + x] = color;
+        }
+    }
+    return out;
+}
+
+} // namespace port
