diff --git a/runtime/access.h b/runtime/access.h
index 72a6b8f..6874147 100644
--- a/runtime/access.h
+++ b/runtime/access.h
@@ -81,6 +81,12 @@ struct Access {
     static Registers GetRegisters(SH2 &c) {
         return {c.R, c.PC, c.PR, c.SR.u32, c.GBR, c.VBR, c.MAC.u64};
     }
+    // GetRegisters(c) == r, without copying the registers out first (the wait detector asks this at every block entry);
+    // the scalars that change most go first, so a CPU that is not waiting stops at the first
+    static bool SameRegisters(SH2 &c, const Registers &r) {
+        return c.PC == r.PC && c.SR.u32 == r.SR && c.PR == r.PR && c.GBR == r.GBR && c.VBR == r.VBR && c.MAC.u64 == r.MAC &&
+               c.R == r.R;
+    }
     // An interrupt is waiting to be serviced (now, or after one more instruction if it is being held off)
     // Where a function stopped (block_native.h): 0, or the number of the block + 1
     static uint32_t Resume(SH2 &c) {
