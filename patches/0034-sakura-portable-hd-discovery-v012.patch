@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <filesystem>
+// Portable owner resources are optional; each runtime loader still verifies its own source hashes.
+inline std::filesystem::path PortableHdRoot(const std::filesystem::path& configured,const std::filesystem::path& program) {
+    std::error_code error;
+    if(!configured.empty() && std::filesystem::is_directory(configured,error))return configured;
+    const auto bundled=program/"hd-resources";
+    error.clear();if(std::filesystem::is_directory(bundled/"SAKURA1/WALL",error) || std::filesystem::is_regular_file(bundled/"hd-pack.stfp",error))return bundled;
+    return {};
+}
