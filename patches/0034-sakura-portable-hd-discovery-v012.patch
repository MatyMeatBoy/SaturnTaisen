diff --git a/port/prepared_hd.h b/port/prepared_hd.h
new file mode 100644
index 0000000..a3961b3
--- /dev/null
+++ b/port/prepared_hd.h
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <filesystem>
+#include <fstream>
+#include <vector>
+#include <array>
+#include <string>
+#include <string_view>
+#include <span>
+#include <cstdint>
+#include <cstring>
+namespace port {
+inline uint64_t PreparedHash(std::span<const uint8_t> bytes) {
+    uint64_t hash=14695981039346656037ull;for(auto byte:bytes)hash=(hash^byte)*1099511628211ull;return hash;
+}
+struct PreparedBackdrop {std::string id;uint64_t source=0,hash=0,bytes=0;};
+struct PreparedHdPack {uint64_t portraitBytes=0,portraitSource=0,portraitManifest=0;uint32_t portraitCount=0;std::vector<PreparedBackdrop> backgrounds;};
+inline bool ReadPreparedHd(const std::filesystem::path& root,PreparedHdPack& result) {
+    result={};std::ifstream input(root/"hd-pack.stfp",std::ios::binary|std::ios::ate);
+    if(!input || input.tellg()<48 || input.tellg()>48+19*32)return false;
+    std::vector<uint8_t> bytes(size_t(input.tellg()));input.seekg(0);if(!input.read(reinterpret_cast<char*>(bytes.data()),bytes.size()))return false;
+    if(std::memcmp(bytes.data(),"STFHD01",8))return false;
+    auto word=[&](size_t at,int count){uint64_t value=0;for(int i=0;i<count;i++)value|=uint64_t(bytes[at+i])<<(8*i);return value;};
+    const auto count=word(12,4);
+    if(word(8,4)!=1 || count>19 || bytes.size()!=48+count*32 || word(40,4)>394 || word(44,4))return false;
+    PreparedHdPack parsed;parsed.portraitBytes=word(16,8);parsed.portraitSource=word(24,8);parsed.portraitManifest=word(32,8);parsed.portraitCount=uint32_t(word(40,4));
+    for(size_t i=0;i<count;i++) {
+        const size_t at=48+i*32;PreparedBackdrop record;
+        record.id.assign(reinterpret_cast<const char*>(bytes.data()+at),8);
+        if(record.id.substr(0,4)!="KABE")return false;
+        for(int j=4;j<8;j++)if(record.id[j]<'0' || record.id[j]>'9')return false;
+        for(const auto& existing:parsed.backgrounds)if(existing.id==record.id)return false;
+        record.source=word(at+8,8);record.hash=word(at+16,8);record.bytes=word(at+24,8);
+        if(!record.bytes || record.bytes>2097152)return false;
+        parsed.backgrounds.push_back(std::move(record));
+    }
+    result=std::move(parsed);return true;
+}
+inline const PreparedBackdrop* FindPreparedBackdrop(const PreparedHdPack& pack,std::string_view id,uint64_t source) {
+    for(const auto& item:pack.backgrounds)if(item.id==id && item.source==source)return &item;return nullptr;
+}
+inline bool PreparedFileMatches(const std::filesystem::path& file,uint64_t size,uint64_t hash,size_t limit) {
+    std::error_code error;if(std::filesystem::is_symlink(file,error))return false;
+    std::ifstream input(file,std::ios::binary|std::ios::ate);
+    if(!input || input.tellg()<=0 || uint64_t(input.tellg())>limit || (size && uint64_t(input.tellg())!=size))return false;
+    std::vector<uint8_t> bytes(size_t(input.tellg()));input.seekg(0);
+    return bool(input.read(reinterpret_cast<char*>(bytes.data()),bytes.size())) && PreparedHash(bytes)==hash;
+}
+}
