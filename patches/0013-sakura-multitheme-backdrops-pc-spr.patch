diff --git a/port/pc_spr.h b/port/pc_spr.h
new file mode 100644
index 0000000..bd8a51e
--- /dev/null
+++ b/port/pc_spr.h
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <cstdint>
+#include <cstring>
+#include <span>
+#include <string>
+#include <vector>
+namespace port {
+struct PcSprite {unsigned index=0,width=0,height=0,format=0;std::vector<uint32_t> pixels;};
+inline bool DecodePcSprites(std::span<const uint8_t> data,std::vector<PcSprite>& images,std::string& error) {
+    images.clear();
+    auto fail=[&](const char* message){images.clear();error=message;return false;};
+    if(data.size()<32 || std::memcmp(data.data(),"SEGA SPRED",10))return fail("Unknown SPRED signature");
+    auto word=[&](size_t at){return uint32_t(data[at])<<8|data[at+1];};
+    auto longword=[&](size_t at){return word(at)<<16|word(at+2);};
+    struct Chunk {size_t offset=0,size=0;};Chunk palette,bitmaps;
+    for(size_t at=16;at+16<=data.size();at+=16) {
+        const size_t offset=longword(at),size=longword(at+4);const auto index=longword(at+8);
+        if(!offset || !size)break;
+        if(offset>data.size() || size>data.size()-offset || index>=14)return fail("Invalid SPRED chunk extent");
+        if(index==1)palette={offset,size};if(index==2)bitmaps={offset,size};
+        if(at+16>=offset)break;
+    }
+    if(bitmaps.size<16)return fail("Missing SPRED image table");
+    const auto count=word(bitmaps.offset);const size_t tableBytes=16+count*16;
+    if(!count || count>4096 || tableBytes>bitmaps.size)return fail("Invalid SPRED image count");
+    std::vector<uint32_t> colors;
+    if(palette.size>=16) {
+        const bool wide=word(palette.offset+2)==4;const size_t step=wide?4:2;
+        for(size_t at=palette.offset+16;at+step<=palette.offset+palette.size;at+=step) {
+            if(wide)colors.push_back((uint32_t(data[at])<<24)|data[at+1]|(uint32_t(data[at+2])<<8)|(uint32_t(data[at+3])<<16));
+            else {const auto c=word(at);colors.push_back(0xFF000000u|((c&31)*255/31)|(((c>>5)&31)*255/31<<8)|(((c>>10)&31)*255/31<<16));}
+        }
+        if(!colors.empty())colors[0]&=0xFFFFFF;
+    }
+    constexpr unsigned bits[]={4,4,8,8,8,16,24,32};
+    size_t totalPixels=0;
+    for(unsigned index=0;index<count;index++) {
+        const size_t at=bitmaps.offset+16+index*16;
+        const auto width=word(at),height=word(at+2),format=word(at+4),bank=word(at+6);
+        const size_t relative=longword(at+8),size=longword(at+12);
+        if(!width || !height || !size)continue;
+        if(width>4096 || height>4096 || (format&15)>=8 || format>255)return fail("Unsupported SPRED dimensions/format");
+        const size_t pixelCount=size_t(width)*height;
+        if(pixelCount>64*1024*1024-totalPixels)return fail("SPRED decoded image budget exceeded");
+        totalPixels+=pixelCount;
+        const size_t start=tableBytes+relative;
+        if(start>bitmaps.size || size>bitmaps.size-start)return fail("SPRED image exceeds chunk");
+        const unsigned bpp=bits[format&15];const size_t need=(size_t(width)*height*bpp+7)/8;
+        const auto compressed=data.subspan(bitmaps.offset+start,size);
+        std::vector<uint8_t> raw;raw.reserve(need);
+        if(format>>4) {
+            uint8_t ring[4096]={};unsigned write=0xFEE,flags=0,left=0;size_t cursor=0;
+            while(raw.size()<need) {
+                if(!left) {if(cursor>=compressed.size())return fail("Truncated SPRED control byte");flags=compressed[cursor++];left=8;}
+                const bool literal=flags&1;flags>>=1;left--;
+                if(literal) {
+                    if(cursor>=compressed.size())return fail("Truncated SPRED literal");
+                    const auto value=compressed[cursor++];raw.push_back(value);ring[write]=value;write=(write+1)&4095;
+                } else {
+                    if(compressed.size()-cursor<2)return fail("Truncated SPRED match");
+                    const unsigned a=compressed[cursor++],b=compressed[cursor++];unsigned read=a|((b>>4)<<8),length=(b&15)+3;
+                    if(length>need-raw.size())return fail("SPRED match exceeds output");
+                    while(length--) {const auto value=ring[read];read=(read+1)&4095;raw.push_back(value);ring[write]=value;write=(write+1)&4095;}
+                }
+            }
+        } else {if(compressed.size()<need)return fail("Short raw SPRED image");raw.assign(compressed.begin(),compressed.begin()+need);}
+        PcSprite image{index,width,height,format,{}};image.pixels.reserve(size_t(width)*height);
+        for(size_t pixel=0;pixel<size_t(width)*height;pixel++) {
+            uint32_t color=0;
+            if(bpp==4 || bpp==8) {
+                const unsigned value=bpp==8?raw[pixel]:(raw[pixel/2]>>(pixel&1?0:4))&15;
+                const size_t entry=size_t(bank)*(bpp==4?16:256)+value;
+                if(entry>=colors.size())return fail("SPRED palette index exceeds palette");color=colors[entry];
+            } else if(bpp==16) {
+                // PC/PSP SPRED direct pixels: little-endian RGB555, high bit not opacity.
+                const unsigned c=raw[pixel*2]|(unsigned(raw[pixel*2+1])<<8);
+                color=0xFF000000u|(((c>>10)&31)*255/31)|(((c>>5)&31)*255/31<<8)|((c&31)*255/31<<16);
+            } else return fail("24/32-bit direct SPRED needs verified channel mapping");
+            image.pixels.push_back(color);
+        }
+        images.push_back(std::move(image));
+    }
+    error.clear();return true;
+}
+}
