+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <SDL3/SDL.h>
+#include <array>
+#include <span>
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+namespace port {
+// Import master art into one native-density 16:9 grid; presentation only uses integer multiples.
+inline SDL_Surface* NormalizeBackdrop(SDL_Surface* master,std::span<const uint8_t> kabe) {
+    if(!master || kabe.size()<512) return nullptr;
+    auto* logical=SDL_CreateSurface(416,234,SDL_PIXELFORMAT_ABGR8888);
+    if(!logical) return nullptr;
+    SDL_SetSurfaceBlendMode(master,SDL_BLENDMODE_NONE);
+    if(!SDL_BlitSurfaceScaled(master,nullptr,logical,nullptr,SDL_SCALEMODE_NEAREST)) {SDL_DestroySurface(logical);return nullptr;}
+    std::array<uint32_t,256> palette;
+    for(size_t i=0;i<256;i++) {
+        const uint16_t word=uint16_t(kabe[i*2])<<8|kabe[i*2+1];
+        palette[i]=0xFF000000u|((word&31)<<3)|(((word>>5)&31)<<11)|(((word>>10)&31)<<19);
+    }
+    for(int y=0;y<logical->h;y++) {
+        auto* row=reinterpret_cast<uint32_t*>(static_cast<uint8_t*>(logical->pixels)+y*logical->pitch);
+        for(int x=0;x<logical->w;x++) {
+            const uint32_t pixel=row[x];int best=200000;uint32_t color=palette[0];
+            for(const auto candidate:palette) {
+                const int r=int(pixel&255)-int(candidate&255),g=int((pixel>>8)&255)-int((candidate>>8)&255),b=int((pixel>>16)&255)-int((candidate>>16)&255);
+                const int distance=r*r+g*g+b*b;
+                if(distance<best) {best=distance;color=candidate;if(!distance)break;}
+            }
+            row[x]=color;
+        }
+    }
+    return logical;
+}
+inline SDL_Texture* LoadBackdrop(SDL_Renderer* renderer,const std::filesystem::path& file,std::span<const uint8_t> kabe,const std::filesystem::path& cacheDir) {
+    std::ifstream input(file,std::ios::binary);if(!input) return nullptr;
+    uint64_t hash=14695981039346656037ull;
+    char buffer[65536];
+    while(input.read(buffer,sizeof(buffer)) || input.gcount()) for(std::streamsize i=0;i<input.gcount();i++) hash=(hash^static_cast<uint8_t>(buffer[i]))*1099511628211ull;
+    for(size_t i=0;i<512 && i<kabe.size();i++)hash=(hash^kabe[i])*1099511628211ull;
+    std::filesystem::path cache;
+    SDL_Surface* logical=nullptr;
+    if(!cacheDir.empty()) {
+        cache=cacheDir/(file.stem().string()+"-grid416-v1-"+std::to_string(hash)+".png");
+        logical=SDL_LoadPNG(cache.string().c_str());
+        if(logical && (logical->w!=416 || logical->h!=234)) {SDL_DestroySurface(logical);logical=nullptr;}
+    }
+    if(!logical) {
+        auto* master=SDL_LoadPNG(file.string().c_str());
+        logical=NormalizeBackdrop(master,kabe);if(master) SDL_DestroySurface(master);
+        if(!logical) return nullptr;
+        if(!cache.empty()) {
+            std::error_code error;std::filesystem::create_directories(cacheDir,error);
+            if(!error) SDL_SavePNG(logical,cache.string().c_str());
+        }
+    }
+    auto* texture=SDL_CreateTextureFromSurface(renderer,logical);SDL_DestroySurface(logical);
+    if(texture)SDL_SetTextureScaleMode(texture,SDL_SCALEMODE_NEAREST);
+    return texture;
+}
+
+}
