+inline constexpr int64_t CalibratedScrollStart(const ScrollFit& fit, unsigned offset) {
+    return int64_t(fit.origin) + (int64_t(fit.rateMilli) * offset + 500) / 1000;
+}
+
+// True when the PC crop for `offset` is drawn; offsets below the row's minimum stay native.
+inline constexpr bool ScrollOffsetSupported(const ScrollPicture& row, unsigned offset) {
+    return !row.fit.rateMilli || offset >= row.fit.minOffset;
+}
+
+// Fade from the Saturn picture over the first supported native offsets.
+inline constexpr uint8_t ScrollDonorOpacity(const ScrollPicture& row, unsigned offset) {
+    if (!ScrollOffsetSupported(row, offset)) return 0;
+    const auto& fit = row.fit;
+    if (!fit.fadeInOffsets || offset - fit.minOffset >= fit.fadeInOffsets) return 255;
+    return uint8_t((uint64_t(offset - fit.minOffset) * 255 + fit.fadeInOffsets / 2) / fit.fadeInOffsets);
 }
 
