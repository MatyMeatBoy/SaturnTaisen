@@ -22,6 +22,31 @@
     uint16_t control,mode,color,size;
     uint64_t texture,palette;
 };
+
+inline constexpr std::array kLoadAnchors{224, 280};
+inline constexpr int kLoadY=62;
+inline constexpr uint16_t kLoadColor=0x02C0;
+inline constexpr uint64_t kLoadPalette=0x809F8438D9925B74ull;
+inline constexpr std::array<uint64_t,2> kLoadTexture{0xC22BF33F44463864ull,0xFF02AF0F7DEB043Cull};
+
+inline bool EligibleLoadArrows(std::span<const Arrow,4> arrows) {
+    for(size_t i=0;i<kLoadAnchors.size();++i) {
+        const auto& arrow=arrows[i];
+        if(arrow.x!=kLoadAnchors[i] || arrow.y!=kLoadY || arrow.right!=arrow.x+kWidth-1 ||
+           arrow.bottom!=arrow.y+kHeight-1 || (arrow.control&0x8FFF)!=1 || arrow.mode!=0x0080 ||
+           arrow.size!=0x0110 || arrow.color!=kLoadColor || arrow.texture!=kLoadTexture[i] ||
+           arrow.palette!=kLoadPalette)
+            return false;
+    }
+    return arrows[2].texture==0 && arrows[3].texture==0;
+}
+
+inline uint32_t LoadBlend(uint32_t upper,uint32_t under) {
+    uint32_t result=0xFF000000;
+    for(unsigned shift:{0u,8u,16u})
+        result|=((31*((upper>>shift)&255u)+((under>>shift)&255u))>>5)<<shift;
+    return result;
+}
 
