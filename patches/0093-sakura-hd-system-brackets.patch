diff --git a/port/system_brackets.h b/port/system_brackets.h
new file mode 100644
index 0000000..afba8a0
--- /dev/null
+++ b/port/system_brackets.h
@@ -0,0 +1,64 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <span>
+
+namespace system_hud {
+inline constexpr std::array kAnchors{64, 104, 128, 168};
+inline constexpr int kY=108, kWidth=8, kHeight=16;
+inline constexpr uint64_t Fingerprint(std::span<const uint8_t> bytes) {
+    uint64_t value=14695981039346656037ull;
+    for(uint8_t byte:bytes)value=(value^byte)*1099511628211ull;
+    return value;
+}
+inline constexpr std::array<uint64_t,2> kTexture{0xEF39DE9F9400A5ADull,0xD8731754E21634EDull};
+inline constexpr std::array<uint64_t,2> kPalette{0xA34A4A3675D9F164ull,0xD5E6859F7CCE70F2ull};
+inline constexpr std::array<uint16_t,2> kColor{0xA2D0,0xA2F0};
+
+struct Arrow {
+    int x,y,right,bottom;
+    uint16_t control,mode,color,size;
+    uint64_t texture,palette;
+};
+
+// The four verified inventory marks form one stable layout. The corners are inclusive.
+// Matching just one familiar texture is insufficient because other screens use the glyph.
+inline bool Eligible(std::span<const Arrow> arrows) {
+    const auto& anchors=kAnchors;
+    if(arrows.size()!=anchors.size())return false;
+    for(unsigned i=0;i<anchors.size();++i) {
+        const auto& arrow=arrows[i];
+        const auto bank=std::ranges::find(kColor,arrow.color);
+        if(arrow.x!=anchors[i] || arrow.y!=108 || arrow.right!=arrow.x+7 || arrow.bottom!=arrow.y+15 ||
+           (arrow.control&0x0FFF)!=1 || arrow.mode!=0x0080 || arrow.size!=0x0110 ||
+           arrow.texture!=kTexture[i%2] || bank==kColor.end() ||
+           arrow.palette!=kPalette[bank-kColor.begin()] ||
+           arrow.color!=arrows[i^1].color)
+            return false;
+    }
+    return arrows[0].color==kColor[0] || arrows[2].color==kColor[0];
+}
+
+// Ownership comes from actual VDP1 writes and VDP2 scanout. Zero preserves the composed
+// output including transparent holes and occluders. Two is an effect that requires fallback.
+inline bool MaskArrow(std::span<const uint32_t,512> pc, std::span<const uint8_t,128> owned,
+                      uint32_t dark,uint32_t light,std::span<uint32_t,512> overlay) {
+    std::ranges::fill(overlay,0);
+    bool visible=false;
+    for(int y=0;y<16;y++)for(int x=0;x<8;x++) {
+        const auto owner=owned[y*8+x];
+        if(owner==0)continue;
+        if(owner!=1)return false;
+        const int at=(2*y)*16+2*x;
+        for(int sample:{at,at+1,at+16,at+17}) {
+            if(pc[sample]==0xFF626262)overlay[sample]=dark;
+            else if(pc[sample]==0xFF949494)overlay[sample]=light;
+            else return false;
+        }
+        visible=true;
+    }
+    return visible;
+}
+}
