diff --git a/launcher/src/sakura_setup.cpp b/launcher/src/sakura_setup.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..a3c52780ee81a4fca2a24eb80cf0f2682ba7c939
--- /dev/null
+++ b/launcher/src/sakura_setup.cpp
@@ -0,0 +1,217 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#include "sakura_setup.h"
+#include "game_process.h"
+#include "layout.h"
+#include "ui.h"
+#include <array>
+#include <fstream>
+#include <memory>
+#include <mutex>
+namespace {
+struct SetupState {
+    std::mutex mutex;
+    bool dialog=false,closed=false,finished=true,error=false;
+    std::string pending;
+    std::array<char,2048> source{};
+    std::unique_ptr<GameProcess> worker;
+    std::filesystem::path log;
+    std::string message,progress;
+    Uint64 lastRead=0;
+    int language=0; // 0 Español, 1 English
+};
+std::shared_ptr<SetupState> state;
+
+void Picked(void* userdata,const char* const* files,int) {
+    std::unique_ptr<std::shared_ptr<SetupState>> owner(static_cast<std::shared_ptr<SetupState>*>(userdata));
+    const auto one=*owner;std::lock_guard<std::mutex> lock(one->mutex);
+    if(!one->closed && files && files[0])one->pending=files[0];
+    one->dialog=false;
+}
+std::filesystem::path LanguageDisc(const std::filesystem::path& program,int language) {
+    return program/"game"/(language==0?"disc1-es":"disc1")/"game.cue";
+}
+bool Exists(const std::filesystem::path& file) {std::error_code error;return std::filesystem::is_regular_file(file,error);}
+std::string Utf8(const std::filesystem::path& path) {const auto text=path.u8string();return std::string(text.begin(),text.end());}
+// The helper's last "PROGRESO n text" or "ERROR text" line.
+void ReadProgress(SetupState& s) {
+    std::ifstream input(s.log,std::ios::binary);std::string line,last,failure;
+    while(std::getline(input,line)) {
+        if(!line.empty() && line.back()=='\r')line.pop_back();
+        if(line.rfind("PROGRESO ",0)==0)last=line.substr(9);
+        else if(line.rfind("ERROR ",0)==0)failure=line.substr(6);
+    }
+    if(!failure.empty()) {s.progress=failure;return;}
+    const auto space=last.find(' ');
+    if(space!=std::string::npos)s.progress=last.substr(0,space)+" % · "+last.substr(space+1);
+}
+// A round "bubble" switch: small capitals over its value, tinted while on. Its words always fit: the value
+// takes a smaller size before it would be cut.
+bool Bubble(const char* id,const char* title,const char* value,bool on,float width,bool enabled) {
+    const auto& p=ui::palette();const float height=ui::px(62);
+    const ImVec2 at=ImGui::GetCursorScreenPos();
+    ImGui::PushID(id);
+    ImGui::BeginDisabled(!enabled);
+    const bool pressed=ImGui::InvisibleButton("bubble",ImVec2(width,height),ImGuiButtonFlags_EnableNav);
+    const bool hovered=ImGui::IsItemHovered(),focused=ImGui::IsItemFocused();
+    ImGui::EndDisabled();
+    ImGui::PopID();
+    auto* draw=ImGui::GetWindowDrawList();const float round=height*.5f,alpha=enabled?1.0f:.55f;
+    draw->AddRectFilled(at+ImVec2(0,ui::px(4)),at+ImVec2(width,height+ui::px(4)),IM_COL32(86,38,52,20),round);
+    draw->AddRectFilled(at,at+ImVec2(width,height),ui::fade(on?p.accent_soft:p.surface,alpha),round);
+    draw->AddRectFilled(at,at+ImVec2(width,height),ui::fade(p.surface,on?.35f:0.0f),round);
+    // (the shine of a bubble: a soft light along the top and a small glint)
+    draw->AddRectFilled(at+ImVec2(round*.7f,ui::px(5)),at+ImVec2(width-round*.7f,ui::px(12)),IM_COL32(255,255,255,on?120:150),ui::px(4));
+    draw->AddCircleFilled(at+ImVec2(width-round*.75f,round*.62f),ui::px(4),IM_COL32(255,255,255,on?150:110));
+    draw->AddRect(at,at+ImVec2(width,height),ui::fade(on?p.primary:p.separator,(hovered||focused)?1.0f:.75f),round,ui::px(on?2.0f:1.2f));
+    draw->AddCircleFilled(at+ImVec2(round*.78f,height*.5f),ui::px(6),ui::fade(on?p.primary:p.tertiary,alpha));
+    const float left=round*.78f+ui::px(14),room=width-left-ui::px(14);
+    ImGui::SetCursorScreenPos(at+ImVec2(left,ui::px(12)));
+    ui::text(title,ui::Font::Semibold,10.5f,ui::fade(p.secondary,alpha));
+    float size=14.5f;
+    for(;size>10.0f;size-=.5f) {
+        ImGui::PushFont(nullptr,ui::px(size));const float wide=ImGui::CalcTextSize(value).x;ImGui::PopFont();
+        if(wide<=room)break;
+    }
+    ImGui::SetCursorScreenPos(at+ImVec2(left,ui::px(29)));
+    ui::text(value,ui::Font::Semibold,size,ui::fade(on?p.primary:p.text,alpha));
+    ImGui::SetCursorScreenPos(at+ImVec2(0,height+ui::px(6)));
+    ImGui::Dummy(ImVec2(width,0));
+    return pressed && enabled;
+}
+void Save(launcher::PageContext& page,std::initializer_list<std::pair<const char*,const char*>> values) {
+    for(const auto& value:values)page.settings.set("features",value.first,value.second);
+    if(page.settings.get("features","preset")!="custom")page.settings.set("features","preset","custom");
+    page.settings.save();
+}
+}
+void ShutdownSakuraSetup() {
+    if(!state)return;
+    {std::lock_guard<std::mutex> lock(state->mutex);state->closed=true;}
+    state->worker.reset();state.reset();
+}
+bool SakuraSetupBusy() {return state && state->worker && state->worker->running();}
+void DrawSakuraSetup(launcher::PageContext& page) {
+    if(!state) {
+        state=std::make_shared<SetupState>();
+        state->language=page.prefs.get("sakura","language")=="en"?1:0;
+        SDL_strlcpy(state->source.data(),page.prefs.get("sakura","setup_source").c_str(),state->source.size());
+    }
+    auto& s=*state;bool dialog=false;
+    {
+        std::lock_guard<std::mutex> lock(s.mutex);dialog=s.dialog;
+        if(!s.pending.empty()) {
+            if(s.pending.size()<s.source.size())SDL_strlcpy(s.source.data(),s.pending.c_str(),s.source.size());
+            s.pending.clear();
+        }
+    }
+    const bool running=s.worker && s.worker->running();
+    if(running && SDL_GetTicks()-s.lastRead>400) {s.lastRead=SDL_GetTicks();ReadProgress(s);}
+    if(s.worker && !running && !s.finished) {
+        s.finished=true;s.error=s.worker->exit_code()!=0;ReadProgress(s);
+        if(s.error)s.message=s.progress.empty()?"No se pudo preparar el juego. Revisa logs/preparar-juego.log.":s.progress;
+        else {
+            s.message="Juego preparado. Ya puedes jugar.";
+            page.prefs.load();page.settings.load(); // the helper wrote the disc, the language and first-run defaults
+            s.language=page.prefs.get("sakura","language")=="en"?1:0;
+            const auto disc=LanguageDisc(page.program_folder,s.language);
+            if(Exists(disc) && page.use_file)page.use_file(Utf8(disc));
+        }
+        s.progress.clear();
+    }
+    const bool english=Exists(LanguageDisc(page.program_folder,1)),spanish=Exists(LanguageDisc(page.program_folder,0));
+    const bool pack=Exists(page.program_folder/"hd-resources"/"hd-pack.stfp") || !page.prefs.get("sakura","pc_assets").empty();
+    std::error_code ignored;
+    const bool folder=std::filesystem::is_directory(page.program_folder/"discos",ignored);
+    const bool locked=running || dialog || page.playing;
+    const auto& p=ui::palette();
+
+    // ---- the four switches of the home page ----
+    const bool enhanced=page.settings.get("features","presentation_mode")=="1";
+    const bool sharp=enhanced && page.settings.get("features","text_style")!="1";
+    const bool hd=enhanced && pack && page.settings.get("features","pc_hd_backgrounds")!="1" && page.settings.get("features","pc_hd_portraits")!="1";
+    const bool stacked=page.width<ui::px(520);
+    const float gap=ui::px(10),each=stacked?(page.width-gap)*.5f:(page.width-gap*3)*.25f;
+    const ImVec2 row=ImGui::GetCursorScreenPos();
+    auto place=[&](int index) {
+        ImGui::SetCursorScreenPos(row+(stacked?ImVec2((index%2)*(each+gap),(index/2)*ui::px(72)):ImVec2(index*(each+gap),0)));
+    };
+    place(0);
+    if(Bubble("language","IDIOMA",s.language==0?"Español":"English",true,each,!locked && (english || spanish))) {
+        const int wanted=1-s.language;
+        if(Exists(LanguageDisc(page.program_folder,wanted))) {
+            s.language=wanted;
+            page.prefs.set("sakura","language",wanted==0?"es":"en");page.prefs.save();
+            if(page.use_file)page.use_file(Utf8(LanguageDisc(page.program_folder,wanted)));
+            s.message.clear();
+        } else {s.error=true;s.message="Ese idioma aún no está preparado: pulsa Preparar.";}
+    }
+    place(1);
+    if(Bubble("presentation","PRESENTACIÓN",enhanced?"Mejorada":"Original",enhanced,each,!page.playing))
+        Save(page,{{"presentation_mode",enhanced?"0":"1"}});
+    place(2);
+    if(Bubble("text","TEXTO HD",sharp?"Activado":"Desactivado",sharp,each,!page.playing)) {
+        if(sharp)Save(page,{{"text_style","1"}});
+        else Save(page,{{"text_style","0"},{"presentation_mode","1"}}); // (HD text belongs to the enhanced presentation)
+    }
+    place(3);
+    if(Bubble("hd","MODO HD",!pack?"Sin preparar":hd?"Activado":"Desactivado",hd,each,!page.playing)) {
+        if(!pack) {s.error=true;s.message="El modo HD necesita tu edición de PC: añádela abajo y pulsa Preparar.";}
+        else if(hd)Save(page,{{"pc_hd_backgrounds","1"},{"pc_hd_portraits","1"}});
+        else Save(page,{{"pc_hd_backgrounds","0"},{"pc_hd_portraits","0"},{"hd_preload","1"},{"presentation_mode","1"}});
+    }
+    ImGui::SetCursorScreenPos(row+ImVec2(0,ui::px(stacked?144:72)));
+    ImGui::Dummy(ImVec2(page.width,0));
+    ui::text("Modo HD reúne fondos y retratos de tu edición de PC; con Texto HD solo actúa en la presentación Mejorada.",
+             ui::Font::Regular,ui::size::kSmall,p.secondary,page.width);
+
+    // ---- preparing the game from the player's own files ----
+    ui::gap(18);ui::text("PREPARAR JUEGO",ui::Font::Semibold,ui::size::kDetail,p.secondary);ui::gap(8);
+    {
+        layout::Card card(page.width);
+        layout::row(page.width,"Tus archivos",
+                    "Tus dos discos de Saturn (originales o ya con la traducción inglesa v2.1) y, para el modo HD, tu edición de PC. "
+                    "Elige la carpeta donde están o cualquiera de ellos: el resto se busca al lado.",300,36,[&] {
+            ImGui::BeginDisabled(locked);
+            ui::text_field("##sakura-setup-source",s.source.data(),s.source.size(),folder?"Carpeta «discos»":"Sin elegir",300);
+            ImGui::EndDisabled();
+        });
+        layout::inset_separator(page.width);
+        const bool done=english && spanish;
+        layout::row(page.width,running?"Preparando…":done?"Todo preparado":"Preparar",
+                    done?"Lo ya preparado se reconoce y se conserva; solo se rehace lo que cambió.":
+                         "Se trabaja sobre una copia; tus archivos solo se leen. Tarda unos minutos la primera vez.",300,36,[&] {
+            if(ui::button("Carpeta…",ui::Kind::Secondary,92,!locked)) {
+                {std::lock_guard<std::mutex> lock(s.mutex);s.dialog=true;}
+                SDL_ShowOpenFolderDialog(Picked,new std::shared_ptr<SetupState>(state),page.window,nullptr,false);
+            }
+            ImGui::SameLine(0,ui::px(6));
+            if(ui::button("Archivo…",ui::Kind::Secondary,92,!locked)) {
+                static const SDL_DialogFileFilter filters[]={{"Discos e imágenes","cue;iso;bin;img;mdf;zip"}};
+                {std::lock_guard<std::mutex> lock(s.mutex);s.dialog=true;}
+                SDL_ShowOpenFileDialog(Picked,new std::shared_ptr<SetupState>(state),page.window,filters,1,nullptr,false);
+            }
+            ImGui::SameLine(0,ui::px(6));
+            if(ui::button(done?"Revisar":"Preparar",ui::Kind::Primary,104,(s.source[0] || folder || done) && !locked)) {
+                page.prefs.set("sakura","setup_source",s.source.data());page.prefs.save();
+                std::vector<std::string> args={"prepare","--language",s.language==0?"es":"en","--home",Utf8(page.folder),"--program",Utf8(page.program_folder)};
+                if(s.source[0]) {args.push_back("--rom");args.push_back(s.source.data());}
+                else if(folder) {args.push_back("--folder");args.push_back(Utf8(page.program_folder/"discos"));}
+                s.finished=false;s.error=false;s.message.clear();s.progress="0 % · Iniciando…";
+                std::error_code error;std::filesystem::create_directories(page.folder/"logs",error);
+                s.log=page.folder/"logs"/"preparar-juego.log";s.worker=std::make_unique<GameProcess>();
+                if(!s.worker->start(page.program_folder/"preparar-juego.exe",args,page.program_folder,s.message,s.log)) {
+                    s.worker.reset();s.finished=true;s.error=true;
+                    if(s.message.empty())s.message="No se pudo iniciar preparar-juego.exe.";
+                }
+            }
+        });
+        card.end();
+    }
+    ui::gap(8);
+    if(running)ui::text(s.progress.c_str(),ui::Font::Regular,ui::size::kDetail,p.secondary,page.width);
+    else if(!s.message.empty())ui::text(s.message.c_str(),ui::Font::Regular,ui::size::kDetail,s.error?p.danger:p.success,page.width);
+    else {
+        const std::string status=std::string("Inglés: ")+(english?"listo":"falta")+" · Español: "+(spanish?"listo":"falta")+" · Modo HD: "+(pack?"listo":"falta tu edición de PC");
+        ui::text(status.c_str(),ui::Font::Regular,ui::size::kDetail,p.secondary,page.width);
+    }
+}
