+#include "run_program.h"
 #include "../../launch_ready.h"
 
 using launcher::FileCheck;
@@ -57,6 +58,111 @@ float page_padding_top() {
 constexpr float kContentMaxWidth = 720.0f;
 constexpr size_t kAnyGame = static_cast<size_t>(-1);  // (a file or folder for whichever game takes it)
 
+// Words that were read as Windows-1252 when they were UTF-8 (once or several times over, as some of this game's
+// feature descriptions were when their source was saved) are put back. A field that is already right stays as it is.
+bool valid_utf8(const std::string& text) {
+    for (size_t i = 0; i < text.size();) {
+        const unsigned char c = static_cast<unsigned char>(text[i]);
+        const size_t more = c < 0x80 ? 0 : (c & 0xE0) == 0xC0 ? 1 : (c & 0xF0) == 0xE0 ? 2 : (c & 0xF8) == 0xF0 ? 3 : 9;
+        if (more == 9 || i + more >= text.size() + (more ? 0 : 1)) {
+            return false;
+        }
+        for (size_t k = 1; k <= more; k++) {
+            if ((static_cast<unsigned char>(text[i + k]) & 0xC0) != 0x80) {
+                return false;
+            }
+        }
+        i += more + 1;
+    }
+    return true;
+}
+std::string repair_field(std::string text) {
+    static const unsigned high[32] = {0x20AC, 0x81, 0x201A, 0x0192, 0x201E, 0x2026, 0x2020, 0x2021, 0x02C6, 0x2030, 0x0160,
+                                      0x2039, 0x0152, 0x8D, 0x017D, 0x8F, 0x90, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022,
+                                      0x2013, 0x2014, 0x02DC, 0x2122, 0x0161, 0x203A, 0x0153, 0x9D, 0x017E, 0x0178};
+    for (int pass = 0; pass < 4 && valid_utf8(text); pass++) {
+        std::string bytes;
+        bool changed = false, known = true;
+        for (size_t i = 0; i < text.size() && known;) {
+            const unsigned char c = static_cast<unsigned char>(text[i]);
+            unsigned point = c;
+            size_t length = 1;
+            if ((c & 0xE0) == 0xC0) {
+                point = (c & 31u) << 6 | (static_cast<unsigned char>(text[i + 1]) & 63u);
+                length = 2;
+            } else if ((c & 0xF0) == 0xE0) {
+                point = (c & 15u) << 12 | (static_cast<unsigned char>(text[i + 1]) & 63u) << 6 | (static_cast<unsigned char>(text[i + 2]) & 63u);
+                length = 3;
+            } else if (c >= 0x80) {
+                known = false;
+            }
+            i += length;
+            if (point < 0x80) {
+                bytes += static_cast<char>(point);
+            } else if (point >= 0xA0 && point <= 0xFF) {
+                bytes += static_cast<char>(point);
+                changed = true;
+            } else {
+                int byte = -1;
+                for (int k = 0; k < 32; k++) {
+                    if (high[k] == point) {
+                        byte = 0x80 + k;
+                    }
+                }
+                known = byte >= 0;
+                bytes += static_cast<char>(byte);
+                changed = true;
+            }
+        }
+        if (!known || !changed || !valid_utf8(bytes)) {
+            break;
+        }
+        text = bytes;
+    }
+    return text;
+}
+std::string repair_feature_text(const std::string& list) {
+    std::string out, field;
+    for (const char c : list) {
+        if (c == '\t' || c == '\n' || c == '|') {
+            out += repair_field(field);
+            out += c;
+            field.clear();
+        } else {
+            field += c;
+        }
+    }
+    return out + repair_field(field);
+}
+
+// The page's texture: soap-bubble rings and a fine grain, the same every frame.
+void bubbly_backdrop(ImDrawList* draw, ImVec2 from, ImVec2 to, ImU32 tint, ImU32 light) {
+    unsigned seed = 0x5A4B1997u;
+    auto next = [&seed] {
+        seed = seed * 1664525u + 1013904223u;
+        return static_cast<float>(seed >> 8) / 16777216.0f;
+    };
+    const float w = to.x - from.x, h = to.y - from.y;
+    if (w <= 0 || h <= 0) {
+        return;
+    }
+    draw->PushClipRect(from, to, true);
+    for (int i = 0; i < 26; i++) {
+        const ImVec2 center(from.x + next() * w, from.y + next() * h);
+        const float radius = ui::px(10.0f + next() * 44.0f);
+        draw->AddCircleFilled(center, radius, ui::fade(tint, 0.030f + next() * 0.035f), 40);
+        draw->AddCircle(center, radius, ui::fade(light, 0.35f), 40, ui::px(1.0f));
+        draw->AddCircleFilled(center + ImVec2(-radius * 0.38f, -radius * 0.42f), radius * 0.13f, ui::fade(light, 0.55f), 12);
+    }
+    const float step = ui::px(7.0f);
+    for (float y = from.y + step * 0.5f; y < to.y; y += step) {
+        for (float x = from.x + (static_cast<int>((y - from.y) / step) % 2 ? step * 0.5f : 0.0f); x < to.x; x += step) {
+            draw->AddRectFilled(ImVec2(x, y), ImVec2(x + 1.0f, y + 1.0f), ui::fade(tint, 0.045f));
+        }
+    }
+    draw->PopClipRect();
