 #include <string>
 
 namespace port {
+// Match the visibly sharper generated panels to the native card. The other
+// surrounds already have equal or lower detail in the bands next to Saturn.
+static SDL_Texture* LoadEpisodeSurround(SDL_Renderer* renderer, SDL_Surface* image, int episode) {
+    if (episode != 1 && episode != 6) return SDL_CreateTextureFromSurface(renderer, image);
+    auto* rgba = SDL_ConvertSurface(image, SDL_PIXELFORMAT_ABGR8888);
+    if (!rgba) return SDL_CreateTextureFromSurface(renderer, image);
+    constexpr int width = 640, height = 360;
+    const auto row = [](SDL_Surface* pixels, int y) {
+        return reinterpret_cast<uint32_t*>(static_cast<uint8_t*>(pixels->pixels) + y * pixels->pitch);
+    };
+    // One native-scale binomial pass. Skip the empty center in the samples and
+    // keep the existing alpha, so the textured surround still fits the card exactly.
+    std::vector<uint32_t> original(width * height);
+    for (int y = 0; y < height; ++y)
+        std::copy_n(row(rgba, y), width, original.data() + y * width);
+    for (int y = 0; y < height; ++y) {
+        auto* output = row(rgba, y);
+        for (int x = 0; x < width; ++x) {
+            const int detail = episode == 1 ? std::max({x - 464, 84 - y, y - 276})
+                                            : std::max(176 - x, y - 276);
+            const unsigned blend = std::clamp(detail, 0, 16);
+            const uint32_t pixel = original[y * width + x];
+            if (!blend || !(pixel >> 24)) continue;
+            unsigned red = 0, green = 0, blue = 0, total = 0;
+            for (int dy = -1; dy <= 1; ++dy) {
+                const int sy = std::clamp(y + dy, 0, height - 1);
+                for (int dx = -1; dx <= 1; ++dx) {
+                    const int sx = std::clamp(x + dx, 0, width - 1);
+                    const uint32_t sample = original[sy * width + sx];
+                    const unsigned weight = (2 - std::abs(dx)) * (2 - std::abs(dy)) * (sample >> 24);
+                    red += (sample & 255) * weight;
+                    green += ((sample >> 8) & 255) * weight;
+                    blue += ((sample >> 16) & 255) * weight;
+                    total += weight;
+                }
+            }
+            const auto mix = [total, blend, pixel](unsigned sum, unsigned shift) {
+                const unsigned filtered = (sum + total / 2) / total;
+                const unsigned native = (pixel >> shift) & 255;
+                return ((filtered * blend + native * (16 - blend) + 8) / 16) << shift;
+            };
+            output[x] = (pixel & 0xff000000u) | mix(red, 0) | mix(green, 8) | mix(blue, 16);
+        }
+    }
+    auto* texture = SDL_CreateTextureFromSurface(renderer, rgba);
+    SDL_DestroySurface(rgba);
+    return texture;
+}
