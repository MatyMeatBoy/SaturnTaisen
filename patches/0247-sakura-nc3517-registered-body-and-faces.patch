+inline std::vector<uint32_t> RegisterFace(const Entry& entry, const Face& face,
+    std::span<const uint8_t> native, std::span<const uint32_t> donor) {
+    if (native.size() != size_t(face.width*face.height) ||
+        donor.size() != size_t(face.donorWidth*face.donorHeight)) return {};
+    const int width = face.width*2, height = face.height*2;
+    std::vector<uint32_t> result(size_t(width)*height, 0);
+    // Use the body alignment in atlas coordinates, retaining native pixels
+    // where the PC part has no opaque art.
+    for (int y=0; y<height; ++y) for (int x=0; x<width; ++x) {
+        if (!native[(y/2)*face.width+x/2]) continue;
+        const int u = entry.scaleX*(2*x-1) + 4*(entry.originX+entry.scaleX*face.x-face.donorX*1000) + 2000;
+        const int v = entry.scaleY*(2*y-1) + 4*(entry.originY+entry.scaleY*face.y-face.donorY*1000) + 2000;
+        if (u<0 || v<0 || u/4000>=face.donorWidth || v/4000>=face.donorHeight) continue;
+        const uint32_t color=donor[(v/4000)*face.donorWidth+u/4000];
+        if ((color>>24)==255 && (color&0xFFFFFF)!=0xFFFF00)
+            result[y*width+x]=color;
+    }
+    return result;
+}
 
