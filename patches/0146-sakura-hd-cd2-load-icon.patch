diff --git a/port/load_disc_icon.h b/port/load_disc_icon.h
--- a/port/load_disc_icon.h
+++ b/port/load_disc_icon.h
@@ -5,8 +5,15 @@
 
 namespace port {
 // The load-menu disc icon shares VDP1 ownership tracking with the item cards.
-inline constexpr ItemCardEntry kLoadDiscIcon{
-    0xE2E4156ADAB1517Full,0x52C0DBB1EA90290Aull,"SAKURA1/SYSTEM/SIS_ICON.SPR",2
+inline constexpr ItemCardEntry kLoadDiscIcons[]{
+    {0xE2E4156ADAB1517Full,0x52C0DBB1EA90290Aull,"SAKURA1/SYSTEM/SIS_ICON.SPR",2},
+    {0x9AF2CC56D5CAEB11ull,0x52C0DBB1EA90290Aull,"SAKURA1/SYSTEM/SIS_ICON.SPR",3},
 };
+
+inline bool IsLoadDiscIcon(const ItemCardEntry* entry) {
+    for(const auto& icon : kLoadDiscIcons)
+        if(entry==&icon)return true;
+    return false;
+}
 inline constexpr int kLoadDiscIconSize=40;
 }
