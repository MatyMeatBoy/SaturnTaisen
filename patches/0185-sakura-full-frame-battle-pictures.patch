diff --git a/port/full_frame.h b/port/full_frame.h
new file mode 100644
index 0000000..595cca4
--- /dev/null
+++ b/port/full_frame.h
@@ -0,0 +1,49 @@
+#pragma once
+
+// TP2b: full-frame battle pictures. The Saturn shows a 320x224 picture as the whole frame; the PC art is the same picture
+// drawn wider, so a row carries the measured PC crop that is stretched over the whole native frame. The table is generated
+// (tools/gen_full_frame_rows.py -> full_frame_rows.h). The runtime draws a row only when the presented frame is exactly the
+// Saturn picture (palette, one winning layer over every pixel, RGB hash of the whole frame) and keeps the native frame otherwise.
+
+#include "eve_inset.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace port {
+
+struct FullFrameRow {
+    const char* name;
+    std::uint64_t palette;  // FNV-1a of the 512-byte VDP2 palette bank
+    std::uint64_t rgb;      // FNV-1a of R, G, B of the 320x224 native frame
+    const char* pcFile;
+    std::size_t pcBytes;
+    std::uint64_t pcFnv;
+    unsigned pcWidth;
+    unsigned pcHeight;
+    EveRect crop;
+};
+
+inline constexpr FullFrameRow kFullFrameRows[] = {
+#include "full_frame_rows.h"
+};
+inline constexpr std::size_t kFullFrameCount = sizeof(kFullFrameRows) / sizeof(kFullFrameRows[0]);
+inline constexpr EveRect kFullFrameRect{0, 0, 320, 224};
+
+constexpr bool FullFrameRowValid(const FullFrameRow& row) {
+    return row.name && row.pcFile && row.pcBytes > 0 && row.palette && row.rgb &&
+           EveCropFits(row.crop, row.pcWidth, row.pcHeight);
+}
+
+// One layer wins every pixel of the 320x224 frame (value 6 is "no layer"): no sprite, text or second plane over the picture.
+inline bool IsFullFrame(std::span<const std::uint8_t> topSource, int width, int height) {
+    if (width != 320 || height != 224 || topSource.size() != std::size_t{320} * 224) return false;
+    const std::uint8_t layer = topSource[0];
+    if (layer >= 6) return false;
+    for (const std::uint8_t value : topSource)
+        if (value != layer) return false;
+    return true;
+}
+
+}  // namespace port
