diff --git a/port/bg2238_verified_still.h b/port/bg2238_verified_still.h
new file mode 100644
--- /dev/null
+++ b/port/bg2238_verified_still.h
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+#include <cstdint>
+#include <span>
+
+namespace port {
+inline constexpr uint64_t kBG2238Palette = 0x5DEDEF54BF2F059Dull;
+// The first blank cell fills the margins and repeats in the name table.
+inline constexpr uint64_t kBG2238Cells = 0xCA9BDE72C500A276ull;
+inline constexpr unsigned kBG2238CellBytes = 46016;
+
+inline bool MatchesBG2238Still(std::span<const uint32_t> rgb, std::span<const uint8_t> layers) {
+    if (rgb.size() != 320 * 224 || layers.size() != rgb.size()) return false;
+    uint64_t fingerprint = 14695981039346656037ull;
+    for (int y = 8; y < 152; ++y) {
+        for (int x = 16; x < 304; ++x) {
+            const auto at = y * 320 + x;
+            if (layers[at] != 2) return false;
+            for (unsigned shift = 0; shift < 24; shift += 8)
+                fingerprint = (fingerprint ^ uint8_t(rgb[at] >> shift)) * 1099511628211ull;
+        }
+    }
+    return fingerprint == 0x095A6EAF8E529EE5ull;
+}
+}
