+bool ValidAudioDonor(const std::filesystem::path& root) {
+    if (root.empty()) return false;
+    const auto path=root/"SAKURA2"/"SE"/"0042.WAV";
+    std::error_code ec;
+    if (std::filesystem::file_size(path,ec)!=31020 || ec) return false;
+    std::ifstream input(path,std::ios::binary);
+    uint64_t hash=0xcbf29ce484222325ULL;
+    std::array<char,4096> bytes{};
+    size_t total=0;
+    while(input && total<31020) {
+        input.read(bytes.data(),std::min(bytes.size(),31020-total));
+        const auto count=input.gcount();
+        total+=count;
+        for(std::streamsize i=0;i<count;++i)
+            hash=(hash^static_cast<unsigned char>(bytes[i]))*0x100000001b3ULL;
+    }
+    return !input.bad() && total==31020 && input.peek()==std::char_traits<char>::eof() && hash==0x41a6fcf48f997315ULL;
+}
