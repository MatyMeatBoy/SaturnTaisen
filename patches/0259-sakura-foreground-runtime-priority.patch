+#ifdef _WIN32
+// Present is synchronous on this thread. Favor it during foreground play so
+// competing CPU work cannot starve an otherwise short frame.
+class ForegroundRuntimePriority {
+public:
+    ~ForegroundRuntimePriority() { Update(false); }
+
+    void Update(bool foreground) {
+        if (foreground == foreground_) return;
+        foreground_ = foreground;
+        const HANDLE thread = GetCurrentThread();
+        const int priority = GetThreadPriority(thread);
+        if (foreground) {
+            if (priority == THREAD_PRIORITY_NORMAL)
+                boosted_ = SetThreadPriority(thread, THREAD_PRIORITY_ABOVE_NORMAL) != 0;
+        } else if (boosted_) {
+            if (priority == THREAD_PRIORITY_ABOVE_NORMAL)
+                SetThreadPriority(thread, THREAD_PRIORITY_NORMAL);
+            boosted_ = false;
+        }
+    }
+
+private:
+    bool foreground_ = false;
+    bool boosted_ = false;
+};
+#endif
