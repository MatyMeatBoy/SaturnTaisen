+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+#include "glyph_text.h"
+
+#include <algorithm>
+#include <array>
+#include <optional>
+#include <span>
+#include <vector>
+
+namespace port {
+
+struct UiTextLine {
+    int x=0,y=0;
+    std::u32string text;
+    uint32_t color=0xFF181818;
+};
+struct ChoiceTextMatch {
+    std::vector<UiTextLine> lines;
+    std::vector<size_t> ink;
+};
+
+inline std::array<int,4> ChoiceTextClip(int x,int y,int scale,int cropX,int cropY) {
+    return {x+(16-cropX)*scale,y+(48-cropY)*scale,
+            x+(304-cropX)*scale,y+(140-cropY)*scale};
+}
+
+// The caller supplies the verified, untranslated English glyph atlas and the
+// metadata of the same displayed framebuffer. All rows share one native panel.
+template<typename Sprite,typename Plate>
+std::optional<ChoiceTextMatch> MatchChoiceText(std::span<const Sprite> sprites,std::span<const uint8_t> atlas,
+    std::span<const uint8_t> source,std::span<const uint32_t> pixels,std::span<const Plate> plate) {
+    constexpr size_t frameSize=320*224;
+    if(sprites.size()>4096 || atlas.size()!=32768 || source.size()!=frameSize ||
+       pixels.size()!=frameSize || plate.size()!=frameSize)return {};
+
+    struct Cell {int x;char32_t code;};
+    struct Row {
+        std::array<Cell,32> cells{};
+        unsigned count=0,shade=766;
+        uint16_t bank=0;
+        uint32_t color=0;
+    };
+    constexpr std::array<int,5> nativeRows{54,62,78,94,102};
+    std::array<Row,nativeRows.size()> rows{};
+    unsigned clocks=0;
+    std::array<bool,4097> matchedOwners{};
+    ChoiceTextMatch result;
+    for(size_t index=0;index<sprites.size();++index) {
+        const auto& sprite=sprites[index];
+        const auto& cmd=sprite.command.words;
+        if((cmd[0]&15)==1 && cmd[2]==0xA0 && cmd[3]==0xC500 &&
+           cmd[5]==0x0110 && sprite.x==160 && sprite.y==32 && sprite.pixels.size()==128)++clocks;
+        if((cmd[0]&0x3F) || cmd[2]!=0x80 || (cmd[3]!=0xC510 && cmd[3]!=0xC570) ||
+           cmd[5]!=0x0210 || sprite.y<48 || sprite.y>=140)continue;
+        const auto rowPos=std::find(nativeRows.begin(),nativeRows.end(),sprite.y);
+        if(rowPos==nativeRows.end() || sprite.x<40 || sprite.x>288)return {};
+        auto& row=rows[size_t(rowPos-nativeRows.begin())];
+        if(row.count==row.cells.size() || (row.bank && row.bank!=cmd[3]))return {};
+        const auto tile=std::span<const uint8_t>(sprite.pixels);
+        const auto code=DecodeCodepoint(atlas,tile);
+        if(!code)return {};
+        row.bank=cmd[3];
+        const size_t owner=index+1;
+        matchedOwners[owner]=true;
+        row.cells[row.count++]={sprite.x,code};
+        for(int py=0;py<16;++py)for(int px=0;px<16;++px) {
+            const auto packed=tile[py*8+px/2];
+            if(!(px&1?packed&15:packed>>4))continue;
+            const int x=sprite.x+px,y=sprite.y+py;
+            if(x<40 || x>=288 || y<48 || y>=140)return {};
+            const size_t at=size_t(y)*320+x;
+            if(source[at]!=0 || !plate[at].owner ||
+               (plate[at].owner!=owner && plate[at].underOwner!=owner))return {};
+            result.ink.push_back(at);
+            const uint32_t color=pixels[at];
+            const unsigned shade=(color&255)+((color>>8)&255)+((color>>16)&255);
+            if(shade<row.shade) {row.shade=shade;row.color=color|0xFF000000;}
+        }
+    }
+    const bool two=rows[1].count && rows[3].count && !rows[0].count && !rows[2].count && !rows[4].count;
+    const bool three=rows[0].count && rows[2].count && rows[4].count && !rows[1].count && !rows[3].count;
+    if(clocks!=1 || (!two && !three))return {};
+    unsigned selected=0;
+    for(size_t i=0;i<rows.size();++i) {
+        auto& row=rows[i];
+        if(!row.count)continue;
+        if(row.shade==766 || (row.bank==0xC570 && ++selected>1))return {};
+        const auto end=row.cells.begin()+row.count;
+        std::sort(row.cells.begin(),end,[](const auto& a,const auto& b){return a.x<b.x;});
+        if(row.cells.front().x+(end-1)->x+8!=336)return {};
+        UiTextLine line;
+        line.x=row.cells.front().x;
+        line.y=nativeRows[i];
+        line.color=row.color;
+        for(auto cell=row.cells.begin();cell!=end;++cell) {
+            if(cell->x!=line.x+8*int(line.text.size()))return {};
+            line.text+=cell->code;
+        }
+        result.lines.push_back(std::move(line));
+    }
+    // The saved color predates both writers. Erase their shared ink only
+    // when the complete active panel owns every contributing command.
+    for(size_t at:result.ink) {
+        const auto& pixel=plate[at];
+        for(uint16_t owner:{pixel.owner,pixel.underOwner}) {
+            if(owner && (owner>sprites.size() || !matchedOwners[owner]))return {};
+        }
+    }
+    std::sort(result.ink.begin(),result.ink.end());
+    result.ink.erase(std::unique(result.ink.begin(),result.ink.end()),result.ink.end());
+    return result;
+}
+
+} // namespace port
