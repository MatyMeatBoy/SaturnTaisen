+// Only the two witnessed nine-pixel glyphs may cross the right ink boundary.
+// Callers must additionally prove the saved-under plate for the complete row.
+inline bool NarrativeRecognizedInkFits(int x,int y,std::span<const uint8_t> tile,char32_t code) {
+    if(NarrativeInkFits(x,y,tile))return true;
+    if(tile.size()!=128 || x!=296 || (code!=U'w' && code!=U'\u2026'))return false;
+    for(int py=0;py<16;py++)for(int px=0;px<16;px++) {
+        const uint8_t packed=tile[py*8+px/2];
+        if(!(px&1?packed&15:packed>>4))continue;
+        if(x+px<kTextLeft || x+px>kTextRight || y+py<kTextTop || y+py>=kTextBottom)return false;
+    }
+    return true;
+}
