diff --git a/video/glyph_plate.h b/video/glyph_plate.h
new file mode 100644
index 0000000..5f0a810
--- /dev/null
+++ b/video/glyph_plate.h
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+#include <cstdint>
+#include <limits>
+
+namespace satrecomp::video {
+struct GlyphPlateStamp {
+    uint16_t before=0,after=0,owner=0,underOwner=0;
+
+    void RecordWrite(uint16_t glyph,uint16_t previous,uint16_t current) {
+        if(!owner) {
+            if(glyph) *this={previous,current,glyph};
+        } else if(glyph && owner==glyph) {
+            after=current;
+        } else if(glyph && owner!=kUncertain && !underOwner) {
+            // The host may erase this pair only if both glyphs are accepted.
+            underOwner=owner;
+            owner=glyph;
+            after=current;
+        } else {
+            // A later draw can own the pixel even if it wrote the same word.
+            owner=kUncertain;
+        }
+    }
+
+    uint16_t Owner(uint16_t current) const {
+        return owner!=kUncertain && after==current?owner:0;
+    }
+private:
+    static constexpr uint16_t kUncertain=std::numeric_limits<uint16_t>::max();
+};
+}
