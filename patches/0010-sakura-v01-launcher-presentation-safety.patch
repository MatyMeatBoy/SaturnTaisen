+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <algorithm>
+namespace port {
+struct IntegerViewport { int x=0, y=0, w=0, h=0, scale=0; };
+inline IntegerViewport FitInteger(int width, int height, int columns, int lines) {
+    if (width<=0 || height<=0 || columns<=0 || lines<=0) return {};
+    const int by=std::max(1,std::min(width/columns,height/lines));
+    const int w=columns*by, h=lines*by;
+    return {(width-w)/2,(height-h)/2,w,h,by};
+}
+}
