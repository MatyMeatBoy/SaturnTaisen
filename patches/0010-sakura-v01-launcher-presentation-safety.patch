+        if (title_capture_.exit_code()==0 && std::filesystem::is_regular_file(title_candidate_,error)) {
+            if (!std::filesystem::exists(destination,error)) std::filesystem::rename(title_candidate_,destination,error);
+            title_failed_=bool(error);
+            artwork_tried_=false;
+        } else title_failed_=true;
+        // These are this capture's newly created cache files, never player saves.
+        for (const auto& path : {title_candidate_,title_movie_,title_backup_}) {
+            std::error_code ignored;
+            std::filesystem::remove(path,ignored);
+        }
+        return;
+    }
+    if (artwork_[0] || title_pending_ || title_failed_ || slots_.empty() || !slots_[0]->has_program()) return;
+    std::error_code existing_error;
+    if (std::filesystem::exists(folder_/"art"/"title.png",existing_error)) {title_failed_=true;return;}
+    auto& slot=*slots_[0];
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (slot.checking || !slot.file.usable()) return;
+    }
+    std::error_code error;
+    std::filesystem::create_directories(folder_/"art",error);
+    if (error) {title_failed_=true;return;}
+    std::filesystem::create_directories(folder_/"cache",error);
+    if (error) {title_failed_=true;return;}
+    const auto prefix=folder_/"cache"/("title-"+std::to_string(SDL_GetTicksNS())+"-");
+    title_movie_=prefix;title_movie_+="input.movie";
+    title_backup_=prefix;title_backup_+="backup.bin";
+    title_candidate_=prefix;title_candidate_+="001500.png";
+    {
+        std::ofstream movie(title_movie_,std::ios::binary);
+        movie << "650 0800 0\n655 0 0\n";
+        if (!movie) {title_failed_=true;return;}
+    }
+    const std::vector<std::string> arguments={"--disc",slot.file_path,"--headless","--frames","1501","--video","software",
+        "--movie",title_movie_.string(),"--backup",title_backup_.string(),"--shot-every","1500:"+prefix.string()};
+    std::string message;
+    title_pending_=title_capture_.start(slot.program(),arguments,folder_,message,folder_/"cache"/"title-capture.log");
+    title_failed_=!title_pending_;
+}
+
+void App::sakura_art(float width) {
+    if (!artwork_tried_) {
+        artwork_tried_ = true;
+        const char* files[] = {"title.png"};
+        auto* renderer = SDL_GetRenderer(window_);
+        for (int i=0; i<1; i++) {
+            auto path = folder_ / "art" / files[i];
+            std::error_code error;
+            if (!std::filesystem::is_regular_file(path,error)) path=program_folder_ / "art" / files[i];
+            if (SDL_Surface* surface = SDL_LoadPNG(path.string().c_str())) {
+                artwork_[i] = SDL_CreateTextureFromSurface(renderer, surface);
+                SDL_DestroySurface(surface);
+                if (artwork_[i]) SDL_SetTextureScaleMode(artwork_[i], SDL_SCALEMODE_NEAREST);
+            }
+        }
+    }
+    prepare_title_art();
+    const auto& p = ui::palette();
+    const ImVec2 at = ImGui::GetCursorScreenPos();
+    const bool pair = false;
+    const float gap=px(16), pad=px(12), imageW=(width-pad*2-(pair?gap:0))/(pair?2:1);
+    const float imageH=std::min(px(208),imageW*0.7f), h=imageH+pad*2;
+    auto* draw=ImGui::GetWindowDrawList();
+    draw->AddRectFilled(at+ImVec2(0,px(4)),at+ImVec2(width,h+px(4)),IM_COL32(86,38,52,18),px(24));
+    draw->AddRectFilled(at,at+ImVec2(width,h),p.surface,px(24));
+    if (!pair) {
+        sakura_flower(draw,at+ImVec2(width*.12f,h*.45f),px(27),ui::fade(p.primary,.18f));
+        sakura_flower(draw,at+ImVec2(width*.88f,h*.55f),px(27),ui::fade(p.accent,.35f));
+    }
+    for (int i=0;i<(pair?2:1);i++) {
+        const ImVec2 begin=at+ImVec2(pad+i*(imageW+gap),pad), end=begin+ImVec2(imageW,imageH);
+        draw->AddRectFilled(begin,end,p.control,px(16));
+        if (artwork_[i]) {
+            float sourceW=1,sourceH=1;
+            SDL_GetTextureSize(artwork_[i],&sourceW,&sourceH);
+            const float factor=std::min(imageW/sourceW,imageH/sourceH);
+            const ImVec2 size(sourceW*factor,sourceH*factor);
+            const ImVec2 picture=begin+ImVec2((imageW-size.x)*.5f,(imageH-size.y)*.5f);
+            draw->AddImageRounded(ImTextureRef((ImTextureID)(intptr_t)artwork_[i]),picture,picture+size,ImVec2(0,0),ImVec2(1,1),IM_COL32_WHITE,px(16));
+        }
+        else {
+            draw->AddCircleFilled(begin+ImVec2(imageW*.8f,imageH*.2f),px(52),p.accent_soft);
+            draw->AddText(begin+ImVec2(px(16),imageH*.48f),p.primary,title_pending_?"Preparando el título…":"SAKURA WARS");
+        }
+    }
+    ImGui::Dummy(ImVec2(width,h));
+    ui::gap(20);
+}
