+void sakura_flower(ImDrawList* draw, ImVec2 center, float radius, ImU32 color) {
+    for (int petal=0;petal<5;petal++) {
+        const float angle=petal*1.256637f;
+        const ImVec2 along(std::cos(angle)*radius,std::sin(angle)*radius);
+        const ImVec2 across(-std::sin(angle)*radius*.48f,std::cos(angle)*radius*.48f);
+        const ImVec2 tip=center+along*1.4f;
+        draw->AddBezierCubic(center,center+along*.35f+across,tip+across*.5f,tip,color,ui::px(1));
+        draw->AddBezierCubic(tip,tip-across*.5f,center+along*.35f-across,center,color,ui::px(1));
+    }
+    draw->AddCircleFilled(center,ui::px(3),color);
+}
 
