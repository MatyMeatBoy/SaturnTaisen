+        for (int x=-height; x<width; x+=step)
+            SDL_RenderLine(renderer, static_cast<float>(x), 0, static_cast<float>(x+height), static_cast<float>(height));
+        const float radius = std::clamp(height * 0.024f, 10.0f, 40.0f);
+        for (int corner=0; corner<4; corner++) {
+            const float cx = width * (corner&1 ? 0.94f : 0.06f);
+            const float cy = height * (corner&2 ? 0.90f : 0.10f);
+            SDL_SetRenderDrawColor(renderer, 146, 63, 89, 64);
+            for (int petal=0; petal<5; petal++) {
+                const float angle=petal * 1.256637f;
+                SDL_FPoint points[25];
+                for (int n=0;n<=24;n++) {
+                    const float a=n*6.283185f/24;
+                    const float along=radius*(1.0f+std::cos(a)), across=radius*.50f*std::sin(a);
+                    points[n]={cx+along*std::cos(angle)-across*std::sin(angle),cy+along*std::sin(angle)+across*std::cos(angle)};
+                }
+                SDL_RenderLines(renderer, points, 25);
+            }
+        }
+        SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_NONE);
+    }
 
