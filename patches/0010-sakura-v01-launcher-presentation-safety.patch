+    void DrawSakuraFrame(SDL_Renderer* renderer, int width, int height) {
+        SDL_SetRenderDrawColor(renderer, 242, 224, 216, 255);
+        SDL_RenderClear(renderer);
+        SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_BLEND);
