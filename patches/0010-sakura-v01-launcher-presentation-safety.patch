+// SPDX-License-Identifier: GPL-3.0-only
+// Import creates a new managed copy. Original files and ordinary saves stay intact.
+#include "sakura_saves.h"
+#include "game_process.h"
+#include "layout.h"
+#include "ui.h"
+#include <array>
+#include <fstream>
+#include <memory>
+#include <mutex>
+
+namespace {
+struct ImportState {
+    std::mutex mutex;
+    std::string pending;
+    bool dialog=false, closed=false;
+    std::array<char,2048> source{};
+    std::unique_ptr<GameProcess> worker;
+    std::filesystem::path output, log;
+    bool finished=false, success=false, message_error=false;
+    std::string message;
+    int format=0;
+};
+std::shared_ptr<ImportState> state;
+
+void picked(void* userdata,const char* const* files,int) {
+    std::unique_ptr<std::shared_ptr<ImportState>> owner(static_cast<std::shared_ptr<ImportState>*>(userdata));
+    auto one=*owner;
+    std::lock_guard<std::mutex> lock(one->mutex);
+    if (!one->closed && files && files[0]) one->pending=files[0];
+    one->dialog=false;
+}
+}
+
+void ShutdownSakuraSaves() {
+    if (!state) return;
+    {
+        std::lock_guard<std::mutex> lock(state->mutex);
+        state->closed=true;
+    }
+    state->worker.reset(); // disables notifications before App/SDL teardown
+    state.reset(); // a pending dialog callback owns its own shared reference
+}
+
+void DrawSakuraSaves(launcher::PageContext& page) {
+    if (!state) state=std::make_shared<ImportState>();
+    auto& s=*state;
+    bool dialog=false;
+    {
+        std::lock_guard<std::mutex> lock(s.mutex);
+        if (!s.pending.empty()) {
+            SDL_strlcpy(s.source.data(),s.pending.c_str(),s.source.size());
+            s.pending.clear();
+        }
+        dialog=s.dialog;
+    }
+    const auto& p=ui::palette();
+    const bool running=s.worker && s.worker->running();
+    if (s.worker && !running && !s.finished) {
+        s.finished=true;
+        std::error_code error;
+        s.success=s.worker->exit_code()==0 && std::filesystem::file_size(s.output,error)==32768 && !error;
+        s.message_error=!s.success;
+        s.message=s.success?"Partida importada. Puedes usar esta copia en el próximo inicio.":"No se pudo importar este archivo.";
+        if (!s.success) {
+            std::ifstream log(s.log);
+            std::string line;
+            while (std::getline(log,line) && s.message.size()<4096) s.message+='\n'+line;
+        }
+    }
+    ui::gap(24);
+    ui::text("TUS PARTIDAS",ui::Font::Semibold,ui::size::kDetail,p.secondary);
+    ui::gap(10);
+    layout::Card card(page.width);
+    layout::row(page.width,"Importar desde un emulador","BUP, SAROO, memoria de Mednafen/Beetle, SSF y Yabause/Kronos. Se crea una copia; tu archivo original no cambia.",140,36,[&] {
+        if (ui::button("Elegir archivo…",ui::Kind::Secondary,140,!running && !dialog && !page.playing)) {
+            {
+                std::lock_guard<std::mutex> lock(s.mutex);
+                s.dialog=true;
+            }
+            static const SDL_DialogFileFilter filters[]={{"Partidas Saturn","bup;sro;bkr;bcr;bin;srm"},{"Todos los archivos","*"}};
+            SDL_ShowOpenFileDialog(picked,new std::shared_ptr<ImportState>(state),page.window,filters,2,nullptr,false);
+        }
+    });
+    layout::inset_separator(page.width);
+    layout::row(page.width,"Archivo de origen","También puedes pegar la ruta completa.",260,36,[&] {
+        ui::text_field("##save-source",s.source.data(),s.source.size(),"Ruta de la partida",260);
+    });
+    layout::row(page.width,"Formato","SSF individual: usa su nombre original, por ejemplo SAKURA___01.bin.",220,36,[&] {
+        ui::dropdown("##save-format",{"Detectar automáticamente","SSF · archivo individual"},s.format,220);
+    });
+    layout::row(page.width,running?"Importando…":"Crear una copia","La partida habitual queda guardada por separado.",140,36,[&] {
+        const auto helper=page.program_folder/"import-saves.exe";
+        if (ui::button("Importar",ui::Kind::Primary,140,s.source[0] && !running && !dialog && !page.playing)) {
+            std::error_code error;
+            const auto folder=page.folder/"imports";
+            std::filesystem::create_directories(folder,error);
+            s.output=folder/("partida-"+std::to_string(SDL_GetTicksNS())+".bin");
+            s.log=s.output;s.log.replace_extension("log");
+            s.finished=false;s.success=false;s.message_error=false;s.message.clear();
+            s.worker=std::make_unique<GameProcess>();
+            std::vector<std::string> arguments={s.source.data(),"--output",s.output.string()};
+            if (s.format) {arguments.push_back("--format");arguments.push_back("ssf-single");}
+            if (error || !s.worker->start(helper,arguments,page.folder,s.message,s.log)) {
+                s.finished=true;
+                s.message_error=true;
+                if (error) s.message="No se puede crear la carpeta de importación: "+error.message();
+            }
+        }
+    });
+    card.end();
+    if (!s.message.empty()) {
+        ui::gap(10);
+        ui::text(s.message.c_str(),ui::Font::Regular,ui::size::kDetail,s.message_error?p.danger:p.success,page.width);
+    }
+    std::error_code output_error;
+    if (s.success && std::filesystem::is_regular_file(s.output,output_error)) {
+        ui::gap(12);
+        if (ui::button("Usar esta partida",ui::Kind::Primary,180,!page.playing)) {
+            page.prefs.set("sakura","backup",s.output.string());
+            if (!page.prefs.save()) {s.message="No se pudo guardar la selección de partida.";s.message_error=true;}
+        }
+    }
+    if (!page.prefs.get("sakura","backup").empty()) {
+        ui::gap(10);
+        ui::text("Usando una copia importada",ui::Font::Semibold,ui::size::kDetail,p.success);
+        ui::gap(8);
+        if (ui::button("Volver a mi partida habitual",ui::Kind::Secondary,230,!page.playing)) {
+            page.prefs.set("sakura","backup","");
+            page.prefs.save();
+        }
+    }
+}
