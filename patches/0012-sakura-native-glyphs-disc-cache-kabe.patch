diff --git a/port/glyph_text.h b/port/glyph_text.h
new file mode 100644
--- /dev/null
+++ b/port/glyph_text.h
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <cstdint>
+#include <cstring>
+#include <span>
+namespace port {
+inline uint64_t AtlasFingerprint(std::span<const uint8_t> data) {
+    uint64_t hash=14695981039346656037ull;
+    for(auto byte:data) hash=(hash^byte)*1099511628211ull;
+    return hash;
+}
+inline bool KnownEnglishAtlas(std::span<const uint8_t> atlas) {
+    return atlas.size()==32768 && AtlasFingerprint(atlas)==0xA6A05DFF441E0C60ull;
+}
+inline char DecodeGlyph(std::span<const uint8_t> atlas,std::span<const uint8_t> tile) {
+    if(atlas.size()!=32768 || tile.size()!=128) return 0;
+    char result=0;
+    for(int ascii=32;ascii<=126;ascii++) if(std::memcmp(atlas.data()+(ascii-1)*128,tile.data(),128)==0) {
+        if(result) return 0; // ambiguous bitmap: leave native text intact
+        result=static_cast<char>(ascii);
+    }
+    return result;
+}
+}
diff --git a/port/kabe.h b/port/kabe.h
new file mode 100644
--- /dev/null
+++ b/port/kabe.h
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <cstdint>
+#include <span>
+#include <vector>
+namespace port {
+// KABE: RGB555 palette, 40x28 two-word names, then 8-bit 8x8 tiles.
+inline bool DecodeKabe(std::span<const uint8_t> data,std::vector<uint32_t>& pixels) {
+    if(data.size()!=76672) return false;
+    constexpr size_t tiles=0x1380;
+    pixels.assign(320*224,0);
+    for(int cy=0;cy<28;cy++)for(int cx=0;cx<40;cx++) {
+        const size_t at=512+(cy*40+cx)*4;
+        const uint32_t name=(uint32_t(data[at])<<24)|(uint32_t(data[at+1])<<16)|(uint32_t(data[at+2])<<8)|data[at+3];
+        const size_t address=tiles+(name&0x7FFF)*32;
+        if(address+64>data.size() || (name&0x00700000)) return false;
+        for(int y=0;y<8;y++)for(int x=0;x<8;x++) {
+            const int sx=name&0x40000000?7-x:x,sy=name&0x80000000?7-y:y;
+            const size_t palette=data[address+sy*8+sx]*2;
+            const uint16_t color=uint16_t(data[palette])<<8|data[palette+1];
+            pixels[(cy*8+y)*320+cx*8+x]=0xFF000000u|((color&31)<<3)|(((color>>5)&31)<<11)|(((color>>10)&31)<<19);
+        }
+    }
+    return true;
+}
+}
