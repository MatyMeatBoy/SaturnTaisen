+            const int first=draw->VtxBuffer.Size;
+            draw->AddText(gameFont,fontSize,origin,IM_COL32(24,24,24,255),letter);
+            // Preserve each native glyph's exact ink box, baseline and 8-pixel advance.
+            // Only the font raster is high resolution; game pixels remain integer-scaled.
+            const float sx=static_cast<float>((box[2]-box[0]+1)*scale)/(glyph->X1-glyph->X0);
+            const float sy=static_cast<float>((box[3]-box[1]+1)*scale)/(glyph->Y1-glyph->Y0);
+            for(int v=first;v<draw->VtxBuffer.Size;v++) {
+                auto& at=draw->VtxBuffer[v].pos;
+                at.x=origin.x+box[0]*scale+(at.x-origin.x-glyph->X0)*sx;
+                at.y=origin.y+box[1]*scale+(at.y-origin.y-glyph->Y0)*sy;
+            }
+        }
+    }
+    ImGui::PopFont();
+    ImGui::Render();ImGui_ImplSDLRenderer3_RenderDrawData(ImGui::GetDrawData(),renderer);
 }
