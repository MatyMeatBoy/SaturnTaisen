+                } else {
+                    publishSceneInset(loadingSides, loadingSidesTint, SDL_BLENDMODE_BLEND);
+                    if (!loadingSides.texture) return;
+                }
+                loadingSidesOffset = offset;
+            }
+            SDL_RenderTexture(renderer, loadingSides.texture, nullptr, &target);
+        };
