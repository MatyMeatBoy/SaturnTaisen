diff --git a/port/background_cache.h b/port/background_cache.h
new file mode 100644
index 0000000..b3d7d6b
--- /dev/null
+++ b/port/background_cache.h
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <SDL3/SDL.h>
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <span>
+#include <vector>
+#ifdef _WIN32
+#include <process.h>
+#else
+#include <unistd.h>
+#endif
+namespace port {
+inline bool ValidBackgroundPng(std::span<const uint8_t> bytes,int expectedWidth=0,int expectedHeight=0) {
+    static constexpr uint8_t signature[8]={137,80,78,71,13,10,26,10};
+    if(bytes.size()<33 || bytes.size()>16*1024*1024 || std::memcmp(bytes.data(),signature,8))return false;
+    auto word=[&](size_t at){return uint32_t(bytes[at])<<24|uint32_t(bytes[at+1])<<16|uint32_t(bytes[at+2])<<8|bytes[at+3];};
+    if(word(8)!=13 || std::memcmp(bytes.data()+12,"IHDR",4))return false;
+    const uint32_t width=word(16),height=word(20);
+    if(!width || !height || width>8192 || height>8192 || uint64_t(width)*height>4096*4096)return false;
+    return (!expectedWidth || width==unsigned(expectedWidth)) && (!expectedHeight || height==unsigned(expectedHeight));
+}
+inline bool ReadBackgroundPng(const std::filesystem::path& file,std::vector<uint8_t>& bytes,int width=0,int height=0) {
+    std::ifstream input(file,std::ios::binary|std::ios::ate);
+    if(!input || input.tellg()<33 || input.tellg()>16*1024*1024)return false;
+    bytes.resize(static_cast<size_t>(input.tellg()));input.seekg(0);
+    return bool(input.read(reinterpret_cast<char*>(bytes.data()),bytes.size())) && ValidBackgroundPng(bytes,width,height);
+}
+inline SDL_Surface* DecodeBackgroundPng(std::span<const uint8_t> bytes) {
+    if(!ValidBackgroundPng(bytes))return nullptr;
+    auto* input=SDL_IOFromConstMem(bytes.data(),bytes.size());
+    return input?SDL_LoadPNG_IO(input,true):nullptr;
+}
+inline SDL_Surface* ReadLegacyBackgroundPng(const std::filesystem::path& file,int width,int height) {
+    std::vector<uint8_t> bytes;
+    return ReadBackgroundPng(file,bytes,width,height)?DecodeBackgroundPng(bytes):nullptr;
+}
+inline uint64_t BackgroundPayloadHash(std::span<const uint8_t> bytes) {
+    uint64_t hash=14695981039346656037ull;
+    for(auto value:bytes)hash=(hash^value)*1099511628211ull;
+    return hash;
+}
+inline SDL_Surface* ReadBackgroundCache(const std::filesystem::path& file,int width,int height) {
+    if(width<=0 || height<=0 || width>864 || height>486)return nullptr;
+    const size_t bytes=size_t(width)*height*4;
+    std::ifstream input(file,std::ios::binary|std::ios::ate);
+    if(!input || input.tellg()!=static_cast<std::streamoff>(32+bytes))return nullptr;
+    std::array<uint8_t,32> header{};input.seekg(0);
+    if(!input.read(reinterpret_cast<char*>(header.data()),header.size()))return nullptr;
+    auto word=[&](int at,int count){uint64_t value=0;for(int i=0;i<count;i++)value|=uint64_t(header[at+i])<<(8*i);return value;};
+    if(std::memcmp(header.data(),"STFBG001",8) || word(8,4)!=unsigned(width) || word(12,4)!=unsigned(height) || word(16,4)!=bytes || word(20,4)!=0)return nullptr;
+    std::vector<uint8_t> payload(bytes);
+    if(!input.read(reinterpret_cast<char*>(payload.data()),payload.size()) || BackgroundPayloadHash(payload)!=word(24,8))return nullptr;
+    auto* surface=SDL_CreateSurface(width,height,SDL_PIXELFORMAT_ABGR8888);if(!surface)return nullptr;
+    for(int y=0;y<height;y++) {
+        auto* row=reinterpret_cast<uint32_t*>(static_cast<uint8_t*>(surface->pixels)+y*surface->pitch);
+        for(int x=0;x<width;x++) {
+            const auto* p=payload.data()+(size_t(y)*width+x)*4;
+            row[x]=uint32_t(p[0])|(uint32_t(p[1])<<8)|(uint32_t(p[2])<<16)|(uint32_t(p[3])<<24);
+        }
+    }
+    return surface;
+}
+inline bool WriteBackgroundCache(const std::filesystem::path& file,SDL_Surface* surface) {
+    if(!surface || surface->w<=0 || surface->h<=0 || surface->w>864 || surface->h>486)return false;
+    if(surface->format!=SDL_PIXELFORMAT_ABGR8888) {
+        auto* rgba=SDL_ConvertSurface(surface,SDL_PIXELFORMAT_ABGR8888);if(!rgba)return false;
+        const bool saved=WriteBackgroundCache(file,rgba);SDL_DestroySurface(rgba);return saved;
+    }
+    const size_t bytes=size_t(surface->w)*surface->h*4;
+    std::vector<uint8_t> payload(bytes);
+    if(!SDL_LockSurface(surface))return false;
+    for(int y=0;y<surface->h;y++) {
+        const auto* row=reinterpret_cast<const uint32_t*>(static_cast<const uint8_t*>(surface->pixels)+y*surface->pitch);
+        for(int x=0;x<surface->w;x++)for(int channel=0;channel<4;channel++)payload[(size_t(y)*surface->w+x)*4+channel]=static_cast<uint8_t>(row[x]>>(8*channel));
+    }
+    SDL_UnlockSurface(surface);
+    std::array<uint8_t,32> header{};std::memcpy(header.data(),"STFBG001",8);
+    auto put=[&](int at,uint64_t value,int count){for(int i=0;i<count;i++)header[at+i]=static_cast<uint8_t>(value>>(8*i));};
+    put(8,surface->w,4);put(12,surface->h,4);put(16,bytes,4);put(24,BackgroundPayloadHash(payload),8);
+    static std::atomic_uint64_t serial{0};
+#ifdef _WIN32
+    const auto process=_getpid();
+#else
+    const auto process=getpid();
+#endif
+    auto temporary=file;temporary+="."+std::to_string(process)+"."+std::to_string(serial.fetch_add(1))+".tmp";
+    std::ofstream output(temporary,std::ios::binary|std::ios::trunc);
+    output.write(reinterpret_cast<const char*>(header.data()),header.size());output.write(reinterpret_cast<const char*>(payload.data()),payload.size());output.close();
+    std::error_code error;
+    if(output)std::filesystem::rename(temporary,file,error);
+    if(!output || error) {std::error_code ignored;std::filesystem::remove(temporary,ignored);return false;}
+    return true;
+}
+}
diff --git a/port/palette_match.h b/port/palette_match.h
new file mode 100644
index 0000000..de3ce73
--- /dev/null
+++ b/port/palette_match.h
@@ -0,0 +1,54 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <limits>
+#include <span>
+#include <unordered_set>
+#include <vector>
+namespace port {
+// Exact Euclidean RGB lookup; ties retain the source palette's first entry.
+class PaletteMatcher {
+    struct Entry {uint32_t color;size_t order;std::array<int,3> rgb;};
+    struct Node {Entry entry;int left=-1,right=-1;unsigned axis=0;};
+    struct Hit {int distance=200000;size_t order=std::numeric_limits<size_t>::max();uint32_t color=0;};
+    std::vector<Entry> entries;
+    std::vector<Node> nodes;
+    int root=-1;
+    int Build(size_t first,size_t end,unsigned depth) {
+        if(first==end)return -1;
+        const unsigned axis=depth%3;const size_t middle=first+(end-first)/2;
+        std::nth_element(entries.begin()+first,entries.begin()+middle,entries.begin()+end,[&](const auto& a,const auto& b){
+            return a.rgb[axis]!=b.rgb[axis]?a.rgb[axis]<b.rgb[axis]:a.order<b.order;
+        });
+        const int at=static_cast<int>(nodes.size());nodes.push_back({entries[middle],-1,-1,axis});
+        const int left=Build(first,middle,depth+1),right=Build(middle+1,end,depth+1);
+        nodes[at].left=left;nodes[at].right=right;return at;
+    }
+    void Search(int at,const std::array<int,3>& pixel,Hit& best) const {
+        if(at<0)return;
+        const auto& node=nodes[at];
+        const int r=pixel[0]-node.entry.rgb[0],g=pixel[1]-node.entry.rgb[1],b=pixel[2]-node.entry.rgb[2];
+        const int distance=r*r+g*g+b*b;
+        if(distance<best.distance || (distance==best.distance && node.entry.order<best.order))best={distance,node.entry.order,node.entry.color};
+        if(best.distance==0)return; // duplicate RGB entries were removed, retaining the first
+        const int delta=pixel[node.axis]-node.entry.rgb[node.axis];
+        Search(delta<0?node.left:node.right,pixel,best);
+        if(best.distance && delta*delta<=best.distance)Search(delta<0?node.right:node.left,pixel,best);
+    }
+public:
+    explicit PaletteMatcher(std::span<const uint32_t> palette) {
+        entries.reserve(palette.size());nodes.reserve(palette.size());
+        std::unordered_set<uint32_t> seen;seen.reserve(palette.size());
+        for(size_t i=0;i<palette.size();i++) {
+            const uint32_t p=palette[i];
+            if(seen.insert(p&0xFFFFFF).second)entries.push_back({p,i,{int(p&255),int((p>>8)&255),int((p>>16)&255)}});
+        }
+        root=Build(0,entries.size(),0);
+    }
+    uint32_t Color(uint32_t pixel) const {
+        Hit hit;Search(root,{int(pixel&255),int((pixel>>8)&255),int((pixel>>16)&255)},hit);return hit.color;
+    }
+};
+}
