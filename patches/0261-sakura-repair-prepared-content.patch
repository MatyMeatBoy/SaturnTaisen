+    // Only metadata is needed to detect a missing or truncated managed file on startup.
+    unsigned checked=0;
+    while(std::getline(applied,line)) {
+        if(++checked>20000 || line.size()>4096 || line.size()<7 || line[1]!='\t')return true;
+        const auto separator=line.find('\t',2);
+        if(separator==std::string::npos || separator+1==line.size())return true;
+        uintmax_t expected=0;
+        const auto number=std::from_chars(line.data()+2,line.data()+separator,expected);
+        if(number.ec!=std::errc{} || number.ptr!=line.data()+separator)return true;
+
+        std::filesystem::path path;
+        try {
+            path=std::filesystem::u8path(line.begin()+separator+1,line.end());
+        } catch(const std::filesystem::filesystem_error&) {
+            return true;
+        }
+        if(path.has_root_path())return true;
+        for(const auto& part:path)if(part==".." || part==".")return true;
+        const auto first=*path.begin();
+        const bool game=line[0]=='P' && (first=="game" || first=="hd-resources");
+        const bool profile=line[0]=='H' && first=="art";
+        if(!game && !profile)return true;
+        std::error_code error;
+        const auto actual=std::filesystem::file_size((game?page.program_folder:page.folder)/path,error);
+        if(error || actual!=expected)return true;
+    }
+    return !checked || !applied.eof();
