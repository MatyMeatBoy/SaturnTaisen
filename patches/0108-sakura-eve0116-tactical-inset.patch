+    auto loadEveInset = [&](SceneHd& inset, const char* file, size_t size, uint64_t hash, port::EveRect crop) {
+        if (!inset.tried) {
+            inset.tried = true;
+            inset.pending = std::async(std::launch::async,
+                [path = std::filesystem::u8path(port.opt.pcAssetsPath) / file, size, hash, crop]() {
+                    SceneHdPixels result;
+                    std::vector<uint8_t> bytes;
+                    if (!ReadPcBackdropFile(path, bytes, size) || bytes.size() != size ||
+                        PcBackdropHash(bytes) != hash) return result;
+                    std::vector<PcSprite> images;
+                    std::string error;
+                    if (!DecodePcSprites(bytes, images, error)) return result;
+                    for (auto& image : images) {
+                        if (image.index != port::kEve202PcImage ||
+                            image.width != port::kEve202PcWidth || image.height != port::kEve202PcHeight) continue;
+                        result.width = crop.width;
+                        result.height = crop.height;
+                        result.pixels.reserve(size_t(crop.width) * crop.height);
+                        for (int y = 0; y < crop.height; ++y) {
+                            const auto first = image.pixels.begin() + (y + crop.y) * image.width + crop.x;
+                            result.pixels.insert(result.pixels.end(), first, first + crop.width);
+                        }
+                        break;
+                    }
+                    return result;
+                });
+        }
+        if (!inset.pending.valid() || inset.pending.wait_for(std::chrono::seconds(0)) != std::future_status::ready)
+            return;
+        auto pixels = inset.pending.get();
+        if (pixels.pixels.empty()) return;
+        auto* picture = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_ABGR8888,
+            SDL_TEXTUREACCESS_STATIC, pixels.width, pixels.height);
+        if (picture && SDL_UpdateTexture(picture, nullptr, pixels.pixels.data(), pixels.width * 4)) {
+            SDL_SetTextureScaleMode(picture, SDL_SCALEMODE_NEAREST);
+            SDL_SetTextureBlendMode(picture, SDL_BLENDMODE_NONE);
+            inset.texture = picture;
+        } else if (picture) SDL_DestroyTexture(picture);
+    };
+    const auto insetRgb = [](std::span<const uint32_t> pixels) {
+        uint64_t hash = 14695981039346656037ull;
+        for (int y = 8; y < 152; ++y) {
+            for (int x = 16; x < 304; ++x) {
+                const uint32_t pixel = pixels[size_t(y) * 320 + x];
+                for (unsigned shift : {0u, 8u, 16u})
+                    hash = (hash ^ uint8_t(pixel >> shift)) * 1099511628211ull;
+            }
+        }
+        return hash;
+    };
