diff --git a/port/item_icons.h b/port/item_icons.h
new file mode 100644
--- /dev/null
+++ b/port/item_icons.h
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <span>
+
+namespace port::item_icons {
+inline constexpr int nativeSize=32, donorSize=72, hdSize=64;
+inline constexpr uint64_t paletteHash=0x3BBF6ACDF791D975ull;
+
+struct Donor {const char* file;std::size_t bytes;uint64_t hash;};
+inline constexpr Donor donors[]{
+    {"SAKURA1/ITEM/BUROICON.SPR",71079,0xA164748F44CC3535ull},
+    {"SAKURA1/ITEM/ITEMICON.SPR",154369,0x8C08BABCC7B4DD3Eull},
+};
+struct Icon {uint64_t texture;unsigned donor, ordinal;int cropX,cropY;};
+inline constexpr Icon icons[]{
+    {0x33653581F9CF5752ull,0,1,4,4},
+    {0x8E1CF7C5200587B8ull,0,2,5,4},
+    {0xA728E5B8A7F511C5ull,0,9,5,4},
+    {0xDA65A5CEA3A1FF6Bull,0,13,5,4},
+    {0x5191906B7F43728Aull,1,19,4,4},
+    {0xCAAA5A9759CF98D3ull,1,20,4,4},
+    {0xF62D05C1F37521BEull,1,28,5,4},
+};
+
+constexpr uint64_t Fingerprint(std::span<const uint8_t> bytes) {
+    uint64_t hash=0xcbf29ce484222325ull;
+    for(const auto b:bytes)hash=(hash^b)*0x100000001b3ull;
+    return hash;
+}
+constexpr int Signed(uint16_t value) {return int((value&0x1FFF)^0x1000)-0x1000;}
+
+template<class Sprite>
+bool IsRectangle(const Sprite& sprite,uint16_t mode,uint16_t color,uint16_t size) {
+    const auto& w=sprite.command.words;
+    return (w[0]&0x8FFF)==1 && w[2]==mode && w[3]==color && w[5]==size &&
+        Signed(w[10])-Signed(w[6])+1==int((size>>8)&63)*8 &&
+        Signed(w[11])-Signed(w[7])+1==int(size&255);
+}
+
+template<class Sprite>
+bool Overlaps(const Sprite& sprite,int x,int y) {
+    const auto& w=sprite.command.words;
+    const unsigned kind=w[0]&15;
+    if(kind>=8)return false; // clipping and coordinate commands write no pixels
+    int left=sprite.x,right=left,top=sprite.y,bottom=top;
+    if(kind==0) {
+        right+=int((w[5]>>8)&63)*8-1;
+        bottom+=int(w[5]&255)-1;
+    }else{
+        if(kind==1 && (w[0]&0xF00))return true; // scaled with a zoom anchor
+        if(kind==3 || kind==7)return true; // reserved or unsupported
+        const int ox=sprite.x-Signed(w[6]),oy=sprite.y-Signed(w[7]);
+        const std::array<unsigned,3> vertices{8u,10u,12u};
+        for(const auto v:vertices) {
+            if((kind==1 && v!=10) || (kind==6 && v!=8))continue;
+            const int vx=ox+Signed(w[v]),vy=oy+Signed(w[v+1]);
+            left=std::min(left,vx);right=std::max(right,vx);
+            top=std::min(top,vy);bottom=std::max(bottom,vy);
+        }
+    }
+    return right>=x && left<x+nativeSize && bottom>=y && top<y+nativeSize;
+}
+
+constexpr uint32_t NativeRgb(std::span<const uint8_t> palette,uint8_t index) {
+    const uint16_t w=(uint16_t(palette[2*index])<<8)|palette[2*index+1];
+    return ((w&31u)<<3)|((w&0x3E0u)<<6)|((w&0x7C00u)<<9);
+}
+}
