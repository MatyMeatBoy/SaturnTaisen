+#pragma once
+
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace port::ra {
+
+struct PendingAward {
+    std::string username;
+    std::string hash;
+    uint32_t game;
+    uint32_t achievement;
+    int64_t earnedAt;
+    bool operator==(const PendingAward&) const = default;
+};
+
+class AwardJournal {
+public:
+    explicit AwardJournal(const std::filesystem::path& profile);
+
+    // A true return also covers an existing pending record for this account
+    // and achievement. Preserve the original earning time in that case.
+    bool Enqueue(const PendingAward& award) const;
+    std::vector<PendingAward> Pending(std::string_view username) const;
+    bool Acknowledge(const PendingAward& award) const;
+
+private:
+    std::filesystem::path PathFor(const PendingAward& award) const;
+
+    std::filesystem::path folder_;
+};
+
+}
diff --git a/port/ra_profile.cpp b/port/ra_profile.cpp
new file mode 100644
--- /dev/null
+++ b/port/ra_profile.cpp
@@ -0,0 +1,275 @@
+#include "ra_profile.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <charconv>
+#include <ctime>
+#include <fstream>
+#include <iomanip>
+#include <iterator>
+#include <sstream>
+#include <string_view>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#include <dpapi.h>
+#endif
+
+namespace port::ra {
+namespace {
+namespace fs = std::filesystem;
+
+fs::path Folder(const fs::path& profile) {
+    return profile / "retroachievements";
+}
+
+bool AtomicWrite(const fs::path& path, std::string_view bytes) {
+    std::error_code error;
+    fs::create_directories(path.parent_path(), error);
+    if (error)
+        return false;
+
+    static std::atomic<uint64_t> sequence = 0;
+    const auto ticks = std::chrono::steady_clock::now().time_since_epoch().count();
+    auto partial = path;
+    partial += "." + std::to_string(ticks) + "-" + std::to_string(++sequence) + ".tmp";
+    std::ofstream out(partial, std::ios::binary | std::ios::trunc);
+    out.write(bytes.data(), static_cast<std::streamsize>(bytes.size()));
+    out.close();
+    bool success = false;
+    if (out) {
+#ifdef _WIN32
+        success = MoveFileExW(partial.c_str(), path.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH) != 0;
+#else
+        fs::rename(partial, path, error);
+        success = !error;
+#endif
+    }
+    if (!success)
+        fs::remove(partial, error);
+    return success;
+}
+
+std::string ReadBounded(const fs::path& path, size_t maxBytes) {
+    std::error_code error;
+    const auto size = fs::file_size(path, error);
+    if (error || size == 0 || size > maxBytes)
+        return {};
+    std::ifstream in(path, std::ios::binary);
+    std::string bytes(static_cast<size_t>(size),'\0');
+    if (!in.read(bytes.data(), static_cast<std::streamsize>(bytes.size())) || in.peek() != std::char_traits<char>::eof())
+        return {};
+    return bytes;
+}
+
+std::string Clean(std::string_view string, size_t max) {
+    std::string text(string.substr(0, max));
+    for (auto& ch : text)
+        if (static_cast<unsigned char>(ch) < 32 || ch == 127)
+            ch = ' ';
+    return text;
+}
+
+bool Valid(const Credentials& account) {
+    return !account.username.empty() && !account.token.empty() &&
+        account.username.size() <= 128 && account.token.size() <= 512 &&
+        account.username == Clean(account.username, 128) && account.token == Clean(account.token, 512);
+}
+fs::path OfflinePath(const fs::path& profile, std::string_view username, std::string_view hash) {
+    constexpr std::string_view accountChars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-";
+    if (profile.empty() || username.empty() || username.size() > 128 ||
+        username.find_first_not_of(accountChars) != username.npos || hash.size() != 32 ||
+        hash.find_first_not_of("0123456789abcdef") != hash.npos)
+        return {};
+    return Folder(profile) / ("user-" + std::string(username)) / (std::string(hash) + ".cache");
+}
+
+#ifdef _WIN32
+bool ProtectAndWrite(const fs::path& path, std::string& plain) {
+    DATA_BLOB input{static_cast<DWORD>(plain.size()), reinterpret_cast<BYTE*>(plain.data())};
+    DATA_BLOB encrypted{};
+    const bool protectedData = CryptProtectData(&input, L"SaturnTaisen RetroAchievements", nullptr, nullptr,
+        nullptr, CRYPTPROTECT_UI_FORBIDDEN, &encrypted) != 0;
+    SecureZeroMemory(plain.data(), plain.size());
+    if (!protectedData)
+        return false;
+    const std::string_view data(reinterpret_cast<const char*>(encrypted.pbData), encrypted.cbData);
+    const bool saved = AtomicWrite(path, data);
+    LocalFree(encrypted.pbData);
+    return saved;
+}
+
+std::string ReadAndUnprotect(const fs::path& path, size_t maxBytes) {
+    auto bytes = ReadBounded(path, maxBytes);
+    if (bytes.empty())
+        return {};
+    DATA_BLOB encrypted{static_cast<DWORD>(bytes.size()), reinterpret_cast<BYTE*>(bytes.data())};
+    DATA_BLOB plain{};
+    if (!CryptUnprotectData(&encrypted, nullptr, nullptr, nullptr, nullptr, CRYPTPROTECT_UI_FORBIDDEN, &plain))
+        return {};
+    const std::string decoded(reinterpret_cast<const char*>(plain.pbData), plain.cbData);
+    SecureZeroMemory(plain.pbData, plain.cbData);
+    LocalFree(plain.pbData);
+    return decoded;
+}
+#endif
+
+}
+
+std::optional<Credentials> LoadCredentials(const std::filesystem::path& profile) {
+#ifdef _WIN32
+    auto data = ReadAndUnprotect(Folder(profile) / "account.dat", 8192);
+    const auto delimiter = data.find('\0');
+    std::optional<Credentials> account;
+    if (delimiter != data.npos) {
+        Credentials result{data.substr(0, delimiter), data.substr(delimiter + 1)};
+        if (Valid(result))
+            account = std::move(result);
+        SecureZeroMemory(result.token.data(), result.token.size());
+    }
+    SecureZeroMemory(data.data(), data.size());
+    return account;
+#else
+    (void) profile;
+    return std::nullopt;
+#endif
+}
+
+bool SaveCredentials(const std::filesystem::path& profile, const Credentials& credentials) {
+#ifdef _WIN32
+    if (profile.empty() || !Valid(credentials))
+        return false;
+
+    std::string plain = credentials.username;
+    plain.push_back('\0');
+    plain += credentials.token;
+    return ProtectAndWrite(Folder(profile) / "account.dat", plain);
+#else
+    (void) profile;
+    (void) credentials;
+    return false;
+#endif
+}
+
+bool ForgetCredentials(const std::filesystem::path& profile) {
+    if (profile.empty())
+        return false;
+    std::error_code error;
+    fs::remove(Folder(profile) / "account.dat", error);
+    return !error;
+}
+
+bool SaveProgress(const std::filesystem::path& profile, const Progress& progress) {
+    if (profile.empty() || progress.achievements.size() > 512)
+        return false;
+    std::ostringstream data;
+    data << "SATURN-RA-PROGRESS-1\n" << std::quoted(Clean(progress.username,128)) << ' '
+         << std::quoted(Clean(progress.state,32)) << '\n';
+    data << progress.achievements.size() << '\n';
+    for (const auto& row : progress.achievements)
+        data << row.id << ' ' << row.points << ' ' << row.unlocked << ' '
+             << std::quoted(Clean(row.title,256)) << ' ' << std::quoted(Clean(row.description,512)) << ' '
+             << std::quoted(Clean(row.badgeKey,128)) << '\n';
+    return AtomicWrite(Folder(profile) / "progress.txt", data.str());
+}
+
+std::optional<Progress> LoadProgress(const std::filesystem::path& profile) {
+    std::istringstream data(ReadBounded(Folder(profile) / "progress.txt", 1024 * 1024));
+    std::string version;
+    Progress progress;
+    size_t count = 0;
+    if (!(data >> version >> std::quoted(progress.username) >> std::quoted(progress.state) >> count) ||
+        version != "SATURN-RA-PROGRESS-1" || count > 512)
+        return std::nullopt;
+
+    progress.achievements.reserve(count);
+    for (size_t index = 0; index < count; ++index) {
+        ProgressRow row{};
+        if (!(data >> row.id >> row.points >> row.unlocked >> std::quoted(row.title) >>
+              std::quoted(row.description) >> std::quoted(row.badgeKey)) || !row.id)
+            return std::nullopt;
+        progress.achievements.push_back(std::move(row));
+    }
+    data >> std::ws;
+    return data.eof() ? std::optional(std::move(progress)) : std::nullopt;
+}
+
+
+bool SaveOfflineSession(const std::filesystem::path& profile, std::string_view username,
+                        std::string_view hash, const OfflineSession& session) {
+#ifdef _WIN32
+    const auto path = OfflinePath(profile, username, hash);
+    if (path.empty() || session.catalog.empty() || session.catalog.size() > 4*1024*1024 ||
+        session.unlocks.empty() || session.unlocks.size() > 512*1024)
+        return false;
+    std::string bytes = "SATURN-RA-SESSION-1\n" + std::string(username) + "\n" + std::string(hash) +
+        "\n" + std::to_string(session.catalog.size()) + "\n" + session.catalog + session.unlocks;
+    return ProtectAndWrite(path, bytes);
+#else
+    (void) profile; (void) username; (void) hash; (void) session;
+    return false;
+#endif
+}
+
+std::optional<OfflineSession> LoadOfflineSession(const std::filesystem::path& profile,
+                                               std::string_view username, std::string_view hash) {
+#ifdef _WIN32
+    const auto path = OfflinePath(profile, username, hash);
+    if (path.empty())
+        return std::nullopt;
+    const auto bytes = ReadAndUnprotect(path, 5*1024*1024);
+    const auto header = "SATURN-RA-SESSION-1\n" + std::string(username) + "\n" + std::string(hash) + "\n";
+    if (!bytes.starts_with(header))
+        return std::nullopt;
+    const auto split = bytes.find('\n', header.size());
+    if (split == bytes.npos)
+        return std::nullopt;
+    size_t size = 0;
+    const auto range = std::from_chars(bytes.data() + header.size(), bytes.data() + split, size);
+    if (range.ec != std::errc{} || range.ptr != bytes.data() + split || !size ||
+        size > 4*1024*1024 || size >= bytes.size() - split - 1)
+        return std::nullopt;
+    return OfflineSession{bytes.substr(split + 1, size), bytes.substr(split + 1 + size)};
+#else
+    (void) profile; (void) username; (void) hash;
+    return std::nullopt;
+#endif
+}
+
+std::string ReadActivity(const std::filesystem::path& profile) {
+    return ReadBounded(Folder(profile) / "activity.log", 16384);
+}
+
+void AddActivity(const std::filesystem::path& profile, std::string_view type, uint32_t id) {
+    auto activity = ReadActivity(profile);
+    if (activity.size() > 15000) {
+        const auto line = activity.find('\n', activity.size() - 12000);
+        activity.erase(0, line == activity.npos ? activity.size() : line + 1);
+    }
+    activity += std::to_string(std::time(nullptr)) + " " + Clean(type,32) + " " + std::to_string(id) + "\n";
+    AtomicWrite(Folder(profile) / "activity.log", activity);
+}
+
+bool SaveBadge(const std::filesystem::path& profile, std::string_view filename, std::string_view bytes) {
+    constexpr std::string_view png = "\x89PNG\r\n\x1a\n";
+    if (!filename.ends_with(".png") || filename.size() > 36 ||
+        filename.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-.") != filename.npos ||
+        filename.find("..") != filename.npos || bytes.size() < 33 || bytes.size() > 256*1024 ||
+        !bytes.starts_with(png) || bytes.substr(12,4) != "IHDR")
+        return false;
+    auto word = [&](size_t at) {
+        uint32_t result = 0;
+        for (size_t index = 0; index < 4; ++index)
+            result = (result << 8) | static_cast<unsigned char>(bytes[at + index]);
+        return result;
+    };
+    const auto width = word(16), height = word(20);
+    if (!width || !height || width > 256 || height > 256)
+        return false;
+    return AtomicWrite(Folder(profile) / "badges" / filename, bytes);
+}
+
+}
