+void SakuraUi::AchievementToast(int x,int y,int width,const std::string& title,uint32_t points,SDL_Texture* badge) {
+    if (!active || width < 120)
+        return;
+    ImGui_ImplSDLRenderer3_NewFrame(); ImGui_ImplSDL3_NewFrame(); ImGui::NewFrame();
+    auto* draw = ImGui::GetForegroundDrawList();
+    const ImVec2 origin{float(x), float(y)};
+    const ImVec2 end{float(x + width), float(y + 58)};
+    const auto& colors = ui::palette();
+    draw->AddRectFilled(origin, end, colors.surface, 9.0f);
+    draw->AddRect(origin, end, colors.accent, 9.0f);
+    int textX = x + 8;
+    if (badge) {
+        draw->AddImage(ImTextureID(reinterpret_cast<uintptr_t>(badge)),
+                       ImVec2(float(x + 8), float(y + 12)), ImVec2(float(x + 42), float(y + 46)));
+        textX = x + 49;
+    }
+    const auto heading = ui::fit_end(title, ui::Font::Semibold, 14, float(x + width - textX - 8));
+    const auto scored = "+" + std::to_string(points) + " puntos";
+    draw->PushClipRect(origin, end, true);
+    ui::push_font(ui::Font::Semibold, 14);
+    draw->AddText(ImVec2(float(textX), float(y + 9)), colors.text, heading.c_str());
+    ui::pop_font();
+    ui::push_font(ui::Font::Regular, 12);
+    draw->AddText(ImVec2(float(textX), float(y + 34)), colors.secondary, scored.c_str());
+    ui::pop_font();
+    draw->PopClipRect();
