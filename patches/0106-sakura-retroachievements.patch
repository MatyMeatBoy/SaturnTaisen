diff --git a/port/ra_transport.cpp b/port/ra_transport.cpp
new file mode 100644
--- /dev/null
+++ b/port/ra_transport.cpp
@@ -0,0 +1,178 @@
+#include "ra_transport.h"
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <memory>
+#include <utility>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#include <winhttp.h>
+#endif
+
+namespace port::ra {
+
+Endpoint ClassifyEndpoint(std::string_view url, bool post) {
+    if (url == "https://retroachievements.org/dorequest.php")
+        return post ? Endpoint::Api : Endpoint::Invalid;
+    constexpr std::string_view start = "https://media.retroachievements.org/Badge/";
+    if (post || !url.starts_with(start) || !url.ends_with(".png"))
+        return Endpoint::Invalid;
+    const auto file = url.substr(start.size(), url.size() - start.size() - 4);
+    if (file.empty() || file.size() > 32 ||
+        !std::ranges::all_of(file, [](char ch) {
+            return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
+                (ch >= '0' && ch <= '9') || ch == '_' || ch == '-';
+        }))
+        return Endpoint::Invalid;
+    return Endpoint::Badge;
+}
+
+RequestWorker::RequestWorker(Exchange exchange)
+    : exchange_(std::move(exchange)), worker_(&RequestWorker::Run, this) {}
+
+RequestWorker::~RequestWorker() {
+    {
+        const std::lock_guard lock(mutex_);
+        stopping_ = true;
+    }
+    work_.notify_one();
+    worker_.join();
+}
+
+bool RequestWorker::Submit(Request request) {
+    {
+        const std::lock_guard lock(mutex_);
+        if (stopping_ || requests_.size() + responses_.size() >= 128)
+            return false;
+        requests_.push_back(std::move(request));
+    }
+    work_.notify_one();
+    return true;
+}
+
+std::vector<Response> RequestWorker::TakeResponses() {
+    const std::lock_guard lock(mutex_);
+    return std::exchange(responses_, {});
+}
+
+void RequestWorker::Run() {
+    for (;;) {
+        Request request;
+        {
+            std::unique_lock lock(mutex_);
+            work_.wait(lock, [this] { return stopping_ || !requests_.empty(); });
+            if (stopping_)
+                return;
+            request = std::move(requests_.front());
+            requests_.pop_front();
+        }
+        Response result{request.id, RC_API_SERVER_RESPONSE_CLIENT_ERROR, {}};
+        try {
+            result = exchange_(request);
+            result.id = request.id;
+        } catch (...) {}
+        const std::lock_guard lock(mutex_);
+        if (!stopping_)
+            responses_.push_back(std::move(result));
+    }
+}
+
+#ifdef _WIN32
+namespace {
+struct CloseHttp {
+    void operator()(void* handle) const { WinHttpCloseHandle(handle); }
+};
+using Http = std::unique_ptr<void, CloseHttp>;
+
+Response WinHttpRequest(const Request& request, const std::wstring& agent) {
+    const auto invalid = Response{request.id, RC_API_SERVER_RESPONSE_CLIENT_ERROR, {}};
+    const auto retryable = Response{request.id, RC_API_SERVER_RESPONSE_RETRYABLE_CLIENT_ERROR, {}};
+    const auto endpoint = ClassifyEndpoint(request.url, !request.data.empty());
+    if (endpoint == Endpoint::Invalid || agent.empty() || request.data.size() > 4096)
+        return invalid;
+
+    const bool api = endpoint == Endpoint::Api;
+    if (api && request.contentType != "application/x-www-form-urlencoded")
+        return invalid;
+    constexpr wchar_t requestHeader[] = L"Content-Type: application/x-www-form-urlencoded";
+    constexpr DWORD tls = WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_2;
+    const Http session(WinHttpOpen(agent.c_str(), WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY,
+        WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0));
+    if (!session || !WinHttpSetTimeouts(session.get(), 3000, 3000, 3000, 3000))
+        return retryable;
+    DWORD protocols = tls;
+#ifdef WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_3
+    protocols |= WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_3;
+#endif
+    if (!WinHttpSetOption(session.get(), WINHTTP_OPTION_SECURE_PROTOCOLS, &protocols, sizeof(protocols))) {
+        protocols = tls;
+        if (!WinHttpSetOption(session.get(), WINHTTP_OPTION_SECURE_PROTOCOLS, &protocols, sizeof(protocols)))
+            return invalid;
+    }
+    const Http connection(WinHttpConnect(session.get(), api ? L"retroachievements.org" : L"media.retroachievements.org",
+                                          INTERNET_DEFAULT_HTTPS_PORT, 0));
+    if (!connection)
+        return retryable;
+
+    const auto pathAt = request.url.find('/', std::string_view("https://").size());
+    const std::wstring path(request.url.begin() + pathAt, request.url.end());
+    const Http handle(WinHttpOpenRequest(connection.get(), api ? L"POST" : L"GET", path.c_str(), nullptr,
+                                         WINHTTP_NO_REFERER, WINHTTP_DEFAULT_ACCEPT_TYPES, WINHTTP_FLAG_SECURE));
+    if (!handle)
+        return retryable;
+    DWORD redirects = WINHTTP_OPTION_REDIRECT_POLICY_NEVER;
+    DWORD autoLogon = WINHTTP_AUTOLOGON_SECURITY_LEVEL_HIGH;
+    if (!WinHttpSetOption(handle.get(), WINHTTP_OPTION_REDIRECT_POLICY, &redirects, sizeof(redirects)) ||
+        !WinHttpSetOption(handle.get(), WINHTTP_OPTION_AUTOLOGON_POLICY, &autoLogon, sizeof(autoLogon)))
+        return invalid;
+
+    const auto length = static_cast<DWORD>(request.data.size());
+    if (!WinHttpSendRequest(handle.get(), api ? requestHeader : WINHTTP_NO_ADDITIONAL_HEADERS,
+                            api ? static_cast<DWORD>(-1) : 0,
+                            api ? const_cast<char*>(request.data.data()) : WINHTTP_NO_REQUEST_DATA, length, length, 0) ||
+        !WinHttpReceiveResponse(handle.get(), nullptr))
+        return retryable;
+    DWORD status = 0;
+    DWORD statusSize = sizeof(status);
+    if (!WinHttpQueryHeaders(handle.get(), WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER,
+                              WINHTTP_HEADER_NAME_BY_INDEX, &status, &statusSize, WINHTTP_NO_HEADER_INDEX))
+        return retryable;
+
+    Response result{request.id, static_cast<int>(status), {}};
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(12);
+    const size_t limit = api ? 8 * 1024 * 1024 : 256 * 1024;
+    std::array<char, 8192> bytes;
+    for (;;) {
+        DWORD read = 0;
+        if (!WinHttpReadData(handle.get(), bytes.data(), static_cast<DWORD>(bytes.size()), &read))
+            return retryable;
+        if (read == 0)
+            return result;
+        if (read > limit - result.body.size())
+            return invalid;
+        result.body.append(bytes.data(), read);
+        if (std::chrono::steady_clock::now() > deadline)
+            return retryable;
+    }
+}
+}
+#endif
+
+Exchange WinHttpExchange(std::wstring userAgent) {
+#ifdef _WIN32
+    return [agent = std::move(userAgent)](const Request& request) {
+        return WinHttpRequest(request, agent);
+    };
+#else
+    (void) userAgent;
+    return [](const Request& request) {
+        return Response{request.id, RC_API_SERVER_RESPONSE_CLIENT_ERROR, {}};
+    };
+#endif
+}
+
+}
diff --git a/port/ra_transport.h b/port/ra_transport.h
new file mode 100644
--- /dev/null
+++ b/port/ra_transport.h
@@ -0,0 +1,47 @@
+#pragma once
+
+#include "ra_client.h"
+
+#include <condition_variable>
+#include <deque>
+#include <functional>
+#include <mutex>
+#include <thread>
+
+namespace port::ra {
+
+enum class Endpoint { Invalid, Api, Badge };
+Endpoint ClassifyEndpoint(std::string_view url, bool post);
+
+struct Response {
+    uint64_t id;
+    int status;
+    std::string body;
+};
+
+using Exchange = std::function<Response(const Request&)>;
+Exchange WinHttpExchange(std::wstring userAgent);
+
+class RequestWorker {
+public:
+    explicit RequestWorker(Exchange exchange);
+    ~RequestWorker();
+    RequestWorker(const RequestWorker&) = delete;
+    RequestWorker& operator=(const RequestWorker&) = delete;
+
+    bool Submit(Request request);
+    std::vector<Response> TakeResponses();
+
+private:
+    void Run();
+
+    Exchange exchange_;
+    std::mutex mutex_;
+    std::condition_variable work_;
+    std::deque<Request> requests_;
+    std::vector<Response> responses_;
+    bool stopping_ = false;
+    std::thread worker_;
+};
+
+}
diff --git a/port/ra_host.cpp b/port/ra_host.cpp
new file mode 100644
--- /dev/null
+++ b/port/ra_host.cpp
@@ -0,0 +1,227 @@
+#include "ra_host.h"
+
+#include <iomanip>
+#include <sstream>
+#include <utility>
+
+namespace port::ra {
+namespace {
+
+std::string_view StateLabel(const Client& client) {
+    switch (client.GetState()) {
+    case State::SignedOut: return "signed_out";
+    case State::SigningIn: return "signing_in";
+    case State::WaitingForMedia: return "waiting_for_media";
+    case State::Loading: return "loading";
+    case State::Ready: return client.Disconnected() ? "offline" : "ready";
+    case State::UnsupportedMedia: return "unsupported_media";
+    case State::Error: return "connection_error";
+    }
+    return "connection_error";
+}
+
+std::string BadgeName(std::string_view url) {
+    return ClassifyEndpoint(url, false) == Endpoint::Badge
+        ? std::string(url.substr(url.find_last_of('/') + 1)) : std::string{};
+}
+
+}
+
+std::unique_ptr<Session> Session::Open(const std::filesystem::path& profile,
+                                       std::span<const uint8_t> systemArea, Exchange exchange) {
+    if (profile.empty())
+        return nullptr;
+    auto account = LoadCredentials(profile);
+    if (!account)
+        return nullptr;
+    const auto hash = SaturnDiscHash(systemArea);
+    if (!IsKnownDiscHash(hash)) {
+        SaveProgress(profile, {account->username, "unsupported_media", {}});
+        return nullptr;
+    }
+    return std::make_unique<Session>(profile, std::move(*account), hash, std::move(exchange));
+}
+
+Session::Session(std::filesystem::path profile, Credentials credentials, std::string_view hash, Exchange exchange)
+    : profile_(std::move(profile)), credentials_(std::move(credentials)), username_(credentials_.username),
+      mediaHash_(hash), client_(profile_), worker_(std::move(exchange)) {
+    if (client_.SetMedia(hash))
+        client_.Login(credentials_.username, credentials_.token);
+    Dispatch();
+}
+
+void Session::Frame(std::span<const uint8_t> low, std::span<const uint8_t> high) {
+    Receive();
+    client_.Evaluate(low, high);
+    Dispatch();
+}
+
+void Session::Idle() {
+    Receive();
+    client_.Idle();
+    Dispatch();
+}
+
+void Session::Reset() {
+    client_.Reset();
+    popups_.clear();
+    expiry_ = 0;
+}
+
+const Notification* Session::Popup(uint64_t frame) {
+    if (expiry_ && frame >= expiry_) {
+        if (!popups_.empty())
+            popups_.pop_front();
+        expiry_ = 0;
+    }
+    return popups_.empty() ? nullptr : &popups_.front();
+}
+
+void Session::PopupShown(uint64_t frame) {
+    if (!popups_.empty() && !expiry_)
+        expiry_ = frame + 240;
+}
+
+void Session::Receive() {
+    for (const auto& result : worker_.TakeResponses()) {
+        if (result.id == activeBadgeId_) {
+            if (result.status == 200)
+                SaveBadge(profile_, BadgeName(activeBadge_), result.body);
+            activeBadge_.clear();
+            activeBadgeId_ = 0;
+        } else {
+            HandleApi(result);
+        }
+    }
+}
+
+bool Session::StartOffline(uint64_t pendingLogin) {
+    offline_ = LoadOfflineSession(profile_, username_, mediaHash_);
+    if (!offline_)
+        return false;
+    Progress view{username_, "offline", {}};
+    const auto previous = LoadProgress(profile_);
+    if (previous && previous->username == username_)
+        view.achievements = previous->achievements;
+    client_.SetOfflineProgress(view);
+
+    // Only rcheevos' in-process callbacks see this response. This session
+    // never sends claims or catalog requests to the network.
+    std::ostringstream login;
+    login << R"({"Success":true,"User":)" << std::quoted(credentials_.username)
+          << R"(,"Token":)" << std::quoted(credentials_.token)
+          << R"(,"Score":0,"SoftcoreScore":0,"Messages":0})";
+    client_.Respond(pendingLogin, 200, login.str());
+    return true;
+}
+
+void Session::HandleApi(const Response& response) {
+    const auto context = handshake_.find(response.id);
+    if (context != handshake_.end()) {
+        const auto step = context->second;
+        handshake_.erase(context);
+        const int status = response.status;
+        if (step == Handshake::Login) {
+            const bool temporary = status == RC_API_SERVER_RESPONSE_RETRYABLE_CLIENT_ERROR ||
+                status == 408 || status == 429 || status >= 500;
+            if (temporary && StartOffline(response.id)) {
+                credentials_.token.clear();
+                return;
+            }
+            credentials_.token.clear();
+        } else if (status == 200) {
+            if (step == Handshake::Catalog)
+                received_.catalog = response.body;
+            else
+                received_.unlocks = response.body;
+        }
+    }
+    client_.Respond(response.id, response.status, response.body);
+}
+
+void Session::QueueBadge(std::string_view url, bool priority) {
+    if (offline_)
+        return;
+    const auto name = BadgeName(url);
+    if (name.empty())
+        return;
+    std::error_code error;
+    if (std::filesystem::exists(profile_ / "retroachievements" / "badges" / name, error))
+        return;
+    if (requestedBadges_.emplace(url).second) {
+        if (priority)
+            badgeQueue_.emplace_front(url);
+        else
+            badgeQueue_.emplace_back(url);
+    }
+}
+
+void Session::Dispatch() {
+    auto actions = client_.TakeRequests();
+    for (auto& request : actions) {
+        const auto id = request.id;
+        const std::string_view form = request.data;
+        if (offline_) {
+            if (form.starts_with("r=achievementsets"))
+                client_.Respond(id, 200, offline_->catalog);
+            else if (form.starts_with("r=startsession"))
+                client_.Respond(id, 200, offline_->unlocks);
+            else
+                client_.Respond(id, RC_API_SERVER_RESPONSE_RETRYABLE_CLIENT_ERROR, {});
+            continue;
+        }
+        if (form.starts_with("r=login2"))
+            handshake_.emplace(id, Handshake::Login);
+        else if (form.starts_with("r=achievementsets"))
+            handshake_.emplace(id, Handshake::Catalog);
+        else if (form.starts_with("r=startsession"))
+            handshake_.emplace(id, Handshake::Session);
+        if (!worker_.Submit(std::move(request)))
+            HandleApi({id, RC_API_SERVER_RESPONSE_RETRYABLE_CLIENT_ERROR, {}});
+    }
+    if (!cacheWritten_ && !offline_ && client_.GetState() == State::Ready &&
+        !received_.catalog.empty() && !received_.unlocks.empty()) {
+        cacheWritten_ = SaveOfflineSession(profile_, username_, mediaHash_, received_);
+        received_ = {};
+    }
+
+    const auto status = StateLabel(client_);
+    const auto unlocks = client_.TakeUnlocks();
+    const auto sync = client_.TakeSyncEvents();
+    for (const auto& earned : unlocks) {
+        AddActivity(profile_, "earned", earned.id);
+        QueueBadge(earned.badgeUrl, true);
+        const auto name = BadgeName(earned.badgeUrl);
+        if (popups_.size() < 68)
+            popups_.push_back({earned.title, earned.points, name.empty() ? std::filesystem::path{} :
+                profile_ / "retroachievements" / "badges" / name});
+    }
+    for (const auto& event : sync) {
+        const auto label = event.state == SyncState::Synced ? "synced"
+            : event.state == SyncState::Deferred ? "queued" : "rejected";
+        AddActivity(profile_, label, event.id);
+    }
+    if (status != lastState_ || !unlocks.empty() || !sync.empty()) {
+        Progress view{username_, std::string(status), {}};
+        for (const auto& item : client_.Achievements()) {
+            view.achievements.push_back({item.id,item.points,item.unlocked,item.title,item.description,BadgeName(item.badgeUrl)});
+            QueueBadge(item.badgeUrl, false);
+        }
+        if (view.achievements.empty()) {
+            const auto old = LoadProgress(profile_);
+            if (old && old->username == username_)
+                view.achievements = old->achievements;
+        }
+        SaveProgress(profile_, view);
+        lastState_ = status;
+    }
+    if (actions.empty() && !activeBadgeId_ && !badgeQueue_.empty()) {
+        activeBadge_ = std::move(badgeQueue_.front());
+        badgeQueue_.pop_front();
+        const auto id = ++nextBadgeId_;
+        if (worker_.Submit({id,activeBadge_,{},{}}))
+            activeBadgeId_ = id;
+    }
+}
+
+}
diff --git a/port/ra_host.h b/port/ra_host.h
new file mode 100644
--- /dev/null
+++ b/port/ra_host.h
@@ -0,0 +1,56 @@
+#pragma once
+
+#include "ra_profile.h"
+#include "ra_transport.h"
+
+#include <memory>
+
+namespace port::ra {
+
+struct Notification {
+    std::string title;
+    uint32_t points;
+    std::filesystem::path badge;
+};
+
+class Session {
+public:
+    static std::unique_ptr<Session> Open(const std::filesystem::path& profile,
+                                        std::span<const uint8_t> systemArea, Exchange exchange);
+
+    Session(std::filesystem::path profile, Credentials credentials, std::string_view hash, Exchange exchange);
+    void Frame(std::span<const uint8_t> low, std::span<const uint8_t> high);
+    void Idle();
+    void Reset();
+    const Notification* Popup(uint64_t frame);
+    void PopupShown(uint64_t frame);
+
+private:
+    void Receive();
+    void Dispatch();
+    void HandleApi(const Response& response);
+    bool StartOffline(uint64_t pendingLogin);
+    void QueueBadge(std::string_view url, bool priority);
+
+    std::filesystem::path profile_;
+    Credentials credentials_;
+    std::string username_;
+    std::string mediaHash_;
+    Client client_;
+    RequestWorker worker_;
+    std::deque<std::string> badgeQueue_;
+    std::set<std::string> requestedBadges_;
+    std::string activeBadge_;
+    uint64_t nextBadgeId_ = uint64_t{1} << 63;
+    uint64_t activeBadgeId_ = 0;
+    std::deque<Notification> popups_;
+    uint64_t expiry_ = 0;
+    std::string lastState_;
+    enum class Handshake { Login, Catalog, Session };
+    std::map<uint64_t,Handshake> handshake_;
+    OfflineSession received_;
+    std::optional<OfflineSession> offline_;
+    bool cacheWritten_ = false;
+};
+
+}
diff --git a/launcher/src/ra_launcher.cpp b/launcher/src/ra_launcher.cpp
new file mode 100644
--- /dev/null
+++ b/launcher/src/ra_launcher.cpp
@@ -0,0 +1,159 @@
+#include "ra_launcher.h"
+#include "launcher.h"
+#include "ui.h"
+
+#include "../../port/ra_client.h"
+#include "../../port/ra_profile.h"
+#include "../../port/ra_transport.h"
+
+#include <algorithm>
+#include <array>
+#include <memory>
+#include <string>
+#include <unordered_map>
+
+namespace {
+using namespace port::ra;
+using ui::Font;
+
+struct LoginFlow {
+    const std::filesystem::path profile;
+    Client client;
+    RequestWorker worker;
+    LoginFlow(std::filesystem::path folder, std::string_view username, std::string_view token)
+      : profile(std::move(folder)), worker(WinHttpExchange(SATRECOMP_RA_USER_AGENT)) {
+        client.Login(username, token);
+    }
+};
+
+std::unique_ptr<LoginFlow> login;
+std::string message;
+std::array<char,129> username{};
+std::array<char,513> token{};
+std::unordered_map<std::string,SDL_Texture*> badgeTextures;
+std::filesystem::path badgeProfile;
+SDL_Renderer* badgeRenderer = nullptr;
+
+void PollLogin() {
+    if (!login)
+        return;
+    for (const auto& response : login->worker.TakeResponses())
+        login->client.Respond(response.id, response.status, response.body);
+    for (auto& request : login->client.TakeRequests()) {
+        const auto id = request.id;
+        if (!login->worker.Submit(std::move(request)))
+            login->client.Respond(id, RC_API_SERVER_RESPONSE_CLIENT_ERROR, {});
+    }
+    if (auto account=login->client.AuthenticatedAccount()) {
+        message=SaveCredentials(login->profile,*account) ? "Cuenta conectada" : "No se pudo guardar el token";
+        login.reset();
+    } else if (login->client.GetState()==State::Error || login->client.GetState()==State::SignedOut) {
+        message="No se pudo verificar la cuenta. Revisa la conexión y el token.";
+        login.reset();
+    }
+    if (login)
+        ui::request_frames(2);
+}
+
+std::string Status(std::string_view state) {
+    if(state=="ready") return "Última sesión conectada";
+    if(state=="offline") return "Sin conexión. Los logros pendientes se conservarán.";
+    if(state=="signing_in" || state=="loading") return "Conectando…";
+    if(state=="unsupported_media") return "Disco sin catálogo compatible";
+    if(state=="connection_error") return "No se pudo establecer la sesión";
+    return "Abre el juego para cargar los logros.";
+}
+
+SDL_Texture* Badge(launcher::PageContext& page,std::string_view filename) {
+    if (filename.empty() || ClassifyEndpoint("https://media.retroachievements.org/Badge/"+std::string(filename),false)
+                           != Endpoint::Badge)
+        return nullptr;
+    auto* renderer=SDL_GetRenderer(page.window);
+    if(!renderer)
+        return nullptr;
+    if(badgeRenderer!=renderer || badgeProfile!=page.folder) {
+        if(badgeRenderer==renderer)
+            for(const auto& [name,texture]:badgeTextures) SDL_DestroyTexture(texture);
+        badgeTextures.clear();
+        badgeRenderer=renderer;
+        badgeProfile=page.folder;
+    }
+    const auto found=badgeTextures.find(std::string(filename));
+    if(found!=badgeTextures.end())
+        return found->second;
+    const auto path=(page.folder/"retroachievements"/"badges"/filename).u8string();
+    auto* surface=SDL_LoadPNG(reinterpret_cast<const char*>(path.c_str()));
+    if(!surface)
+        return nullptr;
+    auto* texture=SDL_CreateTextureFromSurface(renderer,surface);
+    SDL_DestroySurface(surface);
+    if(texture)
+        badgeTextures.emplace(filename,texture);
+    return texture;
+}
+}
+
+bool RetroAchievementsBusy() { return bool(login); }
+
+void DrawRetroAchievements(launcher::PageContext& page) {
+    PollLogin();
+    const auto& p = ui::palette();
+    ui::text("RetroAchievements",Font::Semibold,ui::size::kHeading,p.primary);
+    ui::gap(12);
+    const auto account=LoadCredentials(page.folder);
+    if(account) {
+        ui::text(account->username.c_str(),Font::Semibold,ui::size::kLead,p.text);
+        if(ui::button("Cerrar sesión",ui::Kind::Secondary,0.0f,!page.playing && !login)) {
+            message=ForgetCredentials(page.folder) ? "Sesión cerrada" : "No se pudo cerrar la sesión";
+            return;
+        }
+    } else {
+        ui::text("Usuario",Font::Regular,ui::size::kDetail,p.secondary);
+        ImGui::SetNextItemWidth(std::min(page.width,ui::px(360)));
+        ImGui::InputText("##raUser",username.data(),username.size());
+        ui::text("Token",Font::Regular,ui::size::kDetail,p.secondary);
+        ImGui::SetNextItemWidth(std::min(page.width,ui::px(360)));
+        ImGui::InputText("##raToken",token.data(),token.size(),ImGuiInputTextFlags_Password);
+        if(ui::button("Conectar",ui::Kind::Primary,0.0f,!login && !page.playing && username[0] && token[0])) {
+            login=std::make_unique<LoginFlow>(page.folder,username.data(),token.data());
+            for(volatile char& ch:token) ch=0;
+            message="Verificando la cuenta…";
+        }
+    }
+    if(!message.empty())
+        ui::text(message.c_str(),Font::Regular,ui::size::kBody,p.secondary);
+    if(!account)
+        return;
+
+    const auto progress=LoadProgress(page.folder);
+    if(progress && progress->username==account->username) {
+        ui::gap(14);
+        ui::text(Status(progress->state).c_str(),Font::Regular,ui::size::kBody,p.secondary);
+        unsigned count=0, points=0, possible=0;
+        for(const auto& row:progress->achievements) {
+            possible+=row.points;
+            if(row.unlocked) {++count;points+=row.points;}
+        }
+        const auto summary=std::to_string(count)+" de "+std::to_string(progress->achievements.size())+
+            " logros  ·  "+std::to_string(points)+" de "+std::to_string(possible)+" puntos";
+        ui::text(summary.c_str(),Font::Semibold,ui::size::kLead,p.text);
+        for(const auto& row:progress->achievements) {
+            ui::gap(7);
+            if(auto* icon=Badge(page,row.badgeKey)) {
+                ImGui::Image(ImTextureID(reinterpret_cast<uintptr_t>(icon)),ImVec2(ui::px(32),ui::px(32)));
+                ImGui::SameLine();
+            }
+            ImGui::BeginGroup();
+            ui::text(row.title.c_str(),Font::Semibold,ui::size::kBody,p.text,page.width-ui::px(64));
+            const auto caption=std::string(row.unlocked?"Desbloqueado  ·  ":"Bloqueado  ·  ")+std::to_string(row.points)+" puntos";
+            ui::text(caption.c_str(),Font::Regular,ui::size::kDetail,p.secondary);
+            ui::text(row.description.c_str(),Font::Regular,ui::size::kDetail,p.secondary,page.width-ui::px(64));
+            ImGui::EndGroup();
+        }
+    } else {
+        ui::text("Abre el juego para cargar los logros.",Font::Regular,ui::size::kBody,p.secondary);
+    }
+    const auto activity=ReadActivity(page.folder);
+    if(!activity.empty() && ImGui::CollapsingHeader("Actividad de sincronización"))
+        ImGui::TextUnformatted(activity.c_str());
+}
