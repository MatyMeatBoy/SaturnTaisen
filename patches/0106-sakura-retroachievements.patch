new file mode 100644
--- /dev/null
+++ b/port/ra_client.cpp
@@ -0,0 +1,379 @@
+#include "ra_client.h"
+
+#include <md5.h>
+#include <rc_consoles.h>
+#include <rc_api_runtime.h>
+
+#include <algorithm>
+#include <charconv>
+#include <cstring>
+#include <ctime>
+#include <limits>
+#include <stdexcept>
+#include <utility>
+
+namespace port::ra {
+namespace {
+constexpr std::string_view kDisc1Hash = "c4db9d08d56d1fbf78322852775d4818";
+constexpr std::string_view kDisc2Hash = "c306c094d0177459b31f411cd4cd44a9";
+
+Achievement CopyAchievement(const rc_client_achievement_t& source, bool acknowledged = false) {
+    const bool unlocked = acknowledged || source.unlocked != RC_CLIENT_ACHIEVEMENT_UNLOCKED_NONE;
+    char url[512]{};
+    rc_client_achievement_get_image_url(&source, unlocked ? RC_CLIENT_ACHIEVEMENT_STATE_UNLOCKED
+                                                        : RC_CLIENT_ACHIEVEMENT_STATE_ACTIVE,
+                                        url, sizeof(url));
+    return {source.id, source.points, unlocked, source.title ? source.title : "",
+            source.description ? source.description : "", url};
+}
+
+uint32_t AwardId(std::string_view data) {
+    if (!data.starts_with("r=awardachievement&"))
+        return 0;
+    const auto position = data.find("&a=");
+    if (position == data.npos)
+        return 0;
+    const auto rest = data.substr(position + 3);
+    const auto field = rest.substr(0, rest.find('&'));
+    uint32_t id = 0;
+    const auto result = std::from_chars(field.data(), field.data() + field.size(), id);
+    return result.ec == std::errc{} && result.ptr == field.data() + field.size() ? id : 0;
+}
+}
+
+uint32_t ReadSaturnMemory(std::span<const uint8_t> low, std::span<const uint8_t> high,
+                         uint32_t address, std::span<uint8_t> output) {
+    if (low.size() != kBankSize || high.size() != kBankSize || address >= 2*kBankSize || output.empty())
+        return 0;
+
+    size_t written = 0;
+    if (address < kBankSize) {
+        written = std::min(output.size(), size_t(kBankSize - address));
+        std::memcpy(output.data(), low.data() + address, written);
+        if (written == output.size())
+            return static_cast<uint32_t>(written);
+        address = kBankSize;
+    }
+    const auto offset = address - kBankSize;
+    const auto count = std::min(output.size() - written, size_t(kBankSize - offset));
+    std::memcpy(output.data() + written, high.data() + offset, count);
+    return static_cast<uint32_t>(written + count);
+}
+
+bool IsKnownDiscHash(std::string_view hash) {
+    return hash == kDisc1Hash || hash == kDisc2Hash;
+}
+
+std::string SaturnDiscHash(std::span<const uint8_t> firstSector) {
+    constexpr std::string_view magic = "SEGA SEGASATURN ";
+    constexpr int hashLength = 512;
+    if (firstSector.size() < hashLength || !std::equal(magic.begin(), magic.end(), firstSector.begin()))
+        return {};
+
+    md5_state_t state;
+    md5_byte_t digest[16];
+    md5_init(&state);
+    md5_append(&state, firstSector.data(), hashLength);
+    md5_finish(&state, digest);
+    constexpr char hex[] = "0123456789abcdef";
+    std::string hash;
+    hash.reserve(sizeof(digest)*2);
+    for (const auto byte : digest) {
+        hash.push_back(hex[byte >> 4]);
+        hash.push_back(hex[byte & 15]);
+    }
+    return hash;
+}
+
+Client::Client(const std::filesystem::path& profile) {
+    if (!profile.empty())
+        journal_.emplace(profile);
+    client_ = rc_client_create(ReadMemory, Send);
+    if (!client_)
+        throw std::bad_alloc();
+    rc_client_set_userdata(client_, this);
+    rc_client_set_hardcore_enabled(client_, 0);
+    rc_client_set_allow_background_memory_reads(client_, 0);
+    rc_client_set_event_handler(client_, OnEvent);
+}
+
+Client::~Client() {
+    closing_ = true;
+    // Resolve requests before destroying the upstream client and its callback state.
+    while (!completions_.empty())
+        Respond(completions_.begin()->first, 400, R"({"Success":false,"Error":"Session closed."})");
+    rc_client_destroy(client_);
+}
+
+std::optional<Credentials> Client::AuthenticatedAccount() const {
+    const auto* user = rc_client_get_user_info(client_);
+    if (user && user->username && user->token)
+        return Credentials{user->username, user->token};
+    return std::nullopt;
+}
+
+bool Client::Login(std::string_view username, std::string_view token) {
+    if (state_ == State::SigningIn || rc_client_get_user_info(client_) ||
+        username.empty() || username.size()>128 || token.empty() || token.size()>512 ||
+        username.find('\0') != username.npos || token.find('\0') != token.npos)
+        return false;
+    state_ = State::SigningIn;
+    const std::string user(username), secret(token);
+    rc_client_begin_login_with_token(client_, user.c_str(), secret.c_str(), OnLogin, this);
+    return true;
+}
+
+bool Client::SetMedia(std::string_view discHash) {
+    const bool supported = IsKnownDiscHash(discHash);
+    desiredHash_ = supported ? discHash : std::string_view{};
+    if (!supported && state_ != State::SigningIn)
+        state_ = State::UnsupportedMedia;
+    if (supported && !closing_ && rc_client_get_user_info(client_))
+        StartMedia();
+    return supported;
+}
+
+void Client::StartMedia() {
+    if (closing_ || !identifyingHash_.empty())
+        return;
+    if (desiredHash_.empty()) {
+        state_ = State::WaitingForMedia;
+        return;
+    }
+    if (loadedHash_ == desiredHash_) {
+        state_ = State::Ready;
+        ReplayUnsentAwards();
+        return;
+    }
+    state_ = State::Loading;
+    identifyingHash_ = desiredHash_;
+    if (loadedHash_.empty())
+        rc_client_begin_load_game(client_, identifyingHash_.c_str(), OnMedia, this);
+    else
+        rc_client_begin_change_media(client_, identifyingHash_.c_str(), OnMedia, this);
+}
+
+void Client::OnLogin(int result, const char*, rc_client_t*, void* opaque) {
+    auto& self = *static_cast<Client*>(opaque);
+    if (self.closing_)
+        return;
+    if (result == RC_OK)
+        self.StartMedia();
+    else
+        self.state_ = State::Error;
+}
+
+void Client::OnMedia(int result, const char*, rc_client_t* client, void* opaque) {
+    auto& self = *static_cast<Client*>(opaque);
+    const auto identified = std::exchange(self.identifyingHash_, {});
+    if (self.closing_)
+        return;
+    const auto* game = rc_client_get_game_info(client);
+    if (result != RC_OK || !game || game->id != kGameId || game->console_id != RC_CONSOLE_SATURN) {
+        self.loadedHash_.clear();
+        self.state_ = State::Error;
+        return;
+    }
+    self.loadedHash_ = identified;
+    if (self.desiredHash_.empty())
+        self.state_ = State::UnsupportedMedia;
+    else
+        self.StartMedia();
+}
+
+void Client::Evaluate(std::span<const uint8_t> low, std::span<const uint8_t> high) {
+    if (low.size() != kBankSize || high.size() != kBankSize)
+        return;
+    if (state_ != State::Ready && !(state_ == State::Loading && loadedHash_.empty())) {
+        Idle();
+        return;
+    }
+    low_ = low;
+    high_ = high;
+    rc_client_do_frame(client_);
+    low_ = {};
+    high_ = {};
+}
+
+void Client::Idle() {
+    rc_client_idle(client_);
+}
+
+void Client::Reset() {
+    if (state_ == State::Ready)
+        rc_client_reset(client_);
+    unlocks_.clear();
+}
+
+uint32_t Client::ReadMemory(uint32_t address, uint8_t* output, uint32_t count, rc_client_t* client) {
+    auto& self = *static_cast<Client*>(rc_client_get_userdata(client));
+    return ReadSaturnMemory(self.low_, self.high_, address, {output, count});
+}
+
+void Client::Send(const rc_api_request_t* request, rc_client_server_callback_t callback,
+                  void* data, rc_client_t* client) {
+    auto& self = *static_cast<Client*>(rc_client_get_userdata(client));
+    const uint64_t id = ++self.nextRequest_;
+    self.completions_.emplace(id, Completion{callback, data, std::nullopt});
+    if (!self.closing_) {
+        self.requests_.push_back({id, request->url, request->post_data ? request->post_data : "",
+                                  request->content_type ? request->content_type : ""});
+    }
+}
+
+std::vector<Request> Client::TakeRequests() {
+    auto requests = std::exchange(requests_, {});
+    if (!journal_)
+        return requests;
+
+    std::vector<Request> ready;
+    for (auto& request : requests) {
+        const auto id = AwardId(request.data);
+        if (!id) {
+            if (request.data.starts_with("r=awardachievement"))
+                Respond(request.id, 400, R"({"Success":false,"Error":"Invalid award."})");
+            else
+                ready.push_back(std::move(request));
+            continue;
+        }
+
+        auto& completion = completions_.at(request.id);
+        if (!completion.award) {
+            const auto* user = rc_client_get_user_info(client_);
+            if (user) {
+                const auto pending = journal_->Pending(user->username);
+                const auto record = std::ranges::find(pending, id, &PendingAward::achievement);
+                if (record != pending.end())
+                    completion.award = *record;
+            }
+        }
+        if (completion.award && !acknowledgedAwards_.contains(id))
+            ready.push_back(std::move(request));
+        else
+            Respond(request.id, 400, R"({"Success":false,"Error":"Award not pending."})");
+    }
+    return ready;
+}
+
+bool Client::Respond(uint64_t id, int status, std::string_view body) {
+    const auto found = completions_.find(id);
+    if (found == completions_.end())
+        return false;
+    const auto completion = found->second;
+    completions_.erase(found);
+    const std::string terminated(body);
+    const rc_api_server_response_t response{terminated.c_str(), terminated.size(), status};
+    if (completion.award && !closing_) {
+        const bool synced = AcceptAward(*completion.award, response);
+        const bool temporary = status == RC_API_SERVER_RESPONSE_RETRYABLE_CLIENT_ERROR ||
+            status == 408 || status == 429 || status >= 500;
+        syncEvents_.push_back({completion.award->achievement,
+            synced ? SyncState::Synced : temporary ? SyncState::Deferred : SyncState::Rejected});
+    }
+    if (completion.callback)
+        completion.callback(&response, completion.data);
+    return true;
+}
+
+void Client::OnEvent(const rc_client_event_t* event, rc_client_t* client) {
+    auto& self = *static_cast<Client*>(rc_client_get_userdata(client));
+    if (event->type == RC_CLIENT_EVENT_DISCONNECTED)
+        self.disconnected_ = true;
+    else if (event->type == RC_CLIENT_EVENT_RECONNECTED)
+        self.disconnected_ = false;
+    if (self.state_ != State::Ready || event->type != RC_CLIENT_EVENT_ACHIEVEMENT_TRIGGERED || !event->achievement)
+        return;
+    const auto& achievement = *event->achievement;
+    if (self.acknowledgedAwards_.contains(achievement.id))
+        return;
+    if (self.journal_ && achievement.category == RC_CLIENT_ACHIEVEMENT_CATEGORY_CORE) {
+        const auto* user = rc_client_get_user_info(client);
+        if (user)
+            self.journal_->Enqueue({user->username, self.loadedHash_, kGameId, achievement.id, achievement.unlock_time});
+    }
+    self.unlocks_.push_back(CopyAchievement(achievement));
+}
+
+std::vector<Achievement> Client::Achievements() const {
+    if (state_ != State::Ready)
+        return {};
+    std::vector<Achievement> output;
+    auto* list = rc_client_create_achievement_list(client_, RC_CLIENT_ACHIEVEMENT_CATEGORY_CORE,
+                                                    RC_CLIENT_ACHIEVEMENT_LIST_GROUPING_LOCK_STATE);
+    if (!list)
+        return output;
+    for (uint32_t index = 0; index < list->num_buckets; ++index) {
+        const auto& bucket = list->buckets[index];
+        for (uint32_t achievement = 0; achievement < bucket.num_achievements; ++achievement)
+            output.push_back(CopyAchievement(*bucket.achievements[achievement],
+                acknowledgedAwards_.contains(bucket.achievements[achievement]->id)));
+    }
+    rc_client_destroy_achievement_list(list);
+    return output;
+}
+
+void Client::ReplayUnsentAwards() {
+    if (!journal_ || replayQueued_ || offline_)
+        return;
+    const auto* user = rc_client_get_user_info(client_);
+    if (!user)
+        return;
+    replayQueued_ = true;
+
+    const auto now = std::time(nullptr);
+    for (const auto& award : journal_->Pending(user->username)) {
+        const auto* achievement = rc_client_get_achievement_info(client_, award.achievement);
+        if (!achievement || achievement->category != RC_CLIENT_ACHIEVEMENT_CATEGORY_CORE || award.earnedAt > now)
+            continue;
+        if (achievement->unlocked != RC_CLIENT_ACHIEVEMENT_UNLOCKED_NONE) {
+            journal_->Acknowledge(award);
+            continue;
+        }
+        // Use the original game hash and earning time with the current verified login token.
+        const auto age = std::min<uint64_t>(now - award.earnedAt, std::numeric_limits<uint32_t>::max());
+        const rc_api_award_achievement_request_t params{
+            user->username, user->token, award.achievement, 0, award.hash.c_str(), static_cast<uint32_t>(age)
+        };
+        rc_api_request_t request{};
+        if (rc_api_init_award_achievement_request(&request, &params) == RC_OK) {
+            const auto id = ++nextRequest_;
+            completions_.emplace(id, Completion{nullptr, nullptr, award});
+            requests_.push_back({id, request.url, request.post_data, request.content_type});
+        }
+        rc_api_destroy_request(&request);
+    }
+}
+
+bool Client::AcceptAward(const PendingAward& award, const rc_api_server_response_t& response) {
+    if (!journal_ || response.http_status_code < 200 || response.http_status_code >= 300)
+        return false;
+
+    rc_api_award_achievement_response_t parsed{};
+    const auto status = rc_api_process_award_achievement_server_response(&parsed, &response);
+    const bool confirmed = status == RC_OK && parsed.response.succeeded &&
+        parsed.awarded_achievement_id == award.achievement;
+    rc_api_destroy_award_achievement_response(&parsed);
+    if (!confirmed)
+        return false;
+
+    acknowledgedAwards_.insert(award.achievement);
+    journal_->Acknowledge(award);
+    return true;
+}
+
+void Client::SetOfflineProgress(const Progress& progress) {
+    offline_ = true;
+    for (const auto& row : progress.achievements)
+        if (row.unlocked)
+            acknowledgedAwards_.insert(row.id);
+}
+
+std::vector<SyncEvent> Client::TakeSyncEvents() {
+    return std::exchange(syncEvents_, {});
+}
+
+std::vector<Achievement> Client::TakeUnlocks() {
+    return std::exchange(unlocks_, {});
+}
+
+}
diff --git a/port/ra_client.h b/port/ra_client.h
new file mode 100644
--- /dev/null
+++ b/port/ra_client.h
@@ -0,0 +1,111 @@
+#pragma once
+
+#include "ra_journal.h"
+#include "ra_profile.h"
+
+#include <rc_client.h>
+
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <set>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace port::ra {
+
+inline constexpr uint32_t kBankSize = 0x100000;
+inline constexpr uint32_t kGameId = 16546;
+
+uint32_t ReadSaturnMemory(std::span<const uint8_t> low, std::span<const uint8_t> high,
+                         uint32_t address, std::span<uint8_t> output);
+bool IsKnownDiscHash(std::string_view hash);
+std::string SaturnDiscHash(std::span<const uint8_t> firstSector);
+
+enum class State { SignedOut, SigningIn, WaitingForMedia, Loading, Ready, UnsupportedMedia, Error };
+
+struct Request {
+    uint64_t id;
+    std::string url;
+    std::string data;
+    std::string contentType;
+};
+
+enum class SyncState { Synced, Deferred, Rejected };
+struct SyncEvent { uint32_t id; SyncState state; };
+
+struct Achievement {
+    uint32_t id;
+    uint32_t points;
+    bool unlocked;
+    std::string title;
+    std::string description;
+    std::string badgeUrl;
+};
+
+// The owner calls all methods on the emulation thread. The transport receives
+// independent request values and returns the responses by ID.
+class Client {
+public:
+    explicit Client(const std::filesystem::path& profile = {});
+    ~Client();
+    Client(const Client&) = delete;
+    Client& operator=(const Client&) = delete;
+
+    std::optional<Credentials> AuthenticatedAccount() const;
+    State GetState() const { return state_; }
+    bool Login(std::string_view username, std::string_view token);
+    bool SetMedia(std::string_view discHash);
+    void Evaluate(std::span<const uint8_t> low, std::span<const uint8_t> high);
+    void Idle();
+    void Reset();
+
+    std::vector<Request> TakeRequests();
+    bool Respond(uint64_t id, int status, std::string_view body);
+    std::vector<Achievement> Achievements() const;
+    std::vector<Achievement> TakeUnlocks();
+    std::vector<SyncEvent> TakeSyncEvents();
+    bool Disconnected() const { return offline_ || disconnected_; }
+    void SetOfflineProgress(const Progress& progress);
+
+private:
+    struct Completion {
+        rc_client_server_callback_t callback;
+        void* data;
+        std::optional<PendingAward> award;
+    };
+
+    static uint32_t ReadMemory(uint32_t address, uint8_t* output, uint32_t count, rc_client_t* client);
+    static void Send(const rc_api_request_t* request, rc_client_server_callback_t callback,
+                     void* data, rc_client_t* client);
+    static void OnLogin(int result, const char*, rc_client_t*, void* self);
+    static void OnMedia(int result, const char*, rc_client_t*, void* self);
+    static void OnEvent(const rc_client_event_t* event, rc_client_t* client);
+
+    void StartMedia();
+    void ReplayUnsentAwards();
+    bool AcceptAward(const PendingAward& award, const rc_api_server_response_t& response);
+
+    rc_client_t* client_ = nullptr;
+    State state_ = State::SignedOut;
+    std::string desiredHash_;
+    std::string loadedHash_;
+    std::string identifyingHash_;
+    std::span<const uint8_t> low_;
+    std::span<const uint8_t> high_;
+    uint64_t nextRequest_ = 0;
+    std::vector<Request> requests_;
+    std::map<uint64_t, Completion> completions_;
+    std::vector<Achievement> unlocks_;
+    std::vector<SyncEvent> syncEvents_;
+    bool offline_ = false;
+    bool disconnected_ = false;
+    std::optional<AwardJournal> journal_;
+    std::set<uint32_t> acknowledgedAwards_;
+    bool replayQueued_ = false;
+    bool closing_ = false;
+};
+
+}
diff --git a/port/ra_journal.cpp b/port/ra_journal.cpp
new file mode 100644
--- /dev/null
+++ b/port/ra_journal.cpp
@@ -0,0 +1,136 @@
+#include "ra_journal.h"
+
+#include "ra_client.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <fstream>
+#include <optional>
+#include <system_error>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#endif
+
+namespace port::ra {
+namespace {
+namespace fs = std::filesystem;
+
+std::string AccountKey(std::string_view username) {
+    if (username.empty() || username.size() > 128)
+        return {};
+
+    std::string result;
+    for (unsigned char ch : username) {
+        if (ch >= 'A' && ch <= 'Z')
+            ch += 'a' - 'A';
+        if ((ch < 'a' || ch > 'z') && (ch < '0' || ch > '9') && ch != '_' && ch != '-')
+            return {};
+        result.push_back(static_cast<char>(ch));
+    }
+    return result;
+}
+
+bool Valid(const PendingAward& award) {
+    return award.game == kGameId && award.achievement != 0 && award.earnedAt > 0 &&
+        !AccountKey(award.username).empty() && IsKnownDiscHash(award.hash);
+}
+
+std::optional<PendingAward> Read(const fs::path& path) {
+    std::error_code error;
+    if (fs::file_size(path, error) > 512 || error)
+        return std::nullopt;
+
+    std::ifstream stream(path);
+    std::string schema;
+    PendingAward item;
+    if (!(stream >> schema >> item.username >> item.hash >> item.game >> item.achievement >> item.earnedAt) ||
+        schema != "SATURN-RA-AWARD-1" || !Valid(item))
+        return std::nullopt;
+    stream >> std::ws;
+    if (!stream.eof())
+        return std::nullopt;
+    return item;
+}
+
+bool Publish(const fs::path& temporary, const fs::path& final) {
+#ifdef _WIN32
+    return MoveFileExW(temporary.c_str(), final.c_str(), MOVEFILE_WRITE_THROUGH) != 0;
+#else
+    std::error_code error;
+    fs::create_hard_link(temporary, final, error);
+    return !error;
+#endif
+}
+}
+
+AwardJournal::AwardJournal(const fs::path& profile) : folder_(profile / "retroachievements" / "pending") {}
+
+std::filesystem::path AwardJournal::PathFor(const PendingAward& award) const {
+    return (folder_ / ("user-" + AccountKey(award.username))) / (std::to_string(award.achievement) + ".award");
+}
+
+bool AwardJournal::Enqueue(const PendingAward& award) const {
+    if (!Valid(award))
+        return false;
+    const auto final = PathFor(award);
+    const auto matches = [&] {
+        const auto existing = Read(final);
+        return existing && AccountKey(existing->username) == AccountKey(award.username) &&
+            existing->game == award.game && existing->achievement == award.achievement;
+    };
+    if (matches())
+        return true;
+
+    std::error_code error;
+    fs::create_directories(final.parent_path(), error);
+    if (error)
+        return false;
+
+    static std::atomic<uint64_t> sequence = 0;
+    const auto tick = std::chrono::steady_clock::now().time_since_epoch().count();
+    auto temporary = final;
+    temporary += ".tmp-" + std::to_string(tick) + "-" + std::to_string(++sequence);
+    std::ofstream stream(temporary, std::ios::trunc);
+    stream << "SATURN-RA-AWARD-1\n" << award.username << '\n' << award.hash << '\n'
+           << award.game << '\n' << award.achievement << '\n' << award.earnedAt << '\n';
+    stream.close();
+    const bool published = stream && Publish(temporary, final);
+    fs::remove(temporary, error);
+    return published || matches();
+}
+
+std::vector<PendingAward> AwardJournal::Pending(std::string_view username) const {
+    std::vector<PendingAward> result;
+    const auto account = AccountKey(username);
+    if (account.empty())
+        return result;
+
+    std::error_code error;
+    for (fs::directory_iterator it(folder_ / ("user-" + account), error), end; !error && it != end; it.increment(error)) {
+        const auto path = it->path();
+        if (path.extension() != ".award")
+            continue;
+        auto item = Read(path);
+        if (item && AccountKey(item->username) == account && PathFor(*item) == path)
+            result.push_back(std::move(*item));
+    }
+    std::ranges::sort(result, {}, &PendingAward::earnedAt);
+    return result;
+}
+
+bool AwardJournal::Acknowledge(const PendingAward& award) const {
+    if (!Valid(award))
+        return false;
+    const auto path = PathFor(award);
+    const auto prior = Read(path);
+    if (!prior || *prior != award)
+        return false;
+    std::error_code error;
+    return fs::remove(path, error) && !error;
+}
+
+}
