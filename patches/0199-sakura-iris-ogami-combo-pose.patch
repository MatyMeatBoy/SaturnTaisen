+    bool CaptureIrisComboPose(std::vector<uint32>& pixels) const {
+        const auto& bg = m_regs2.bgParams[4];
+        if (m_width != 320 || m_height != 224 || m_regs2.TVMD.IsInterlaced() ||
+            bg.pageBaseAddresses[0] != 0x66000 || bg.scrollAmountH != 0 ||
+            bg.scrollAmountV != 0x10000 || bg.cramOffset != 0 ||
+            !BackgroundIsOpaque(5) || BackgroundPaletteFingerprint(5) != 0xF6B278DAC83BC233ull)
+            return false;
+
+        // NBG3's second combo pose starts 32 tile rows into the page.
+        constexpr uint32 names = 0x67000, cells = 0x68000;
+        const auto fingerprint = [&](uint32 start, uint32 end) {
+            uint64_t hash = 14695981039346656037ull;
+            for (uint32 pos = start; pos < end; ++pos)
+                hash = (hash ^ m_mem.vram2[pos]) * 1099511628211ull;
+            return hash;
+        };
+        if (fingerprint(names, 0x67E00) != 0xE6518322FD6A1595ull ||
+            fingerprint(cells, 0x78A00) != 0xC2EC39C65FB06018ull)
+            return false;
+
+        if (pixels.empty()) {
+            pixels.resize(320 * 224);
+            for (uint32 y = 0; y < 224; ++y) {
+                for (uint32 x = 0; x < 320; ++x) {
+                    const uint32 name = Vram2Word(names + 2 * ((y / 8) * 64 + x / 8));
+                    const uint32 cell = 0x3000 | (name & 0xFFF);
+                    const uint32 dot = m_mem.vram2[cell * 32 + (y % 8) * 8 + x % 8];
+                    if (dot) {
+                        const uint32 palette = (name >> 12) & 7;
+                        const uint16 color = CramWord(2 * (palette * 256 + dot));
+                        pixels[y * 320 + x] = 0xFF000000u | (uint32(color & 31) << 3) |
+                            (uint32(color & 0x3E0) << 6) | (uint32(color & 0x7C00) << 9);
+                    }
+                }
+            }
+        }
+        return true;
     }
