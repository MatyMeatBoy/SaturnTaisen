diff --git a/port/background_workers.h b/port/background_workers.h
new file mode 100644
index 0000000..0cbdc79
--- /dev/null
+++ b/port/background_workers.h
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <algorithm>
+#include <atomic>
+#include <charconv>
+#include <cstdlib>
+#include <functional>
+#include <system_error>
+#include <string_view>
+#include <thread>
+#include <vector>
+namespace port {
+inline unsigned BackgroundWorkerCount(bool offline,unsigned hardware=std::thread::hardware_concurrency()) {
+    const unsigned fallback=offline?std::clamp(hardware,1u,8u):std::clamp(hardware/4,1u,4u);
+    const char* value=std::getenv("SATRECOMP_BACKGROUND_WORKERS");if(!value)return fallback;
+    const std::string_view text(value);unsigned count=0;
+    const auto result=std::from_chars(text.data(),text.data()+text.size(),count);
+    return result.ec==std::errc{} && result.ptr==text.data()+text.size() && count<=8?count:fallback;
+}
+// Owns CPU-only preparation jobs. Never accepts a renderer, texture or guest state.
+// Start/Wait/Cancel/destruction are called by the owner thread. Jobs own their inputs.
+class BackgroundWorkers {
+public:
+    using Job=std::function<bool()>;
+    static unsigned Bound(unsigned requested,size_t jobs) {
+        return static_cast<unsigned>(std::min({size_t(requested),jobs,size_t(8)}));
+    }
+    ~BackgroundWorkers() {Cancel();Wait();}
+    void Start(std::vector<Job> jobs,unsigned count) {
+        Cancel();Wait();jobs_=std::move(jobs);next_=0;completed_=0;failed_=0;cancel_=false;
+        count=Bound(count,jobs_.size());threads_.reserve(count);
+        for(unsigned i=0;i<count;i++) {
+            try {threads_.emplace_back([this] {
+                while(!cancel_.load(std::memory_order_acquire)) {
+                    const size_t i=next_.fetch_add(1,std::memory_order_relaxed);
+                    if(i>=jobs_.size() || cancel_.load(std::memory_order_acquire))break;
+                    bool ok=false;try {ok=jobs_[i]();} catch(...) { /* optional enhancement falls back */ }
+                    if(!ok)failed_.fetch_add(1,std::memory_order_relaxed);
+                    completed_.fetch_add(1,std::memory_order_release);
+                }
+            });} catch(const std::system_error&) {break;} // fewer workers; synchronous loader remains usable
+        }
+    }
+    void Cancel() {cancel_.store(true,std::memory_order_release);}
+    void Wait() {
+        for(auto& thread:threads_)if(thread.joinable())thread.join();
+        threads_.clear();jobs_.clear();
+    }
+    unsigned Completed() const {return completed_.load(std::memory_order_acquire);}
+    unsigned Failed() const {return failed_.load(std::memory_order_relaxed);}
+private:
+    std::vector<Job> jobs_;std::vector<std::thread> threads_;
+    std::atomic<size_t> next_{0};std::atomic<unsigned> completed_{0},failed_{0};
+    std::atomic<bool> cancel_{false};
+};
+}
