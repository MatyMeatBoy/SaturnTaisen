diff --git a/port/dialogue_reveal.h b/port/dialogue_reveal.h
new file mode 100644
index 0000000..98df77e
--- /dev/null
+++ b/port/dialogue_reveal.h
@@ -0,0 +1,64 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+#include "dialogue_preload.h"
+
+#include <map>
+#include <optional>
+#include <string_view>
+
+namespace port {
+
+struct PreloadedNarrativeRow {
+    int x;
+    std::u32string_view text; // Borrowed from the sealed catalogue owning the record.
+};
+
+inline const PreloadedDialogueLine* PreloadedNarrativeLine(const PreloadedDialogueRecord& record, int y) {
+    if (!record.simple || y < 160 || y > 196 || (y - 160) % 12) return nullptr;
+    const size_t index = static_cast<size_t>((y - 160) / 12);
+    if (index >= record.lineCount) return nullptr;
+    return &record.lines[index];
+}
+
+inline std::optional<size_t> PreloadedNarrativeColumn(int x, size_t lineLength) {
+    // Native command origin; the ink clip starts at 56 and is a separate guard.
+    if (x < 64 || x > 304 || (x - 64) % 8) return std::nullopt;
+    const size_t column = static_cast<size_t>((x - 64) / 8);
+    if (column >= lineLength) return std::nullopt;
+    return column;
+}
+
+inline std::optional<PreloadedNarrativeRow> MatchPreloadedNarrativeRow(
+        const PreloadedDialogueRecord& record, int y, const std::map<int,char32_t>& cells) {
+    const auto* line = PreloadedNarrativeLine(record, y);
+    if (!line || cells.empty()) return std::nullopt;
+    size_t next = 0;
+    for (const auto& [x, character] : cells) {
+        const auto column = PreloadedNarrativeColumn(x, line->text.size());
+        if (!column || character != line->text[*column]) return std::nullopt;
+        for (; next < *column; ++next)
+            if (line->text[next] != U' ') return std::nullopt;
+        next = *column + 1;
+    }
+    const int firstX = cells.begin()->first;
+    const size_t firstColumn = static_cast<size_t>((firstX - 64) / 8);
+    return PreloadedNarrativeRow{firstX, std::u32string_view(line->text).substr(firstColumn, next - firstColumn)};
+}
+
+// Resolve only a tile already observed at this position in the displayed frame.
+inline char32_t ExpectedPreloadedNarrativeGlyph(const PreloadedDialogueRecord& record, int x, int y,
+        std::span<const uint8_t> atlas, std::span<const uint8_t> tile) {
+    if (atlas.size() != 32768 || tile.size() != 128) return 0;
+    const auto* line = PreloadedNarrativeLine(record, y);
+    if (!line) return 0;
+    const auto column = PreloadedNarrativeColumn(x, line->text.size());
+    if (!column || line->rawOffset > record.raw.size() || *column >= record.raw.size() - line->rawOffset) return 0;
+    const auto byte = static_cast<uint8_t>(record.raw[line->rawOffset + *column]);
+    const char32_t character = GlyphCodepoint(byte);
+    if (!character || character != line->text[*column]) return 0;
+    const size_t atlasOffset = static_cast<size_t>(byte - 1) * tile.size();
+    return std::memcmp(atlas.data() + atlasOffset, tile.data(), tile.size()) == 0 ? character : 0;
+}
+
+} // namespace port
