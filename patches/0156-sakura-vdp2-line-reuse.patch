+// (the check: the line just composed against the kept one)
+bool Renderer::ReuseCompareLine(uint32 y) {
+    LineReuse &R = m_reuse;
+    const size_t width = m_width, at = static_cast<size_t>(y) * width;
+    bool same = std::memcmp(&m_framebuffer[at], &R.pixels[at], width * 4) == 0;
+    if (R.capture) {
+        const Presentation &p = m_presentation;
+        same = same && std::memcmp(&p.foreground[at], &R.foreground[at], width * 4) == 0 &&
+               std::memcmp(&p.underSprites[at], &R.underSprites[at], width * 4) == 0 &&
+               std::memcmp(&p.source[at], &R.source[at], width) == 0 && std::memcmp(&p.topSource[at], &R.topSource[at], width) == 0 &&
+               std::memcmp(&p.underSource[at], &R.underSource[at], width) == 0;
+        if (!R.white.empty()) {
+            same = same && std::memcmp(&p.spriteWhiteWeight[at], &R.white[at], width) == 0;
+        }
+        if (!R.panelMix.empty()) {
+            const bool kept = R.panelRow[y];
+            const ::port::PanelMix none{};
+            for (size_t x = 0; x < width && same; x++) {
+                same = SameMix(p.panelMix[at + x], kept ? R.panelMix[at + x] : none) &&
+                       SameMix(p.underPanelMix[at + x], kept ? R.underPanelMix[at + x] : none) &&
+                       SameMix(p.floralCoverMix[at + x], kept ? R.floralCoverMix[at + x] : none);
+            }
+        }
+    }
+    if (R.capture && !R.glyph.empty()) {
+        const Presentation &p = m_presentation;
+        const GlyphPlatePixel none{};
+        const bool kept = R.glyphRow[y];
+        for (size_t x = 0; x < width && same; x++) {
+            const GlyphPlatePixel &a = p.glyphPlate[at + x], &b = kept ? R.glyph[at + x] : none;
+            same = a.nativeRgb == b.nativeRgb && a.foregroundRgba == b.foregroundRgba && a.owner == b.owner &&
+                   a.underOwner == b.underOwner && SameMix(a.panelMix, b.panelMix);
+        }
+    }
+    if (same && R.capture && !R.mapFadeEdges.empty()) {
+        const size_t start = static_cast<size_t>(y) * 32;
+        for (size_t x = start; x < start + 32 && same; ++x) {
+            const auto &current = m_presentation.mapFadeEdges[x], &kept = R.mapFadeEdges[x];
+            same = current.mapRgb == kept.mapRgb && current.mix == kept.mix;
+        }
+    }
+    if (!same) {
+        fprintf(stderr, "video: reuse check: line %u differs from the kept one\n", y);
+    }
+    return same;
 }
 
