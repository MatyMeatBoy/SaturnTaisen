+// --- reuse of unchanged VDP2 lines (T116) ---
+
+bool Renderer::ReuseEligible() const {
+    // SATRECOMP_VDP2_LINE_REUSE: 0 turns the reuse off, "check" composes every line and compares it with the kept one
+    static const char *setting = getenv("SATRECOMP_VDP2_LINE_REUSE");
+    static const bool off = setting && setting[0] == '0';
+    static const bool probing = getenv("SATRECOMP_LAYER_PROBE") != nullptr;
+    return m_reuseOn && !off && !probing && m_compose && !m_gpu && !m_check && m_regs2.displayEnabledLatch &&
+           !(m_capturePresentation && m_presentation.scrollWidth) && !m_regs2.TVMD.IsInterlaced() &&
+           !m_regs2.bgEnabled[4] && !m_regs2.bgEnabled[5] && m_width <= 704 && m_height <= 512;
+}
+
+// Lines that follow an item card or a menu's arrows from line to line (state kept between lines, and a drawn capture that
+// changes every frame without the counter moving): always composed, never kept
+bool Renderer::ReuseVolatileLine(uint32 y) const {
+    if (m_captureBrackets && m_drawnBrackets[m_displayFB].serial != 0 && y + 1 > static_cast<uint32>(system_hud::kY) &&
+        y < static_cast<uint32>(system_hud::kY + system_hud::kHeight)) {
+        return true;
+    }
+    const auto &item = m_drawnItemCard[m_displayFB];
+    return m_captureItemCards && item && static_cast<sint32>(y) >= item->y &&
+           static_cast<sint32>(y) < item->y + std::max<sint32>(kItemCardSize, ::port::kLoadDiscIconSize);
+}
+
+// At the frame's first line (the VDP1 framebuffers have been swapped by now): decide what the frame's lines do
+void Renderer::ReuseFrameStart() {
+    LineReuse &R = m_reuse;
+    R.pending = false;
+    R.mode = LineReuse::Off;
+    R.frames++;
+    if (!ReuseEligible()) {
+        R.ineligible++;
+        R.valid = false;
+        R.lastFirstGen = 0;
+        return;
+    }
+    // What changes without a write the machine tells about: the displayed framebuffer and the VDP1 registers
+    // (neither changes while the picture's lines are made)
+    if (R.fbSnap.size() != 0x40000) {
+        R.fbSnap.assign(0x40000, 0);
+        R.valid = false;
+        m_stateGen++;
+    }
+    if (std::memcmp(R.fbSnap.data(), m_mem.fb[m_displayFB], 0x40000) != 0) {
+        std::memcpy(R.fbSnap.data(), m_mem.fb[m_displayFB], 0x40000);
+        m_stateGen++;
+    }
+    if (!R.regs1SnapValid || std::memcmp(R.regs1Snap, &m_regs1, sizeof R.regs1Snap) != 0) {
+        std::memcpy(R.regs1Snap, &m_regs1, sizeof R.regs1Snap);
+        R.regs1SnapValid = true;
+        m_stateGen++;
+    }
+    {
+        // (the host's glyph stamps of the displayed framebuffer feed PrepareGlyphLine)
+        const bool ready = m_glyphPlateReady[m_displayFB];
+        const auto &stamps = m_glyphStamps[m_displayFB];
+        const bool same = ready == R.glyphReadySnap &&
+                          (!ready || (stamps.size() == R.stampSnap.size() &&
+                                      (stamps.empty() || std::memcmp(stamps.data(), R.stampSnap.data(), stamps.size() * sizeof(GlyphPlateStamp)) == 0)));
+        if (!same) {
+            R.glyphReadySnap = ready;
+            if (ready) {
+                R.stampSnap = stamps;
+            }
+            m_stateGen++;
+        }
+    }
+    if (R.width != m_width || R.height != m_height || R.capture != m_capturePresentation ||
+        (R.capture && (R.glyph.size() != m_presentation.glyphPlate.size() ||
+                       R.white.size() != m_presentation.spriteWhiteWeight.size()))) {
+        R.valid = false;
+    }
+    R.frameGen = m_stateGen;
+    const bool stable = R.lastFirstGen == m_stateGen; // (nothing changed since the last frame's first line)
+    R.lastFirstGen = m_stateGen;
+    if (R.valid && R.cacheGen == m_stateGen) {
+        R.mode = LineReuse::Reuse;
+        R.reuseFrames++;
+        return;
+    }
+    R.valid = false;
+    if (!stable) {
+        R.unstable++;
+        return;
+    }
+    R.buildFrames++;
+    // A second frame in a row with nothing changed: keep its lines for the next
+    const size_t pixels = static_cast<size_t>(m_width) * m_height;
+    R.width = m_width;
+    R.height = m_height;
+    R.capture = m_capturePresentation;
+    R.cacheGen = m_stateGen;
+    R.lineOk.assign(m_height, 0);
+    R.layerMask.assign(m_height, 0);
+    R.panelRow.assign(m_height, 0);
+    R.pixels.resize(pixels);
+    if (R.capture) {
+        R.foreground.resize(m_presentation.foreground.size());
+        R.underSprites.resize(m_presentation.underSprites.size());
+        R.source.resize(m_presentation.source.size());
+        R.topSource.resize(m_presentation.topSource.size());
+        R.underSource.resize(m_presentation.underSource.size());
+        R.white.resize(m_presentation.spriteWhiteWeight.size());
+        R.panelMix.resize(m_presentation.panelMix.size());
+        R.underPanelMix.resize(m_presentation.underPanelMix.size());
+        R.floralCoverMix.resize(m_presentation.floralCoverMix.size());
+        R.mapFadeEdges.resize(m_presentation.mapFadeEdges.size());
+        R.glyph.resize(m_presentation.glyphPlate.size());
+        R.glyphRow.assign(m_height, 0);
+    }
+    R.mode = LineReuse::Build;
+}
+
+void Renderer::ReuseFrameEnd() {
+    LineReuse &R = m_reuse;
+    if (R.mode == LineReuse::Build && m_stateGen == R.frameGen) {
+        R.valid = true;
+    } else if (R.mode == LineReuse::Off) {
+        R.valid = R.valid && R.cacheGen == m_stateGen;
+    }
+}
+
+namespace {
+    bool IsDefaultMix(const ::port::PanelMix &m) {
+        return m.topRgb == 0 && m.lowerWeight == 0 && m.postMixOffset[0] == 0 && m.postMixOffset[1] == 0 && m.postMixOffset[2] == 0;
+    }
+    bool SameMix(const ::port::PanelMix &a, const ::port::PanelMix &b) {
+        return a.topRgb == b.topRgb && a.lowerWeight == b.lowerWeight && a.postMixOffset == b.postMixOffset;
+    }
+}
+
+void Renderer::ComposeLineReusing(uint32 y) {
+    LineReuse &R = m_reuse;
+    if (m_stateGen != R.frameGen || y >= m_height) {
+        // Something changed in the middle of the frame: this frame goes on without the reuse and keeps nothing
+        R.mode = LineReuse::Off;
+        R.valid = false;
+        R.midChange++;
+        ComposeLine(y);
+        return;
+    }
+    static const char *setting = getenv("SATRECOMP_VDP2_LINE_REUSE");
+    static const bool check = setting && std::strcmp(setting, "check") == 0;
+    if (ReuseVolatileLine(y)) {
+        ComposeLine(y);
+        return;
+    }
+    if (R.mode == LineReuse::Reuse) {
+        R.lines++;
+        if (R.lineOk[y]) {
+            if (!check) {
+                ReuseReplayLine(y);
+                R.replayed++;
+                return;
+            }
+            ComposeLine(y);
+            if (!ReuseCompareLine(y)) {
+                R.mismatches++;
+            }
+            R.replayed++;
+            return;
+        }
+        ComposeLine(y);
+        return;
+    }
+    // Build: compose, and keep the line if nothing in it depends on what the frame did before
+    uint64_t statsBefore = m_linesLeftToReference + m_spriteLinesLeftToReference;
+    for (uint32 i = 0; i < 7; i++) {
+        statsBefore += m_approximateLines[i];
+    }
+    uint64_t layerBefore[6];
+    for (uint32 i = 0; i < 6; i++) {
+        layerBefore[i] = m_layerLines[i];
+        statsBefore += m_layerLinesLeftToReference[i];
+    }
+    const uint32 samplesBefore = m_presentation.episodeBlendSamples;
+    ComposeLine(y);
+    uint64_t statsAfter = m_linesLeftToReference + m_spriteLinesLeftToReference;
+    for (uint32 i = 0; i < 7; i++) {
+        statsAfter += m_approximateLines[i];
+    }
+    uint8 mask = 0;
+    for (uint32 i = 0; i < 6; i++) {
+        statsAfter += m_layerLinesLeftToReference[i];
+        mask |= static_cast<uint8>((m_layerLines[i] != layerBefore[i]) << i);
+    }
+    ReuseStoreLine(y, statsAfter == statsBefore && m_presentation.episodeBlendSamples == samplesBefore, mask);
+}
+
+void Renderer::ReuseStoreLine(uint32 y, bool cacheable, uint8 layerMask) {
+    LineReuse &R = m_reuse;
+    if (!cacheable) {
+        return;
+    }
+    const size_t width = m_width, at = static_cast<size_t>(y) * width;
+    if (R.capture) {
+        const Presentation &p = m_presentation;
+        if (p.source.size() != R.source.size() || p.foreground.size() != R.foreground.size()) {
+            return; // (the planes are not what this frame's start saw: keep nothing of the line)
+        }
+        std::memcpy(&R.foreground[at], &p.foreground[at], width * 4);
+        std::memcpy(&R.underSprites[at], &p.underSprites[at], width * 4);
+        std::memcpy(&R.source[at], &p.source[at], width);
+        std::memcpy(&R.topSource[at], &p.topSource[at], width);
+        std::memcpy(&R.underSource[at], &p.underSource[at], width);
+        if (!R.white.empty()) {
+            std::memcpy(&R.white[at], &p.spriteWhiteWeight[at], width);
+        }
+        if (!R.panelMix.empty()) {
+            bool any = false;
+            for (size_t x = 0; x < width && !any; x++) {
+                any = !IsDefaultMix(p.panelMix[at + x]) || !IsDefaultMix(p.underPanelMix[at + x]) || !IsDefaultMix(p.floralCoverMix[at + x]);
+            }
+            R.panelRow[y] = any;
+            if (any) {
+                std::copy_n(&p.panelMix[at], width, &R.panelMix[at]);
+                std::copy_n(&p.underPanelMix[at], width, &R.underPanelMix[at]);
+                std::copy_n(&p.floralCoverMix[at], width, &R.floralCoverMix[at]);
+            }
+        }
+        if (!R.mapFadeEdges.empty()) {
+            std::copy_n(&p.mapFadeEdges[static_cast<size_t>(y) * 32], 32, &R.mapFadeEdges[static_cast<size_t>(y) * 32]);
+        }
+        if (!R.glyph.empty()) {
+            bool any = false;
+            for (size_t x = 0; x < width && !any; x++) {
+                any = p.glyphPlate[at + x].owner != 0;
+            }
+            R.glyphRow[y] = any;
+            if (any) {
+                std::copy_n(&p.glyphPlate[at], width, &R.glyph[at]);
+            }
+        }
+    }
+    std::memcpy(&R.pixels[at], &m_framebuffer[at], width * 4);
+    R.layerMask[y] = layerMask;
+    R.lineOk[y] = 1;
+    R.built++;
+}
+
+void Renderer::ReuseReplayLine(uint32 y) {
+    LineReuse &R = m_reuse;
+    const size_t width = m_width, at = static_cast<size_t>(y) * width;
+    m_lines++;
+    for (uint32 i = 0; i < 6; i++) {
+        m_layerLines[i] += (R.layerMask[y] >> i) & 1;
+    }
+    std::memcpy(&m_framebuffer[at], &R.pixels[at], width * 4);
+    if (R.capture) {
+        Presentation &p = m_presentation;
+        std::memcpy(&p.foreground[at], &R.foreground[at], width * 4);
+        std::memcpy(&p.underSprites[at], &R.underSprites[at], width * 4);
+        std::memcpy(&p.source[at], &R.source[at], width);
+        std::memcpy(&p.topSource[at], &R.topSource[at], width);
+        std::memcpy(&p.underSource[at], &R.underSource[at], width);
+        if (!R.white.empty()) {
+            std::memcpy(&p.spriteWhiteWeight[at], &R.white[at], width);
+        }
+        if (R.panelRow[y]) {
+            std::copy_n(&R.panelMix[at], width, &p.panelMix[at]);
+            std::copy_n(&R.underPanelMix[at], width, &p.underPanelMix[at]);
+            std::copy_n(&R.floralCoverMix[at], width, &p.floralCoverMix[at]);
+        }
+        if (!R.mapFadeEdges.empty()) {
+            std::copy_n(&R.mapFadeEdges[static_cast<size_t>(y) * 32], 32, &p.mapFadeEdges[static_cast<size_t>(y) * 32]);
+        }
+        if (!R.glyph.empty() && R.glyphRow[y]) {
+            std::copy_n(&R.glyph[at], width, &p.glyphPlate[at]);
+        }
+    }
+}
