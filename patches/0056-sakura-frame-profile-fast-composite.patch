+// A dialogue box alone on the floral plane (between two scenes, while the next picture loads): the panel is
+// there and nothing above the box but the floral plane. Cropping to the box then hides nothing.
+inline bool DialogueOnly(const std::vector<uint8_t>& source,int width,int height) {
+    if(width!=320 || height!=224 || source.size()!=320*224) return false;
+    int panel=0,floral=0;
+    for(int y=0;y<224;y++) for(int x=0;x<320;x++) {
+        const int layer=source[y*320+x];
+        if(y<153 && layer!=5 && layer<6) return false;   // a picture, a sprite or a panel above the box
+        panel+=layer==3 && y>=155 && y<220;
+        floral+=layer==5;
+    }
+    return panel>=8000 && floral>=1000;
+}
