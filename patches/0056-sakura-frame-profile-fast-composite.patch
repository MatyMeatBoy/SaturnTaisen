+// SATRECOMP_FRAME_PROFILE=1: where a frame's time goes (emulation, presentation, HD text, present), printed at
+// exit as average and 95th percentile in milliseconds. Off, it costs one branch per section.
+namespace {
+struct FrameProfile {
+    struct Section {const char* name;std::vector<float> ms;};
+    bool on=std::getenv("SATRECOMP_FRAME_PROFILE")!=nullptr;
+    Section run{"emulation"},cpu{"  sh-2 cpus"},sound{"  sound (scsp+68k)"},vdp{"  video (vdp phases)"},
+            present{"presentation"},decor{"  frame decoration"},hdText{"  hd text scan"},early{"  text + tactical"},
+            backdrop{"  backdrop + composite"},ui{"  hd text drawing"},flip{"  render present"};
+    uint64_t mark=0;
+    // (the time since the last mark goes to `section`)
+    void Mark(Section& section) {if(!on)return;const uint64_t now=SDL_GetTicksNS();if(mark)section.ms.push_back(float(now-mark)/1e6f);mark=now;}
+    void Report() {
+        if(!on)return;
+        for(Section* one:{&run,&cpu,&sound,&vdp,&present,&decor,&hdText,&early,&backdrop,&ui,&flip}) {
+            if(one->ms.empty())continue;
+            std::vector<float> v=one->ms;std::sort(v.begin(),v.end());
+            double sum=0;for(float x:v)sum+=x;
+            fprintf(stderr,"frame profile: %-20s n=%zu avg=%.3f ms p95=%.3f ms max=%.3f ms\n",one->name,v.size(),sum/v.size(),
+                    v[std::min(v.size()-1,v.size()*95/100)],v.back());
+        }
+    }
+};
+FrameProfile frameProfile;
+struct ProfileScope {
+    FrameProfile::Section* section;uint64_t start;
+    explicit ProfileScope(FrameProfile::Section& one):section(frameProfile.on?&one:nullptr),start(section?SDL_GetTicksNS():0) {}
+    ~ProfileScope() {if(section)section->ms.push_back(float(SDL_GetTicksNS()-start)/1e6f);}
+};
+}
