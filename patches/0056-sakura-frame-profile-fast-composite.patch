index 0000000..f2a0c1b
--- /dev/null
+++ b/port/parallel_rows.h
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+// A small persistent pool that splits a picture's rows among the CPU's spare cores. Used by the enhanced
+// presentation (panel and picture blending over the HD backdrop), whose rows are independent: each band is
+// worked by one thread and writes only its own rows, so the result is the same as one thread's.
+#include <algorithm>
+#include <atomic>
+#include <condition_variable>
+#include <functional>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace port {
+
+class ParallelRows {
+public:
+    ParallelRows() {
+        const unsigned cores = std::max(1u, std::thread::hardware_concurrency());
+        // (one core stays with the game thread, which also works a band; at most 8 helpers)
+        const unsigned helpers = std::min(8u, cores > 2 ? cores - 2 : 0u);
+        for (unsigned i = 0; i < helpers; i++) threads_.emplace_back([this, i] { Work(i + 1); });
+    }
+    ~ParallelRows() {
+        {
+            std::lock_guard lock(mutex_);
+            stop_ = true;
+            generation_++;
+        }
+        wake_.notify_all();
+        for (auto& thread : threads_) thread.join();
+    }
+    ParallelRows(const ParallelRows&) = delete;
+    ParallelRows& operator=(const ParallelRows&) = delete;
+
+    // Calls band(first, last) for consecutive bands covering [0, rows); returns when all are done.
+    void For(int rows, const std::function<void(int, int)>& band) {
+        const int bands = int(threads_.size()) + 1;
+        if (rows < 64 || bands == 1) {
+            band(0, rows);
+            return;
+        }
+        {
+            std::lock_guard lock(mutex_);
+            job_ = &band;
+            rows_ = rows;
+            bands_ = bands;
+            pending_ = bands - 1;
+            generation_++;
+        }
+        wake_.notify_all();
+        Band(0);
+        std::unique_lock lock(mutex_);
+        done_.wait(lock, [this] { return pending_ == 0; });
+        job_ = nullptr;
+    }
+
+private:
+    void Band(int index) {
+        const int first = int(int64_t(rows_) * index / bands_), last = int(int64_t(rows_) * (index + 1) / bands_);
+        if (first < last) (*job_)(first, last);
+    }
+    void Work(int index) {
+        uint64_t seen = 0;
+        for (;;) {
+            {
+                std::unique_lock lock(mutex_);
+                wake_.wait(lock, [&] { return generation_ != seen; });
+                seen = generation_;
+                if (stop_) return;
+            }
+            Band(index);
+            {
+                std::lock_guard lock(mutex_);
+                if (--pending_ == 0) done_.notify_one();
+            }
+        }
+    }
