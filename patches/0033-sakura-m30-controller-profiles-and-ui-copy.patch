diff --git a/port/controller_profiles.h b/port/controller_profiles.h
new file mode 100644
index 0000000..2561dac
--- /dev/null
+++ b/port/controller_profiles.h
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include "../recomp-common/launcher/src/bindings.h"
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <cctype>
+namespace port {
+enum class SaturnPadProfile {Standard,M30};
+inline SaturnPadProfile IdentifySaturnPad(uint16_t vendor,uint16_t product,const char* name) {
+    std::string text=name?name:"";for(char& c:text)c=char(std::tolower(static_cast<unsigned char>(c)));
+    if((vendor==0x2dc8 && (product==0x5006 || product==0x0651)) ||
+       (vendor==0x0ca3 && product==0x0024) || text.find("m30")!=std::string::npos)return SaturnPadProfile::M30;
+    return SaturnPadProfile::Standard;
+}
+inline recomp::PadInput ResolveSaturnInput(std::string_view action,recomp::PadInput configured,bool customized,SaturnPadProfile profile) {
+    if(customized || profile!=SaturnPadProfile::M30)return configured;
+    if(action=="a")return {SDL_GAMEPAD_BUTTON_SOUTH,-1};
+    if(action=="b")return {SDL_GAMEPAD_BUTTON_EAST,-1};
+    if(action=="c")return {-1,SDL_GAMEPAD_AXIS_RIGHT_TRIGGER};
+    if(action=="x")return {SDL_GAMEPAD_BUTTON_WEST,-1};
+    if(action=="y")return {SDL_GAMEPAD_BUTTON_NORTH,-1};
+    if(action=="z")return {SDL_GAMEPAD_BUTTON_RIGHT_SHOULDER,-1};
+    if(action=="l")return {SDL_GAMEPAD_BUTTON_LEFT_SHOULDER,-1};
+    if(action=="r")return {-1,SDL_GAMEPAD_AXIS_LEFT_TRIGGER};
+    return configured;
+}
+}
