diff --git a/port/registered_body_overlay.h b/port/registered_body_overlay.h
new file mode 100644
--- /dev/null
+++ b/port/registered_body_overlay.h
@@ -0,0 +1,89 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace port::registered_body {
+struct Entry {
+    const char* name;
+    const char* file;
+    uint64_t bodyHash, paletteHash, donorHash;
+    std::size_t donorBytes;
+    int width, height, donorWidth, donorHeight;
+    int scaleX, scaleY, originX, originY;
+    int feather;
+};
+inline constexpr std::array<Entry, 3> kEntries{{
+    {"NC4138", "SAKURA1/NC/NC4138.SPR", 0x0CAB60660ABA6DD5ull, 0x7C07B11306D1DEA2ull,
+     0x5D01F8A13100D78Full, 71692, 112, 112, 230, 254, 2073, 2249, -3508, -4654, 0},
+    {"NC3125", "SAKURA1/NC/NC3125.SPR", 0xD490539B25905CE9ull, 0x8A6FB394C17EE70Cull,
+     0x1AC5E04E7DB219DCull, 55414, 200, 96, 398, 205, 2177, 2339, -60, -17403, 12},
+    {"NC3126", "SAKURA1/NC/NC3126.SPR", 0x15A1798B00413580ull, 0x9B408B83C410FE86ull,
+     0x705578D90A9E85A5ull, 69063, 192, 96, 385, 209, 2098, 2260, -5610, -5919, 12},
+}};
+
+inline uint32_t NativeRgb(std::span<const uint8_t> palette, unsigned index) {
+    const uint32_t word = uint32_t(palette[index*2])<<8 | palette[index*2+1];
+    return ((word & 31) << 3) | ((word & 0x03E0) << 6) | ((word & 0x7C00) << 9);
+}
+
+inline bool Visible(const Entry& entry, std::span<const uint8_t> indices,
+                    std::span<const uint8_t> palette, std::span<const uint32_t> screen,
+                    std::span<const uint8_t> source, std::span<const uint8_t> white, int x, int y) {
+    if (indices.size() != std::size_t(entry.width*entry.height) || palette.size() != 512 ||
+        screen.size() != 320*224 || source.size() != screen.size() || white.size() != screen.size() ||
+        x < 16 || y < 8 || x > 304-entry.width || y > 152-entry.height) return false;
+    for (int row = 0; row < entry.height; ++row) {
+        for (int column = 0; column < entry.width; ++column) {
+            const unsigned index = indices[row*entry.width + column];
+            if (!index) continue;
+            const std::size_t at = (y+row)*320 + x+column;
+            if (source[at] != 0 || white[at] != 0 ||
+                (screen[at] & 0xFFFFFF) != NativeRgb(palette, index)) return false;
+        }
+    }
+    return true;
+}
+
+inline std::vector<uint32_t> Register(const Entry& entry, std::span<const uint8_t> indices,
+                                      std::span<const uint8_t> palette, std::span<const uint32_t> donor) {
+    if (indices.size() != std::size_t(entry.width*entry.height) || palette.size() != 512 ||
+        donor.size() != std::size_t(entry.donorWidth*entry.donorHeight)) return {};
+    const int outputWidth = entry.width*2, outputHeight = entry.height*2;
+    std::vector<uint32_t> output(outputWidth*outputHeight);
+    for (int y = 0; y < outputHeight; ++y) {
+        for (int x = 0; x < outputWidth; ++x) {
+            const unsigned index = indices[(y/2)*entry.width + x/2];
+            if (!index) continue;
+            // Project each of the two samples per native axis through the measured integer fit.
+            const int rawX = entry.scaleX*(2*x-1) + 4*entry.originX + 2000;
+            const int rawY = entry.scaleY*(2*y-1) + 4*entry.originY + 2000;
+            const int sx = rawX/4000, sy = rawY/4000;
+            if (rawX < 0 || rawY < 0 || sx >= entry.donorWidth || sy >= entry.donorHeight) {
+                if (entry.feather) continue;
+                return {};
+            }
+            const int edge = std::min({sx, sy, entry.donorWidth-1-sx, entry.donorHeight-1-sy});
+            if (entry.feather && !edge) continue;
+            uint32_t color = donor[sy*entry.donorWidth + sx];
+            if (color>>24 != 255) return {};
+            if (edge < entry.feather) {
+                const uint32_t native = NativeRgb(palette, index);
+                const uint32_t pc = color;
+                color = 0xFF000000;
+                for (unsigned shift : {0u, 8u, 16u}) {
+                    const auto channel = (int((pc>>shift)&255)*edge +
+                        int((native>>shift)&255)*(entry.feather-edge) + entry.feather/2) / entry.feather;
+                    color |= uint32_t(channel)<<shift;
+                }
+            }
+            output[y*outputWidth+x] = color;
+        }
+    }
+    return output;
+}
+}
