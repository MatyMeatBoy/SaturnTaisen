+    const auto drawMiniHud = [&](const satrecomp::video::Renderer::Presentation& planes,
+                                 const SDL_FRect& crop, const SDL_FRect& target, int scale) {
+        if (scale < 2 || choosing || port.menu.IsOpen() || port.opt.pcAssetsPath.empty() ||
+            satrecomp::FeatureValue("presentation_mode") != 1 || satrecomp::FeatureValue("pc_hd_backgrounds") != 0 ||
+            planes.width != 320 || planes.height != 224 ||
+            planes.topSource.size() != 320 * 224 || softwareShown.size() != 320 * 224)
+            return;
+        const auto coord = [](uint16_t value) { return (int(value & 0x1FFF) ^ 0x1000) - 0x1000; };
+        for (auto it = planes.sprites.begin(); it != planes.sprites.end(); ++it) {
+            const auto& cmd = it->command.words;
+            if (cmd[0] != 0x1000) continue;
+            const unsigned width = ((cmd[5] >> 8) & 63) * 8, height = cmd[5] & 255;
+            const auto* piece = std::ranges::find_if(miniHudPieces, [&](const auto& entry) {
+                return entry.address == cmd[4] && entry.mode == cmd[2] && entry.color == cmd[3] &&
+                       entry.width == width && entry.height == height &&
+                       (entry.x == -1 || (entry.x == it->x && entry.y == it->y));
+            });
+            if (piece == std::end(miniHudPieces)) continue;
+            const bool indexed4 = piece->mode == 0x0080;
+            const size_t sourcePixels = size_t(width) * height;
+            const size_t paletteStart = 2 * (piece->color & 0x7FF);
+            const size_t paletteBytes = indexed4 ? 32 : 512;
+            if (it->pixels.size() != (indexed4 ? sourcePixels / 2 : sourcePixels) ||
+                paletteStart + paletteBytes > planes.palette.size()) continue;
+            const auto palette = std::span{planes.palette}.subspan(paletteStart, paletteBytes);
+            const auto& atlas = miniHudAtlases[piece->atlas];
+            if (PcBackdropHash(palette) != atlas.palette || PcBackdropHash(it->pixels) != piece->hash) continue;
+            auto& art = miniHudArt[piece->atlas];
+            if (!art.tried) {
+                art.tried = true;
+                art.pending = std::async(std::launch::async,
+                    [path = std::filesystem::u8path(port.opt.pcAssetsPath) / atlas.file, atlas] {
+                        std::vector<PcSprite> images;
+                        std::vector<uint8_t> bytes;
+                        std::string error;
+                        if (!ReadPcBackdropFile(path, bytes, atlas.bytes) || bytes.size() != atlas.bytes ||
+                            PcBackdropHash(bytes) != atlas.hash || !DecodePcSprites(bytes, images, error))
+                            return std::vector<PcSprite>{};
+                        return images;
+                    });
+            }
+            if (art.pending.valid() && art.pending.wait_for(std::chrono::seconds(0)) == std::future_status::ready)
+                art.images = art.pending.get();
+            const unsigned stride = 2 * width;
+            const auto image = std::ranges::find_if(art.images, [&](const auto& sprite) {
+                return sprite.index == piece->ordinal && sprite.width == stride &&
+                       sprite.height == 2 * height && sprite.pixels.size() == 4 * sourcePixels;
+            });
+            if (image == art.images.end()) continue;
+
+            std::vector<EveRect> covers;
+            bool safe = true;
+            for (auto later = std::next(it); later != planes.sprites.end(); ++later) {
+                const auto& next = later->command.words;
+                const unsigned type = next[0] & 15;
+                if (type >= 8) continue;
+                int cols = ((next[5] >> 8) & 63) * 8, rows = next[5] & 255;
+                if (type == 2) {
+                    const int x = coord(next[6]), y = coord(next[7]);
+                    const int right = coord(next[8]), bottom = coord(next[11]);
+                    if (right < x || bottom < y || coord(next[9]) != y || coord(next[10]) != right ||
+                        coord(next[12]) != x || coord(next[13]) != bottom) { safe = false; break; }
+                    cols = right - x + 1;
+                    rows = bottom - y + 1;
+                } else if (type != 0) { safe = false; break; }
+                cols = std::max(cols, 1);
+                rows = std::max(rows, 1);
+                if (later->x < it->x + int(width) && later->x + cols > it->x &&
+                    later->y < it->y + int(height) && later->y + rows > it->y)
+                    covers.push_back({later->x, later->y, cols, rows});
+            }
+            if (!safe) continue;
+            miniHudPixels.assign(4 * sourcePixels, 0);
+            bool changed = false;
+            for (unsigned y = 0; y < height; ++y) for (unsigned x = 0; x < width; ++x) {
+                const int sx = it->x + int(x), sy = it->y + int(y);
+                if (sx < 0 || sx >= 320 || sy < 0 || sy >= 224 ||
+                    sx < crop.x || sx >= crop.x + crop.w || sy < crop.y || sy >= crop.y + crop.h ||
+                    std::ranges::any_of(covers, [&](const auto& r) {
+                        return sx >= r.x && sx < r.x + r.width && sy >= r.y && sy < r.y + r.height;
+                    })) continue;
+                const size_t at = size_t(sy) * 320 + sx;
+                if (planes.topSource[at] != 0) continue;
+                const size_t offset = y * width + x;
+                const unsigned ink = indexed4 ?
+                    ((it->pixels[offset / 2] >> (offset % 2 ? 0 : 4)) & 15u) : it->pixels[offset];
+                if (!ink) continue;
+                const unsigned word = (unsigned(palette[2 * ink]) << 8) | palette[2 * ink + 1];
+                const uint32_t rgb = ((word & 31) << 3) | ((word & 0x3E0) << 6) | ((word & 0x7C00) << 9);
+                if ((softwareShown[at] & 0xFFFFFFu) != rgb) continue;
+                const size_t first = (2 * y) * stride + 2 * x;
+                const std::array<size_t, 4> subpixel{first, first + 1, first + stride, first + stride + 1};
+                if (std::ranges::any_of(subpixel, [&](size_t k) {
+                    const auto pc = image->pixels[k];
+                    return (pc >> 24) != 255 || (pc & 0xFFFFFFu) == 0x00FF00u || (pc & 0xFFFFFFu) == 0xFFFF00u;
+                })) continue;
+                // Retain Saturn color and edges. Transfer only the donor's variation
+                // within this native cell, where all four donor samples are opaque.
+                for (unsigned shift : {0u, 8u, 16u}) {
+                    const auto channel = [shift](uint32_t p) { return int((p >> shift) & 255u); };
+                    int sum = 0;
+                    for (size_t k : subpixel) sum += channel(image->pixels[k]);
+                    const int average = (sum + 2) / 4;
+                    const int inkColor = channel(rgb);
+                    for (size_t k : subpixel) {
+                        const int sample = std::clamp(inkColor + channel(image->pixels[k]) - average, 0, 255);
+                        miniHudPixels[k] |= 0xFF000000u | (uint32_t(sample) << shift);
+                        changed |= sample != inkColor;
+                    }
+                }
+            }
+            if (!changed) continue;
+            if (!miniHudTexture) {
+                miniHudTexture = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_ABGR8888,
+                                                   SDL_TEXTUREACCESS_STREAMING, 640, 160);
+                if (!miniHudTexture) return;
+                if (!SDL_SetTextureScaleMode(miniHudTexture, SDL_SCALEMODE_NEAREST) ||
+                    !SDL_SetTextureBlendMode(miniHudTexture, SDL_BLENDMODE_BLEND)) {
+                    SDL_DestroyTexture(std::exchange(miniHudTexture, nullptr));
+                    return;
+                }
+            }
+            const SDL_Rect update{0, 0, int(stride), int(2 * height)};
+            if (!SDL_UpdateTexture(miniHudTexture, &update, miniHudPixels.data(), stride * sizeof(uint32_t))) continue;
+            const SDL_FRect source{0, 0, float(stride), float(2 * height)};
+            const SDL_FRect dest{target.x + (it->x - crop.x) * scale, target.y + (it->y - crop.y) * scale,
+                             float(width * scale), float(height * scale)};
+            SDL_RenderTexture(renderer, miniHudTexture, &source, &dest);
         }
     };
