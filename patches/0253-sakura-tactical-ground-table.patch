+// Every other ground of the 27 tactical maps: generated by tools/gen_tactical_ground_table.py from
+// config/hd-tactical-ground-table.json. The signature is derived from the MAPnn.BIN and none of these
+// maps has been seen drawn yet (`wired-unverified`): a signature that never matches leaves the map native.
+inline constexpr Entry kGenerated[] = {
+#include "tactical_ground_table.inc"
+};
+
 inline const Entry* Find(uint64_t signature) {
     if (signature == kStage01.mapSignature) return &kStage01;
     if (signature == kStage02.mapSignature) return &kStage02;
@@ -85,6 +92,8 @@ inline const Entry* Find(uint64_t signature) {
     if (signature == kStage15.mapSignature) return &kStage15;
     if (signature == kStage16.mapSignature) return &kStage16;
     if (signature == kStage21.mapSignature) return &kStage21;
+    for (const auto& entry : kGenerated)
+        if (signature == entry.mapSignature) return &entry;
     return nullptr;
 }
 
