diff --git a/port/narrative_text.h b/port/narrative_text.h
new file mode 100644
index 0000000..fd32540
--- /dev/null
+++ b/port/narrative_text.h
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <array>
+#include <cstdint>
+#include <span>
+#include <algorithm>
+namespace port {
+struct NaturalTextTransform {float scale=0,offsetX=0,offsetY=0;};
+inline NaturalTextTransform NaturalTextPlacement(float advance,float capX,float capY,float capHeight,
+                                                int nativeLeft,int nativeTop,int nativeCapHeight,int displayScale) {
+    if(advance<=0 || capHeight<=0 || nativeCapHeight<=0 || displayScale<1)return {};
+    const float uniform=std::min(8.0f*displayScale/advance,float(nativeCapHeight*displayScale)/capHeight);
+    return {uniform,nativeLeft*displayScale-capX*uniform,nativeTop*displayScale-capY*uniform};
+}
+// Native dialogue interior, excluding the speaker portrait and ornate frame.
+inline constexpr int kTextLeft=56,kTextTop=160,kTextRight=304,kTextBottom=208;
+inline bool NarrativeInkFits(int x,int y,std::span<const uint8_t> tile) {
+    if(tile.size()!=128)return false;
+    for(int py=0;py<16;py++)for(int px=0;px<16;px++) {
+        const uint8_t packed=tile[py*8+px/2];
+        if(!(px&1?packed&15:packed>>4))continue;
+        if(x+px<kTextLeft || x+px>=kTextRight || y+py<kTextTop || y+py>=kTextBottom)return false;
+    }
+    return true;
+}
+inline std::array<int,4> NarrativeClip(int x,int y,int scale,int cropX,int cropY) {
+    return {x+(kTextLeft-cropX)*scale,y+(kTextTop-cropY)*scale,
+            x+(kTextRight-cropX)*scale,y+(kTextBottom-cropY)*scale};
+}
+}
