diff --git a/port/presentation_layout.h b/port/presentation_layout.h
new file mode 100644
--- /dev/null
+++ b/port/presentation_layout.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include "integer_viewport.h"
+#include <cstdint>
+#include <vector>
+namespace port {
+inline IntegerViewport CoverInteger(int width,int height,int columns,int lines) {
+    if(width<=0 || height<=0 || columns<=0 || lines<=0) return {};
+    const int k=std::max({1,1+(width-1)/columns,1+(height-1)/lines});
+    return {(width-columns*k)/2,(height-lines*k)/2,columns*k,lines*k,k};
+}
+struct SceneLayout {
+    bool recognized=false,movieOnly=false;
+    int x=0,y=0,w=0,h=0;
+};
+inline SceneLayout AnalyzePresentation(const std::vector<uint8_t>& source,int width,int height) {
+    if(width!=320 || height!=224 || source.size()!=320*224) return {};
+    int floral=0,picture=0,movie=0,actor=0,text=0,frame=0;
+    int left=320,right=-1,top=224,bottom=-1;
+    for(int y=0;y<224;y++) for(int x=0;x<320;x++) {
+        const int layer=source[y*320+x];
+        floral+=layer==5;
+        if(layer<5) {left=std::min(left,x);right=std::max(right,x);top=std::min(top,y);bottom=std::max(bottom,y);}
+        const bool inside=x>=16 && x<304 && y>=8 && y<152;
+        if(layer==1 || layer==2) {
+            if(!inside) return {}; // different screen layout
+            picture++; movie+=layer==1;
+        }
+        actor+=inside && layer==0;
+        text+=layer==0 && x>=56 && x<285 && y>=165 && y<204;
+        frame+=layer==0 && y>=153;
+    }
+    if(floral<1000 || picture<20000 || frame<100 || right<left || bottom<top) return {};
+    return {true,movie>30000 && actor==0 && text==0,left,top,right-left+1,bottom-top+1};
+}
+}
diff --git a/port/sakura_ui.cpp b/port/sakura_ui.cpp
new file mode 100644
--- /dev/null
+++ b/port/sakura_ui.cpp
@@ -0,0 +1,124 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#include "sakura_ui.h"
+#include "../recomp-common/launcher/src/ui.h"
+#include <imgui_impl_sdl3.h>
+#include <imgui_impl_sdlrenderer3.h>
+#include <algorithm>
+#include <filesystem>
+#include "../recomp-common/launcher/src/presentation_cards.h"
+#include <cmath>
+namespace port {
+bool SakuraUi::Open(SDL_Window* window,SDL_Renderer* renderer,const std::string& settings) {
+    this->renderer=renderer;
+    IMGUI_CHECKVERSION(); ImGui::CreateContext();
+    ImGui::GetIO().IniFilename=nullptr;
+    ui::set_dark(false); ui::apply_style(1); ui::load_fonts();
+    if (!ImGui_ImplSDL3_InitForSDLRenderer(window,renderer)) { ImGui::DestroyContext(); return false; }
+    if (!ImGui_ImplSDLRenderer3_Init(renderer)) {
+        ImGui_ImplSDL3_Shutdown(); ImGui::DestroyContext(); return false;
+    }
+    for(int i=0;i<2;i++) for(const auto& folder:{std::filesystem::path(settings).parent_path(),std::filesystem::path(SDL_GetBasePath())}) {
+        previews[i]=sakura::Preview(renderer,(folder/"art"/(i?"presentation-enhanced.png":"presentation-original.png")).string());
+        if(previews[i]) break;
+    }
+    active=true; return true;
+}
+void SakuraUi::Close() {
+    if (!active) return;
+    for(auto*& texture:previews) {if(texture) SDL_DestroyTexture(texture);texture=nullptr;}
+    ImGui_ImplSDLRenderer3_Shutdown(); ImGui_ImplSDL3_Shutdown(); ImGui::DestroyContext();
+    active=false;
+}
+void SakuraUi::Event(const SDL_Event& event) {
+    if (active) ImGui_ImplSDL3_ProcessEvent(&event);
+}
+bool SakuraUi::Choice(int& selection) {
+    if(!active) return false;
+    ImGui_ImplSDLRenderer3_NewFrame(); ImGui_ImplSDL3_NewFrame(); ImGui::NewFrame();
+    ui::begin_frame(ImGui::GetIO().DeltaTime);
+    const auto size=ImGui::GetIO().DisplaySize; const auto& p=ui::palette();
+    const float width=std::min(1000.0f,size.x-32),height=std::min(660.0f,size.y-24);
+    ImGui::SetNextWindowPos((size-ImVec2(width,height))*.5f); ImGui::SetNextWindowSize({width,height});
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding,28); ImGui::PushStyleVar(ImGuiStyleVar_WindowPadding,{26,22});
+    ImGui::Begin("Elige tu aventura",nullptr,ImGuiWindowFlags_NoDecoration|ImGuiWindowFlags_NoSavedSettings|ImGuiWindowFlags_NoMove);
+    ui::text("BIENVENIDO A LA COMPAÑÍA IMPERIAL",ui::Font::Semibold,12,p.accent);
+    ui::gap(8); ui::text("Tu aventura, a tu manera",ui::Font::Semibold,30,p.primary);
+    ui::text("Elige cómo quieres descubrir Sakura Wars",ui::Font::Regular,15,p.secondary);
+    ui::gap(22);
+    sakura::ModeCards(selection,width-52,previews[0],previews[1]);
+    ui::gap(16);
+    const bool accepted=ui::button("Comenzar la función",ui::Kind::Primary,230,true,46);
+    ui::gap(12);
+    ui::text("← → Elegir   ·   Enter / A Confirmar   ·   Puedes cambiarlo después con Start + Select",ui::Font::Regular,12,p.secondary,width-52);
