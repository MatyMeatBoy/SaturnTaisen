+    ui::text("SAKURA WARS  /  SATURNTAISENFIRST",ui::Font::Semibold,11,p.accent);
+    ui::gap(7); ui::text(view.title.c_str(),ui::Font::Semibold,29,p.primary);
+    ui::text("Un respiro antes de volver al escenario",ui::Font::Regular,13,p.secondary);
+    ui::gap(18);
+    unsigned pressed=0;
+    const bool compact=width<650;
+    const float listWidth=compact?width-56:(width-76)*.58f;
+    ImGui::BeginChild("choices",{listWidth,height-187},ImGuiChildFlags_None);
+    for (size_t i=0;i<view.items.size();i++) {
+        const auto& item=view.items[i];
+        if (item.divider && i) ui::gap(9);
+        ImGui::PushID(static_cast<int>(i));
+        const auto pos=ImGui::GetCursorScreenPos(); const bool selected=static_cast<int>(i)==view.selected;
+        const float rowWidth=ImGui::GetContentRegionAvail().x;
+        if (ImGui::InvisibleButton("row",{rowWidth,44})) {
+            menu.Select(static_cast<int>(i)); pressed=recomp::kMenuConfirm;
+        }
+        auto* draw=ImGui::GetWindowDrawList();
+        draw->AddRectFilled(pos,pos+ImVec2(rowWidth,44),selected?p.primary:ImGui::IsItemHovered()?p.control_hover:p.surface,17);
+        if (selected) draw->AddRect(pos,pos+ImVec2(rowWidth,44),p.accent,17,2);
+        ImGui::SetCursorScreenPos(pos+ImVec2(15,11));
+        ui::text(item.title.c_str(),ui::Font::Semibold,15,selected?p.primary_text:p.text);
+        if (!item.value.empty()) {
+            auto textSize=ui::text_size(item.value.c_str(),ui::Font::Regular,12);
+            ImGui::SetCursorScreenPos(pos+ImVec2(std::max(15.0f,rowWidth-textSize.x-16),27));
+            ui::text(item.value.c_str(),ui::Font::Regular,12,selected?p.primary_text:p.secondary);
+        }
+        ImGui::SetCursorScreenPos(pos+ImVec2(0,49));
+        if (selected && lastSelected!=view.selected) ImGui::SetScrollHereY(.5f);
+        ImGui::PopID();
+    }
+    ImGui::EndChild();
+    lastSelected=view.selected;
+    std::string description=view.note;
+    if (description.empty() && view.selected>=0 && view.selected<static_cast<int>(view.items.size()))
+        description=view.items[view.selected].description;
+    if (!compact) {
+        ImGui::SameLine(0,22);
+        ImGui::BeginChild("detail",{0,height-187},ImGuiChildFlags_None);
+        ui::text("COMPAÑÍA IMPERIAL",ui::Font::Semibold,12,p.accent);
+        ui::gap(16);
+        ui::text(description.c_str(),ui::Font::Regular,16,p.text,ImGui::GetContentRegionAvail().x);
+        ui::gap(24);
+        ui::text("Tus cambios se conservan al volver al juego.",ui::Font::Regular,12,p.secondary,ImGui::GetContentRegionAvail().x);
+        ImGui::EndChild();
+    }
+    ui::gap(12);
+    ui::text("↑ ↓ Elegir     ← → Ajustar     Enter / A Confirmar     Esc / Start + Select Volver",ui::Font::Regular,12,p.secondary,width-56);
+    ImGui::End(); ImGui::PopStyleVar(2);
+    ImGui::Render();
+    ImGui_ImplSDLRenderer3_RenderDrawData(ImGui::GetDrawData(),renderer);
+    return pressed;
+}
