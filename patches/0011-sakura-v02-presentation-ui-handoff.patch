@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <filesystem>
+#include <fstream>
+#include <string>
+namespace recomp {
+inline bool LaunchReady(const std::filesystem::path& file) {
+    if (file.empty()) return false;
+    std::ifstream input(file,std::ios::binary);
+    std::string value((std::istreambuf_iterator<char>(input)),{});
+    return value=="SaturnTaisenFirst:presented:1\n";
+}
+inline bool PublishLaunchReady(const std::filesystem::path& file) {
+    if (file.empty()) return true;
+    const auto pending=std::filesystem::path(file.string()+".tmp");
+    { std::ofstream output(pending,std::ios::binary|std::ios::trunc);
+      output<<"SaturnTaisenFirst:presented:1\n";
+      output.close(); if (!output) return false; }
+    std::error_code error;
+    std::filesystem::rename(pending,file,error);
+    if (error) std::filesystem::remove(pending,error);
+    return LaunchReady(file);
+}
+}
