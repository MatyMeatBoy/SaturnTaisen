+namespace sakura {
+inline bool ModeCards(int& choice,float width,SDL_Texture* original,SDL_Texture* enhanced) {
+    const auto& p=ui::palette();
+    const bool stacked=width<520;
+    const float gap=ui::px(14), cardWidth=stacked?width:(width-gap)*.5f;
+    bool changed=false;
+    for(int i=0;i<2;i++) {
+        if(i && !stacked) ImGui::SameLine(0,gap);
+        ImGui::PushID(i);
+        ImGui::BeginGroup();
+        const auto at=ImGui::GetCursorScreenPos();
+        const float previewHeight=cardWidth*9/16, height=previewHeight+ui::px(96);
+        if(ImGui::InvisibleButton("presentation",{cardWidth,height},ImGuiButtonFlags_EnableNav)) {choice=i;changed=true;}
+        auto* draw=ImGui::GetWindowDrawList();
+        draw->AddRectFilled(at+ImVec2(0,4),at+ImVec2(cardWidth,height+4),IM_COL32(70,25,42,18),22);
+        draw->AddRectFilled(at,at+ImVec2(cardWidth,height),p.surface,22);
+        draw->AddRect(at,at+ImVec2(cardWidth,height),choice==i?p.primary:p.separator,22,choice==i?3:1);
+        const auto begin=at+ImVec2(10,10), end=at+ImVec2(cardWidth-10,previewHeight);
+        draw->AddRectFilled(begin,end,p.control,14);
+        auto* texture=i?enhanced:original;
+        if(texture) {
+            float w=0,h=0; SDL_GetTextureSize(texture,&w,&h);
+            const float scale=std::min((end.x-begin.x)/w,(end.y-begin.y)/h);
+            const ImVec2 size(w*scale,h*scale), start=(begin+end-size)*.5f;
+            draw->AddImage(ImTextureRef((ImTextureID)(intptr_t)texture),start,start+size);
+        } else {
+            const float innerWidth=(end.y-begin.y)*(i?16.0f/9:4.0f/3);
+            const ImVec2 box(std::min(innerWidth,end.x-begin.x-20),end.y-begin.y-16);
+            const auto start=(begin+end-box)*.5f;
+            draw->AddRectFilled(start,start+box,p.primary,8);
+            draw->AddText(start+ImVec2(12,12),p.primary_text,i?"16:9":"4:3");
+        }
+        ImGui::SetCursorScreenPos(at+ImVec2(18,previewHeight+12));
+        ui::text(i?"Mejorado · widescreen":"Original · 4:3",ui::Font::Semibold,16,p.primary);
+        ImGui::SetCursorScreenPos(at+ImVec2(18,previewHeight+37));
+        ui::text(i?"Más espacio, escala entera y fondo floral":"Composición Saturn y píxeles originales",ui::Font::Regular,12,p.secondary,cardWidth-36);
+        ImGui::SetCursorScreenPos(at+ImVec2(18,previewHeight+66));
+        ui::text(choice==i?"SELECCIONADO":"ELEGIR",ui::Font::Semibold,10,choice==i?p.primary:p.accent);
+        ImGui::SetCursorScreenPos(at+ImVec2(0,height+8));
+        ImGui::EndGroup(); ImGui::PopID();
+    }
+    return changed;
+}
+inline SDL_Texture* Preview(SDL_Renderer* renderer,const std::string& path) {
+    auto* surface=SDL_LoadPNG(path.c_str()); if(!surface) return nullptr;
+    auto* texture=SDL_CreateTextureFromSurface(renderer,surface); SDL_DestroySurface(surface);
+    if(texture) SDL_SetTextureScaleMode(texture,SDL_SCALEMODE_NEAREST);
+    return texture;
+}
+}
