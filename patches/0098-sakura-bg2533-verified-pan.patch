diff --git a/port/bg2533_verified_pan.h b/port/bg2533_verified_pan.h
new file mode 100644
--- /dev/null
+++ b/port/bg2533_verified_pan.h
@@ -0,0 +1,81 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <vector>
+
+namespace port {
+constexpr unsigned kPanPictureWidth = 512;
+constexpr unsigned kPanReliableWidth = 496;
+constexpr unsigned kPanPictureHeight = 144;
+constexpr unsigned kPanInsetWidth = 288;
+constexpr unsigned kPanPictureOffsetX = 16;
+constexpr unsigned kPanPictureOffsetY = 8;
+constexpr unsigned kPanFrameWidth = 320;
+constexpr unsigned kPanFrameHeight = 224;
+
+struct VerifiedPanPosition {
+    unsigned offset;
+    unsigned visibleWidth;
+};
+
+inline std::optional<VerifiedPanPosition> FindVerifiedPanPosition(
+    std::span<const uint32_t> picture, std::span<const uint32_t> frame,
+    std::span<const uint8_t> topSource) {
+    if (picture.size() != kPanPictureWidth * kPanPictureHeight ||
+        frame.size() != kPanFrameWidth * kPanFrameHeight ||
+        topSource.size() != frame.size()) return {};
+    auto agrees = [&](unsigned start, unsigned x, unsigned y) {
+        const auto pixel = (y + kPanPictureOffsetY) * kPanFrameWidth + x + kPanPictureOffsetX;
+        return topSource[pixel] == 4 &&
+            (frame[pixel] & 0xFFFFFF) == picture[y * kPanPictureWidth + start + x];
+    };
+    std::optional<VerifiedPanPosition> result;
+    for (unsigned offset = 0; offset <= kPanPictureWidth - kPanInsetWidth; ++offset) {
+        const unsigned width = std::min(kPanInsetWidth, kPanReliableWidth - offset);
+        if (!agrees(offset, 17, 13) || !agrees(offset, 139, 77) ||
+            !agrees(offset, 247, 114)) continue;
+        bool verified = true;
+        for (unsigned y = 0; y < kPanPictureHeight && verified; ++y) {
+            for (unsigned x = 0; x < width; ++x) {
+                if (!agrees(offset, x, y)) {
+                    verified = false;
+                    break;
+                }
+            }
+        }
+        if (!verified) continue;
+        if (result) return {};
+        result = VerifiedPanPosition{offset, width};
+    }
+    return result;
+}
+
+inline std::vector<uint32_t> DecodePinnedBG2533(std::span<const uint8_t> bytes) {
+    constexpr unsigned table = 0x610;
+    constexpr unsigned tiles = table + 64 * 18 * 4;
+    if (bytes.size() != 64016) return {};
+    uint64_t fingerprint = 14695981039346656037ull;
+    for (auto value : bytes) fingerprint = (fingerprint ^ value) * 1099511628211ull;
+    if (fingerprint != 0x2DCA5B2CA73F65DDull) return {};
+
+    std::vector<uint32_t> pixels(kPanPictureWidth * kPanPictureHeight);
+    for (unsigned y = 0; y < kPanPictureHeight; ++y) {
+        for (unsigned x = 0; x < kPanPictureWidth; ++x) {
+            const auto name = table + ((y / 8) * 64 + x / 8) * 4;
+            const unsigned pattern = unsigned(bytes[name]) << 24 |
+                unsigned(bytes[name + 1]) << 16 | unsigned(bytes[name + 2]) << 8 | bytes[name + 3];
+            const auto row = (pattern & 0x80000000u) ? 7 - y % 8 : y % 8;
+            const auto col = (pattern & 0x40000000u) ? 7 - x % 8 : x % 8;
+            const unsigned pos = tiles + (pattern & 0x7FFF) * 32 + row * 8 + col;
+            if (pos >= bytes.size()) return {};
+            const auto index = bytes[pos];
+            const unsigned rgb = unsigned(bytes[16 + index * 2]) << 8 | bytes[17 + index * 2];
+            pixels[y * kPanPictureWidth + x] =
+                ((rgb & 31) << 3) | ((rgb & 0x3E0) << 6) | ((rgb & 0x7C00) << 9);
+        }
+    }
+    return pixels;
+}
+}
