diff --git a/port/nc4138_overlay.h b/port/nc4138_overlay.h
new file mode 100644
--- /dev/null
+++ b/port/nc4138_overlay.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace port::nc4138 {
+inline constexpr int kSize = 112;
+inline constexpr int kDonorWidth = 230;
+inline constexpr int kDonorHeight = 254;
+inline constexpr uint64_t kBodyHash = 0x0CAB60660ABA6DD5ull;
+inline constexpr uint64_t kPaletteHash = 0x7C07B11306D1DEA2ull;
+inline constexpr uint64_t kDonorHash = 0x5D01F8A13100D78Full;
+inline constexpr std::size_t kDonorBytes = 71692;
+
+inline bool Visible(std::span<const uint8_t> indices, std::span<const uint8_t> palette,
+                    std::span<const uint32_t> screen, std::span<const uint8_t> source,
+                    std::span<const uint8_t> white, int x, int y) {
+    if (indices.size() != kSize*kSize || palette.size() != 512 ||
+        screen.size() != 320*224 || source.size() != screen.size() || white.size() != screen.size() ||
+        x < 16 || y < 8 || x > 304-kSize || y > 152-kSize) return false;
+    for (int row = 0; row < kSize; ++row) {
+        for (int column = 0; column < kSize; ++column) {
+            const unsigned i = indices[row*kSize + column];
+            if (!i) continue;
+            const std::size_t at = (y+row)*320 + x+column;
+            const uint32_t word = uint32_t(palette[i*2])<<8 | palette[i*2+1];
+            const uint32_t rgb = ((word & 31) << 3) | ((word & 0x03E0) << 6) | ((word & 0x7C00) << 9);
+            if (source[at] != 0 || white[at] != 0 || (screen[at] & 0xFFFFFF) != rgb) return false;
+        }
+    }
+    return true;
+}
+
+inline std::vector<uint32_t> Register(std::span<const uint8_t> indices, std::span<const uint32_t> donor) {
+    if (indices.size() != kSize*kSize || donor.size() != kDonorWidth*kDonorHeight) return {};
+    constexpr int outputSize = kSize*2;
+    std::vector<uint32_t> output(outputSize*outputSize);
+    for (int y = 0; y < outputSize; ++y) {
+        for (int x = 0; x < outputSize; ++x) {
+            if (!indices[(y/2)*kSize + x/2]) continue;
+            // The integer fit projects each of the two output samples per native axis.
+            const int rawX = 2073*(2*x-1) - 4*3508 + 2000;
+            const int rawY = 2249*(2*y-1) - 4*4654 + 2000;
+            if (rawX < 0 || rawY < 0 || rawX/4000 >= kDonorWidth || rawY/4000 >= kDonorHeight) return {};
+            const uint32_t color = donor[(rawY/4000)*kDonorWidth + rawX/4000];
+            if (color>>24 != 255) return {};
+            output[y*outputSize+x] = color;
+        }
+    }
+    return output;
+}
+}
