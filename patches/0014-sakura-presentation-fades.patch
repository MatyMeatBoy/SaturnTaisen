+inline uint32_t OffsetBackdropPixel(uint32_t pixel,const std::array<int16_t,3>& offset) {
+    uint32_t result=0xFF000000u;
+    for(unsigned channel=0;channel<3;channel++) {
+        const int value=int((pixel>>(channel*8))&255)+offset[channel];
