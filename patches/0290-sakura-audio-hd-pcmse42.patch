+namespace port {
+class Pcm42Projection {
+public:
+    static constexpr std::size_t nativeLength = 11096;
+    static constexpr std::uint64_t nativeFingerprint = 0xb5d0ddee6fec411dULL;
+    static constexpr std::uint64_t pcFingerprint = 0x41a6fcf48f997315ULL;
+    static constexpr std::size_t pcFileBytes = 31020;
+    static constexpr std::uint32_t ringStep = 8191;
+    static constexpr std::uint16_t pcLead = 392; // Provisional alignment, driven by measured source lag.
+
+    // All values are observations of the existing guest state, never written back.
+    struct NativePoint {
+        unsigned slot;
+        std::uint32_t address;
+        std::uint32_t cursor;
+        unsigned fraction; // SCSP interpolator's six-bit position.
+        std::int16_t wave1;
+        std::int16_t wave2;
+        unsigned finalLevel;
+        bool direct;
+        bool interpolate;
+        std::span<const std::uint8_t> ringWindow; // At the fetched native cursor.
+    };
+
+    static std::uint64_t Fingerprint(std::span<const std::uint8_t> bytes) {
+        std::uint64_t hash = 0xcbf29ce484222325ULL;
+        for (auto byte : bytes)
+            hash = (hash ^ byte) * 0x100000001b3ULL;
+        return hash;
+    }
+
+    // Decode and pin the owner WAV outside the audio loop.
+    bool Load(const std::filesystem::path& path) {
+        Clear();
+        donor.clear();
+        std::ifstream input(path, std::ios::binary | std::ios::ate);
+        if (!input || input.tellg() != static_cast<std::streamoff>(pcFileBytes))
+            return false;
+        std::array<std::uint8_t, pcFileBytes> bytes{};
+        input.seekg(0);
+        if (!input.read(reinterpret_cast<char*>(bytes.data()), bytes.size()) ||
+            Fingerprint(bytes) != pcFingerprint)
+            return false;
+        // This exact RIFF has one PCM mono 16-bit 22,050 Hz data chunk.
+        constexpr std::size_t pcmOffset = 44;
+        donor.reserve((bytes.size() - pcmOffset) / 2);
+        for (std::size_t i = pcmOffset; i + 1 < bytes.size(); i += 2) {
+            const unsigned value = bytes[i] | (unsigned(bytes[i + 1]) << 8);
+            donor.push_back(static_cast<std::int16_t>(value < 32768 ? int(value) : int(value) - 65536));
+        }
+        return true;
+    }
+
+    void Clear() { armed.reset(); }
+
+    void Stop(unsigned slot) {
+        if (armed && armed->slot == slot)
+            Clear();
+    }
+
+    // Caller additionally verifies PCM8, forward loop 0..8191, 1485 FNS,
+    // OCT=-2, no FM/LFO/XOR, and DSP send zero in the live SCSP Slot.
+    bool Start(unsigned slot, std::uint32_t address,
+               std::span<const std::uint8_t> staging,
+               std::span<const std::uint8_t> firstRingPage) {
+        Stop(slot);
+        if (donor.empty() || address != 0x7dff0 || staging.size() != nativeLength ||
+            firstRingPage.size() != 1024 || Fingerprint(staging) != nativeFingerprint ||
+            !std::equal(firstRingPage.begin(), firstRingPage.end(), staging.begin()))
+            return false;
+        std::copy(staging.begin(), staging.end(), native.begin());
+        armed = Cursor{slot, address};
+        return true;
+    }
+
+    std::optional<std::int16_t> Project(const NativePoint& p) {
+        if (!armed || armed->slot != p.slot)
+            return std::nullopt;
+        if (p.address != armed->address || p.cursor > ringStep || p.fraction > 63 || p.finalLevel > 1023) {
+            Clear();
+            return std::nullopt;
+        }
+
+        if (p.cursor < armed->position) {
+            if (armed->position < ringStep - 1 || p.cursor > 1) {
+                Clear();
+                return std::nullopt;
+            }
+            armed->base += ringStep;
+        }
+        armed->position = p.cursor;
+        const std::uint32_t global = armed->base + p.cursor;
+        if (global >= nativeLength - 1) {
+            Clear();
+            return std::nullopt;
+        }
+
+        // The game may zero or replace a page while the slot is still active.
+        // Require the sample actually fetched by the chip to agree with the
+        // expected source at this phase before substituting the direct mix.
+        constexpr std::size_t witnessLength = 16;
+        if (p.ringWindow.size() != witnessLength || global + witnessLength > nativeLength ||
+            !std::equal(p.ringWindow.begin(), p.ringWindow.end(), native.begin() + global) ||
+            p.wave1 != SignedPcm8(native[global]) ||
+            (p.interpolate && p.wave2 != SignedPcm8(native[global + 1])))
+            return std::nullopt;
+
+        // 22050 / (44100 * 1485 / 4096) = 2048 / 1485.
+        constexpr std::uint32_t denominator = 64 * 1485;
+        const std::uint32_t offset = (global * 64 + p.fraction) * 2048;
+        const auto index = pcLead + offset / denominator;
+        if (index + 1 >= donor.size())
+            return std::nullopt;
+        const auto fraction = static_cast<std::int32_t>(offset % denominator);
+        std::int32_t wave = donor[index] +
+            static_cast<std::int32_t>((std::int64_t{donor[index + 1]} - donor[index]) *
+                                      fraction / denominator);
+        if (!p.direct)
+            wave = (wave * static_cast<std::int32_t>((p.finalLevel & 63) ^ 127)) >>
+                ((p.finalLevel >> 6) + 7);
+        return static_cast<std::int16_t>(wave);
+    }
+
+private:
+    static constexpr int SignedPcm8(std::uint8_t value) {
+        return (value < 128 ? static_cast<int>(value) : static_cast<int>(value) - 256) * 256;
+    }
+
+    struct Cursor {
+        unsigned slot;
+        std::uint32_t address;
+        std::uint32_t position = 0;
+        std::uint32_t base = 0;
+    };
+    std::optional<Cursor> armed;
+    std::array<std::uint8_t, nativeLength> native{};
+    std::vector<std::int16_t> donor;
+};
+} // namespace port
