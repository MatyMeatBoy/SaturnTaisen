+
+void Chip::ProjectVoice(const Slot& slot) {
+    if (!slot.active || !CanProject())
+        return;
+    const auto projected = projectDirectVoice(slot);
+    if (!projected)
+        return;
+    std::array<sint32, 2> original{};
+    MixInto(original, slot.output, slot.directSendLevel, slot.directPan);
+    MixInto(m_presentationDelta, *projected, slot.directSendLevel, slot.directPan);
+    m_presentationDelta[0] -= original[0];
+    m_presentationDelta[1] -= original[1];
+}
