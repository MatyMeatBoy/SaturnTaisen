diff --git a/port/bg2248_verified_pan.h b/port/bg2248_verified_pan.h
new file mode 100644
--- /dev/null
+++ b/port/bg2248_verified_pan.h
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+#include "bg2533_verified_pan.h"
+
+namespace port {
+inline constexpr unsigned kBG2248Width = 288;
+inline constexpr unsigned kBG2248Height = 296;
+inline constexpr unsigned kBG2248InsetHeight = 144;
+inline constexpr size_t kBG2248Bytes = 91936;
+inline constexpr uint64_t kBG2248Palette = 0xF0AFCDD75EBA9DA2ull;
+// The first uniquely named cell is one tile past the atlas start.
+inline constexpr uint64_t kBG2248Cells = 0xD434BC45B629CEC4ull;
+
+inline std::optional<unsigned> FindBG2248Offset(std::span<const uint32_t> picture,
+                                               std::span<const uint32_t> frame,
+                                               std::span<const uint8_t> topSource) {
+    if (picture.size() != kBG2248Width * kBG2248Height ||
+        frame.size() != kPanFrameWidth * kPanFrameHeight || topSource.size() != frame.size()) return {};
+    const auto agrees = [&](unsigned start, unsigned x, unsigned y) {
+        const auto at = (y + kPanPictureOffsetY) * kPanFrameWidth + x + kPanPictureOffsetX;
+        return topSource[at] == 4 &&
+               (frame[at] & 0xFFFFFF) == picture[(start + y) * kBG2248Width + x];
+    };
+    std::optional<unsigned> result;
+    for (unsigned offset = 0; offset <= kBG2248Height - kBG2248InsetHeight; ++offset) {
+        if (!agrees(offset, 17, 13) || !agrees(offset, 139, 77) || !agrees(offset, 247, 114)) continue;
+        bool verified = true;
+        for (unsigned y = 0; y < kBG2248InsetHeight && verified; ++y) {
+            for (unsigned x = 0; x < kBG2248Width; ++x) {
+                if (!agrees(offset, x, y)) {
+                    verified = false;
+                    break;
+                }
+            }
+        }
+        if (!verified) continue;
+        if (result) return {};
+        result = offset;
+    }
+    return result;
+}
+}
