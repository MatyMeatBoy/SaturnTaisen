diff --git a/port/presentation_layout.h b/port/presentation_layout.h
index 091d188..44e00bf 100644
--- a/port/presentation_layout.h
+++ b/port/presentation_layout.h
@@ -3,7 +3,51 @@
 #include "integer_viewport.h"
 #include <cstdint>
 #include <vector>
+#include <span>
 namespace port {
+inline IntegerViewport FitAnchoredBackdrop(int width,int height) {
+    const auto native=FitInteger(width,height,320,224);
+    if(!native.scale)return {};
+    return {native.x-240*native.scale,native.y-113*native.scale,800*native.scale,450*native.scale,native.scale};
+}
+// Each sixteen-pixel border defines its own eight-pixel horizontal period.
+// The night gradient's left and right edges differ on a few dithered rows.
+inline bool AnalyzeRowBackdrop(std::span<const uint32_t> pixels,std::span<const uint8_t> source,std::vector<uint32_t>& rows) {
+    rows.clear();
+    if(pixels.size()!=320*224 || source.size()!=320*224)return false;
+    std::vector<uint32_t> prepared;prepared.reserve(224*16);
+    for(unsigned y=0;y<224;y++) {
+        unsigned period=0;
+        for(unsigned candidate:{2u,4u,8u}) {
+            bool valid=true;
+            for(unsigned x=0;x<candidate*2;x++) {
+                const unsigned right=320-candidate*2;
+                if(source[y*320+x]==0 || source[y*320+right+x]==0 ||
+                   (pixels[y*320+x]&0xFFFFFF)!=(pixels[y*320+x%candidate]&0xFFFFFF) ||
+                   (pixels[y*320+right+x]&0xFFFFFF)!=(pixels[y*320+right+x%candidate]&0xFFFFFF)) {valid=false;break;}
+            }
+            if(valid) {period=candidate;break;}
+        }
+        if(!period) {
