+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <array>
+#include <algorithm>
+#include <cstdint>
+#include <span>
+namespace port {
+inline bool KeepStage01Sprite(unsigned kind,unsigned mode,unsigned color,int worldX,int worldY,uint64_t hash) {
+    // Eight witnessed frames of the decorative water puffs on the right map
+    // fringe. Keep unknown effects, units and the same effect elsewhere.
+    constexpr std::array<uint64_t,8> water={0x2B12B3C4BC5A3266ull,0x31596952E57E90AFull,
+        0x8FF506B0E9C8FF57ull,0x6C5340F6F05A5A8Bull,0x038BFCCD7E3523FCull,
+        0x1AEF849C0DBDEFD9ull,0x00A6A1047D3ECE74ull,0x9FCEC67765CA50E2ull};
+    return kind!=2 || mode!=0x80 || color!=0x2500 || worldX<608 || worldX>=672 || worldY<32 || worldY>=128 ||
+        std::find(water.begin(),water.end(),hash)==water.end();
+}
+inline bool ApplyTacticalExtension(std::span<uint32_t> canvas,unsigned width,
+    std::span<const uint8_t> nativeSource,unsigned extra,
+    std::span<const std::array<uint32_t,2>> world,std::span<const uint32_t> patch,
+    unsigned patchWidth,unsigned patchHeight,unsigned patchX,unsigned patchY,std::array<int16_t,3> offset={},std::span<const uint8_t> wideSprites={}) {
+    if(width!=320+2*extra || extra>64 || world.size()!=224 || nativeSource.size()!=320*224 ||
+       canvas.size()!=size_t(width)*224 || !patchWidth || !patchHeight ||
+       patchWidth>1024 || patchHeight>1024 || patch.size()!=size_t(patchWidth)*patchHeight)return false;
+    if(!wideSprites.empty() && wideSprites.size()!=canvas.size())return false;
+    for(unsigned y=0;y<224;y++) {
+        if(world[y][1]<patchY || world[y][1]-patchY>=patchHeight)continue;
+        for(unsigned x=0;x<width;x++) {
+            const uint64_t wx=uint64_t(world[y][0])+x;
+            if(wx<patchX || wx-patchX>=patchWidth)continue;
+            if(!wideSprites.empty() && wideSprites[y*width+x])continue;
+            if(x>=extra && x<extra+320 && nativeSource[y*320+x-extra]==0)continue;
+            const auto pixel=patch[(world[y][1]-patchY)*patchWidth+size_t(wx-patchX)];
+            uint32_t shifted=0xFF000000;
+            for(unsigned channel=0;channel<3;channel++)shifted|=uint32_t(std::clamp(int((pixel>>(channel*8))&255)+offset[channel],0,255))<<(channel*8);
+            canvas[y*width+x]=shifted;
+        }
+    }
+    return true;
+}
+}
