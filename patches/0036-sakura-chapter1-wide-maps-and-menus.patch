+    const auto savedContext=m_ctx;
+    auto* savedRaster=m_rasterFB;
+    const auto extra=sint32(m_captureScrollExtra);
+    m_ctx.localCoordX+=extra;
+    m_ctx.sysClipH=uint16(m_presentation.scrollWidth-1);
+    if(m_ctx.userClipX0==0 && m_ctx.userClipX1>=319) {
