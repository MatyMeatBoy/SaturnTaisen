@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <span>
+
+namespace port {
+
+struct TacticalMenuSprite {
+    uint64_t hash;
+    int x,y;
+    unsigned width,height,control,mode,color;
+
+    bool operator==(const TacticalMenuSprite&) const = default;
+};
+
+struct TacticalMenuLayout {
+    // Shift [frame,end) vertically and shorten only the frame.
+    size_t frame,end;
+    unsigned frameHeight;
+    int deltaY;
+};
+
+inline std::optional<TacticalMenuLayout> FindTacticalMenuLayout(std::span<const TacticalMenuSprite> sprites) {
+    // Disc 1, translated action labels in native Move/Atk/Def/Info/End order.
+    constexpr std::array<uint64_t,5> tabs{
+        0x9D8E240F6AB586BCull,0x75F0B7757F6FCC84ull,0x242ACB24C7364114ull,
+        0xACFE13240DF0957Cull,0xF91F81A1290CA869ull
+    };
+    constexpr std::array<std::array<uint64_t,3>,5> labels{{
+        {0x7FF4F719DAF08740ull}, {0x23ABA1E5F681994Bull,0xDC7CD3F64BAD9A36ull},
+        {0xB430B4DEFA5702F6ull,0xEE580AB839732AFFull,0x00396DF5443F4349ull},
+        {0x745709153803CE04ull,0xBA095F71BC2889B2ull,0xBAA90DCC46388B80ull},
+        {0x8F6274AF2C1E7779ull}
+    }};
+    constexpr std::array<unsigned,5> rows{1,2,3,3,1};
+    constexpr std::array<uint64_t,3> frames{
+        0x549B32456EF87DB3ull,0xD17D592842A221CDull,0xD46C77EFDE420A6Full
+    };
+    constexpr uint64_t disabledMove=0x4ACD7121B85349BDull;
+    constexpr uint64_t barHash=0x18FDBFE27D4349D5ull;
+    constexpr uint64_t markerHash=0x02175A89080041A4ull;
+
+    std::optional<TacticalMenuLayout> layout;
+    for(size_t start=0;start<sprites.size();++start) {
+        const auto& bar=sprites[start];
+        if(bar!=TacticalMenuSprite{barHash,bar.x,bar.y,96,32,0,0x88,0xFFEC} ||
+           bar.x<0 || bar.x>224 || bar.y<8 || bar.y>192 || sprites.size()-start<10)continue;
+        const auto group=sprites.subspan(start);
+        bool valid=true;
+        for(unsigned i=0;i<tabs.size();++i) {
+            const auto& label=group[i+1];
+            const auto hash=i==0 && label.hash==disabledMove?disabledMove:tabs[i];
+            if(label!=TacticalMenuSprite{hash,bar.x+8+16*int(i),bar.y+8,16,16,0,0x88,0xFFEC})valid=false;
+        }
+        if(!valid)continue;
+
+        const auto& popup=group[6];
+        const int offset=popup.x-bar.x;
+        if(offset<0 || offset>64 || offset%16)continue;
+        const auto tab=unsigned(offset/16);
+        const unsigned count=rows[tab],height=32+16*count;
+        const int top=bar.y+32-int(height);
+        if(group.size()<9+count || top<8 ||
+           popup!=TacticalMenuSprite{frames[count-1],popup.x,top,40,height,0,0x88,0xFFEC})continue;
+
+        const auto& marker=group[7];
+        const int tabX=popup.x+8,firstY=top+8;
+        if(marker!=TacticalMenuSprite{markerHash,tabX,marker.y,24,16,0,0x88,0xFFF0} ||
+           marker.y<firstY || marker.y>=firstY+16*int(count) || (marker.y-firstY)%16)continue;
+
+        for(unsigned row=0;row<count;++row)
+            if(group[8+row]!=TacticalMenuSprite{labels[tab][row],tabX,firstY+16*int(row),24,16,0,0x88,0xFFEC})valid=false;
+        if(!valid || group[8+count]!=group[tab+1])continue;
+
+        // The final 24 rows draw the join over the bar. The upper frame's
+        // complete lower edge survives the crop and ends where the bar begins.
+        if(layout)return std::nullopt;
+        layout=TacticalMenuLayout{start+6,start+8+count,height-24,-8};
+    }
+    return layout;
+}
+
+} // namespace port
