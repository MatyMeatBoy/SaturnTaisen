+void ProbePcEdition(launcher::PageContext& page, SetupState& s) {
+    if (s.pcProbe) {
+        if (s.pcProbe->running()) {
+            ui::request_frames(2);
+            return;
+        }
+        s.pcFound=s.pcProbe->exit_code()==0;
+        s.pcProbe.reset();
+        s.nextPcProbe=SDL_GetTicks()+15000;
+        return;
+    }
+    if (SDL_GetTicks()<s.nextPcProbe) return;
+    const auto folder=DiscsFolder(page.program_folder);
+    std::vector<std::string> args={"find-pc"};
+    std::error_code ec;
+    if (s.source[0] && std::filesystem::exists(std::filesystem::u8path(s.source.data()),ec))
+        args.insert(args.end(),{"--rom",s.source.data()});
+    if (!folder.empty()) args.insert(args.end(),{"--folder",Utf8(folder)});
+    s.nextPcProbe=SDL_GetTicks()+15000;
+    if (args.size()==1) {s.pcFound=false;return;}
+    std::string error;
+    s.pcProbe=std::make_unique<GameProcess>();
+    if (!s.pcProbe->start(page.program_folder/"preparar-juego.exe",args,page.program_folder,error))
+        s.pcProbe.reset();
+    else ui::request_frames(2);
+}
