diff --git a/port/panel_compositing.h b/port/panel_compositing.h
new file mode 100644
index 0000000..29ab85a
--- /dev/null
+++ b/port/panel_compositing.h
@@ -0,0 +1,52 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <span>
+#include <optional>
+
+namespace port {
+
+// The renderer should supply a recipe only for verified two-screen ratio mixing
+// with the replaceable background below the panel. A weight of zero means keep
+// the native composited pixel.
+struct PanelMix {
+    uint32_t topRgb = 0;
+    uint8_t lowerWeight = 0;
+    std::array<int16_t, 3> postMixOffset{};
+};
+
+// Colors are packed with red in the low byte. The background source is sampled
+// at the destination and supplied before color offsets. The hardware truncates
+// the blend in units of 1/32, then applies the top screen's signed offset.
+constexpr uint32_t CompositePanelPixel(const PanelMix& recipe, uint32_t unshiftedBackdrop,
+                                       uint32_t nativePixel) noexcept {
+    const unsigned lower = recipe.lowerWeight;
+    if (!lower || lower > 32 ||
+        std::any_of(recipe.postMixOffset.begin(), recipe.postMixOffset.end(),
+                    [](int component) { return component < -256 || component > 255; })) {
+        return nativePixel;
+    }
+
+    uint32_t result = 0xFF000000u;
+    for (unsigned channel = 0; channel < 3; ++channel) {
+        const unsigned shift = channel * 8;
+        const unsigned top = (recipe.topRgb >> shift) & 255;
+        const unsigned below = (unshiftedBackdrop >> shift) & 255;
+        const int blended = int((top * (32 - lower) + below * lower) >> 5);
+        const int shifted = std::clamp(blended + recipe.postMixOffset[channel], 0, 255);
+        result |= uint32_t(shifted) << shift;
+    }
+    return result;
+}
+
+inline std::optional<uint32_t> SamplePanelBackdrop(std::span<const uint32_t> pixels,
+        int width,int height,int originX,int originY,int scale,int screenX,int screenY) {
+    if(width<=0 || height<=0 || scale<=0 || size_t(width)*size_t(height)!=pixels.size())return {};
+    const int64_t dx=int64_t(screenX)-originX,dy=int64_t(screenY)-originY;
+    if(dx<0 || dy<0 || dx>=int64_t(width)*scale || dy>=int64_t(height)*scale)return {};
+    return pixels[size_t(dy/scale)*size_t(width)+size_t(dx/scale)];
+}
+} // namespace port
