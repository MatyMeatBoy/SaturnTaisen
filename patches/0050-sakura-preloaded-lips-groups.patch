new file mode 100644
index 0000000..c1ba33c
--- /dev/null
+++ b/port/choice_reveal.h
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+#include "dialogue_preload.h"
+
+namespace port {
+
+inline const PreloadedDialogueLine* PreloadedChoiceLine(const PreloadedDialogueRecord& record, int y) {
+    constexpr std::array<int, 2> twoRows{62, 94};
+    constexpr std::array<int, 3> threeRows{54, 78, 102};
+    if (!record.simple || (record.lineCount != 2 && record.lineCount != 3)) return nullptr;
+    const auto rows = record.lineCount == 2 ? std::span<const int>(twoRows) : std::span<const int>(threeRows);
+    const auto at = std::find(rows.begin(), rows.end(), y);
+    if (at == rows.end()) return nullptr;
+    const auto& line = record.lines[static_cast<size_t>(at - rows.begin())];
+    return line.text.empty() || line.text.size() > 31 ? nullptr : &line;
+}
+
+// A matching tile identifies one cell. The caller still validates the complete native panel.
+inline char32_t ExpectedPreloadedChoiceGlyph(const PreloadedDialogueRecord& record, int x, int y,
+        std::span<const uint8_t> atlas, std::span<const uint8_t> tile) {
+    if (atlas.size() != 32768 || tile.size() != 128) return 0;
+    const auto* line = PreloadedChoiceLine(record, y);
+    if (!line) return 0;
+    const int width = static_cast<int>(line->text.size()) * 8;
+    const int left = (336 - width) / 2;
+    if (x < left || x >= left + width || (x - left) % 8) return 0;
+    const auto column = static_cast<size_t>((x - left) / 8);
+    if (line->rawOffset > record.raw.size() || column >= record.raw.size() - line->rawOffset) return 0;
+    const auto byte = static_cast<uint8_t>(record.raw[line->rawOffset + column]);
+    const char32_t character = GlyphCodepoint(byte);
+    if (!character || character != line->text[column]) return 0;
+    const size_t atlasOffset = static_cast<size_t>(byte - 1) * tile.size();
+    return std::memcmp(atlas.data() + atlasOffset, tile.data(), tile.size()) == 0 ? character : 0;
+}
+
+} // namespace port
