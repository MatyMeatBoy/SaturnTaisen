new file mode 100644
index 0000000..8b9dc90
--- /dev/null
+++ b/port/choice_preload.h
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+#include "dialogue_preload.h"
+
+#include <unordered_map>
+
+namespace port {
+
+class ChoicePreload {
+public:
+    static constexpr size_t MaxScripts = 128;
+    static constexpr size_t MaxScriptBytes = 128 * 1024;
+    static constexpr size_t MaxSourceBytes = 8 * 1024 * 1024;
+    static constexpr size_t MaxCommands = 65535;
+
+    bool Add(std::string name, std::span<const uint8_t> bytes, size_t tableIndex,
+             const DialoguePreload& catalog) {
+        const auto tables = catalog.Tables();
+        if (sealed_ || name.empty() || scripts_.size() >= MaxScripts || tableIndex >= tables.size() ||
+            bytes.size() < CommandSize || bytes.size() > MaxScriptBytes ||
+            bytes.size() > MaxSourceBytes - sourceBytes_ ||
+            std::any_of(scripts_.begin(), scripts_.end(), [&](const auto& script) { return script.name == name; }))
+            return false;
+
+        const auto& table = tables[tableIndex];
+        std::unordered_map<uint32_t, const PreloadedDialogueRecord*> byId;
+        for (const auto& record : table.records) {
+            if (record.id > 0xffff) continue;
+            const auto [entry, unique] = byId.emplace(record.id, &record);
+            if (!unique) entry->second = nullptr;
+        }
+
+        Script script;
+        script.name = std::move(name);
+        script.tableIndex = static_cast<uint32_t>(tableIndex);
+        script.tableFingerprint = table.fingerprint;
+        for (size_t offset = 0; offset <= bytes.size() - CommandSize; ++offset) {
+            if (bytes[offset] != 0x2e || bytes[offset + 1] != 0x80 || bytes[offset + 2] != 0) continue;
+            const auto id = uint32_t(bytes[offset + 3]) << 8 | bytes[offset + 4];
+            const auto entry = byId.find(id);
+            if (entry == byId.end() || !IsChoice(entry->second)) continue;
+            if (script.commands.size() == MaxCommands - commandCount_) return false;
+            script.commands.push_back({static_cast<uint32_t>(offset + CommandSize), entry->second->index, id});
+        }
+        if (script.commands.empty()) return false;
+        script.bytes.assign(bytes.begin(), bytes.end());
+        const size_t added = script.commands.size();
+        scripts_.push_back(std::move(script));
+        commandCount_ += added;
+        sourceBytes_ += bytes.size();
+        return true;
+    }
+
+    void Seal() { sealed_ = true; }
+    size_t Commands() const { return commandCount_; }
+
+    DialogueWitness Locate(std::span<const uint8_t> low, std::span<const uint8_t> high,
+                           const DialoguePreload& catalog) const {
+        constexpr size_t bankSize = 0x100000, scriptAt = 0x4000, tableAt = 0x24000, cursorAt = 0x685b4;
+        constexpr uint32_t scriptAddress = 0x00204000;
+        if (!sealed_ || low.size() != bankSize || high.size() != bankSize) return {};
+        const uint32_t cursor = uint32_t(high[cursorAt]) << 24 | uint32_t(high[cursorAt + 1]) << 16 |
+                                uint32_t(high[cursorAt + 2]) << 8 | high[cursorAt + 3];
+        if (cursor < scriptAddress + CommandSize || cursor - scriptAddress > MaxScriptBytes) return {};
+        const uint32_t offset = cursor - scriptAddress;
+        const auto residentScript = low.subspan(scriptAt, MaxScriptBytes);
+        if (residentScript[offset - CommandSize] != 0x2e || residentScript[offset - CommandSize + 1] != 0x80 ||
+            residentScript[offset - CommandSize + 2] != 0) return {};
+
+        const Script* match = nullptr;
+        for (const auto& script : scripts_) {
+            if (offset > script.bytes.size() ||
+                std::memcmp(residentScript.data(), script.bytes.data(), script.bytes.size()) != 0) continue;
+            if (match) return {};
+            match = &script;
+        }
+        if (!match) return {};
+        const auto command = std::lower_bound(match->commands.begin(), match->commands.end(), offset,
+            [](const auto& entry, uint32_t address) { return entry.cursor < address; });
+        if (command == match->commands.end() || command->cursor != offset) return {};
+
+        const auto tables = catalog.Tables();
+        if (match->tableIndex >= tables.size()) return {};
+        const auto& table = tables[match->tableIndex];
+        if (table.fingerprint != match->tableFingerprint || table.bytes.size() > low.size() - tableAt ||
+            std::memcmp(low.data() + tableAt, table.bytes.data(), table.bytes.size()) != 0) return {};
+
+        const DialogueWitness witness{true, match->tableIndex, command->record, 0};
+        const auto* record = catalog.Get(witness);
+        return IsChoice(record) && record->id == command->id ? witness : DialogueWitness{};
+    }
+
+private:
+    static constexpr size_t CommandSize = 9;
+    struct Command { uint32_t cursor, record, id; };
+    struct Script {
+        std::string name;
+        std::vector<uint8_t> bytes;
+        std::vector<Command> commands;
+        uint32_t tableIndex = 0;
+        uint64_t tableFingerprint = 0;
+    };
+
+    static bool IsChoice(const PreloadedDialogueRecord* record) {
+        if (!record || !record->simple || (record->lineCount != 2 && record->lineCount != 3)) return false;
+        for (size_t i = 0; i < record->lineCount; ++i)
+            if (record->lines[i].text.empty()) return false;
+        return true;
+    }
+
+    std::vector<Script> scripts_;
+    size_t sourceBytes_ = 0, commandCount_ = 0;
+    bool sealed_ = false;
+};
+
+} // namespace port
