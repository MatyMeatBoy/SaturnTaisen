+    struct GeneralEndingPlate {
+        unsigned layer;
+        size_t paletteOffset;
+        uint64_t palette;
+        uint64_t cells;
+        port::EveRect crop;
+    };
+    constexpr std::array generalEndingPlates{
+        GeneralEndingPlate{2, 0xE00, 0x43B52AFDA867E289ull, 0xCE3978CE1026E2BBull, {24, 16, 600, 440}},
+        GeneralEndingPlate{3, 0x400, 0xD35E9533F1B206BFull, 0xD279F004AA17CB7Full, {0, 16, 640, 448}},
+        GeneralEndingPlate{2, 0x200, 0x4B95A19805DC92DBull, 0x8486F362F9BE9417ull, {0, 16, 640, 448}},
+        GeneralEndingPlate{3, 0x400, 0xE9B373C88E94A067ull, 0x2739C4C7E94EB262ull, {0, 16, 640, 448}},
+    };
+    using GeneralEndingImages = std::array<std::vector<uint32_t>, generalEndingPlates.size()>;
+    constexpr unsigned generalEndingWidth = 640, generalEndingHeight = 448;
+    GeneralEndingImages generalEndingImages;
+    std::future<GeneralEndingImages> generalEndingPending;
+    bool generalEndingTried = false;
+    std::vector<uint32_t> generalEndingMixed;
+    std::vector<uint32_t> generalEndingOverlay;
