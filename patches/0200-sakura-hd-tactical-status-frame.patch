new file mode 100644
--- /dev/null
+++ b/port/tactical_status_frame.h
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+
+#include "item_card_table.h"
+
+namespace port {
+inline constexpr int kStatusFrameWidth = 96;
+inline constexpr int kStatusFrameHeight = 64;
+inline constexpr uint32_t kStatusFrameLutAddress = 0xFFEC * 8;
+inline constexpr ItemCardEntry kStatusFrame{
+    0xB9C4311ED95D0FC1ull, 0x316D5850CBF9E6ADull, "SAKURA2/SYSTEM/SLGSYS03.SPR", 0,
+};
+inline constexpr ItemCardEntry kStatusFrameBright = kStatusFrame;
+
+inline bool IsStatusFrame(const ItemCardEntry* entry) {
+    return entry == &kStatusFrame || entry == &kStatusFrameBright;
+}
+
+inline bool IsStatusFrameBorder(unsigned x, unsigned y) {
+    // The portrait, name and meters sit inside the two stepped wells.
+    return x < 8 || y < 8 || y >= 56 ||
+           (x >= 47 && (y < 24 || x >= 88 || y >= 54));
+}
+} // namespace port
