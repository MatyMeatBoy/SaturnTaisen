diff --git a/launcher/CMakeLists.txt b/launcher/CMakeLists.txt
--- a/launcher/CMakeLists.txt
+++ b/launcher/CMakeLists.txt
@@ -46,6 +46,12 @@
 set(GAME_COMBOS "")
 set(GAME_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../../games/${GAME_EXE}" CACHE PATH "The game's directory (game.cfg)")
 set(GAME_CFG "${GAME_DIR}/game.cfg")
+if(WIN32 AND GAME_EXE STREQUAL "sakura" AND EXISTS "${GAME_DIR}/windows.rc.in")
+    enable_language(RC)
+    configure_file("${GAME_DIR}/windows.rc.in" "${CMAKE_CURRENT_BINARY_DIR}/SaturnTaisen.rc" @ONLY)
+    target_sources(launcher PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/SaturnTaisen.rc")
+endif()
+
 if (EXISTS "${GAME_CFG}")
     file(STRINGS "${GAME_CFG}" GAME_COMBOS REGEX "^combos[ \t]*=")
     string(REGEX REPLACE "^combos[ \t]*=[ \t]*" "" GAME_COMBOS "${GAME_COMBOS}")
