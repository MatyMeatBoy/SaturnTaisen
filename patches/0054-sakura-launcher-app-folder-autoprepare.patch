+// The window's title bar in the launcher's own colours instead of the system grey/white (Windows 11; older
+// systems ignore the request and keep their usual bar). dwmapi is loaded on demand: nothing new to link.
+void match_title_bar(SDL_Window* window) {
+    HWND hwnd = static_cast<HWND>(SDL_GetPointerProperty(SDL_GetWindowProperties(window), SDL_PROP_WINDOW_WIN32_HWND_POINTER, nullptr));
+    HMODULE dwm = hwnd ? LoadLibraryW(L"dwmapi.dll") : nullptr;
+    if (!dwm) {
+        return;
+    }
+    using SetAttribute = HRESULT(WINAPI*)(HWND, DWORD, LPCVOID, DWORD);
+    auto set = reinterpret_cast<SetAttribute>(reinterpret_cast<void*>(GetProcAddress(dwm, "DwmSetWindowAttribute")));
+    if (set) {
+        const ui::Palette& p = ui::palette();
+        auto colour = [](ImU32 c) -> DWORD { return c & 0x00FFFFFFu; };  // (ImGui's ABGR is Windows' 0x00BBGGRR)
+        const DWORD caption = colour(p.background), text = colour(p.text), border = colour(p.primary);
+        const DWORD corners = 2;  // (DWMWCP_ROUND)
+        set(hwnd, 35 /* DWMWA_CAPTION_COLOR */, &caption, sizeof caption);
+        set(hwnd, 36 /* DWMWA_TEXT_COLOR */, &text, sizeof text);
+        set(hwnd, 34 /* DWMWA_BORDER_COLOR */, &border, sizeof border);
+        set(hwnd, 33 /* DWMWA_WINDOW_CORNER_PREFERENCE */, &corners, sizeof corners);
+    }
+}
+// Built as a window program, the launcher has no console of its own. Started from a terminal it prints there
+// (--help, --integration-info); started by a frontend with its output redirected, that redirection is kept.
+void borrow_parent_console() {
+    const HANDLE out = GetStdHandle(STD_OUTPUT_HANDLE);
+    if (out && out != INVALID_HANDLE_VALUE && GetFileType(out) != FILE_TYPE_UNKNOWN) {
+        return;  // (a pipe or a file: already where the caller wants it)
+    }
+    if (AttachConsole(ATTACH_PARENT_PROCESS)) {
+        FILE* ignored = nullptr;
+        freopen_s(&ignored, "CONOUT$", "w", stdout);
+        freopen_s(&ignored, "CONOUT$", "w", stderr);
+    }
+}
+#else
+void match_title_bar(SDL_Window*) {}
+void borrow_parent_console() {}
+#endif
