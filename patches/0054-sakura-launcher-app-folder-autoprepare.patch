+// A thick progress bar in the launcher's strong colour while the helper works: the filled part follows the
+// helper's percentage and a light band sweeps across it all the time, so it is obvious that something is running.
+void WorkingBar(float width,float fraction) {
+    const auto& p=ui::palette();const float height=ui::px(14),round=height*.5f;
+    const ImVec2 at=ImGui::GetCursorScreenPos();
+    auto* draw=ImGui::GetWindowDrawList();
+    if(fraction<0)fraction=0;
+    if(fraction>1)fraction=1;
+    draw->AddRectFilled(at,at+ImVec2(width,height),ui::fade(p.primary,.18f),round);
+    const float filled=fraction<.03f?width*.03f:width*fraction;
+    draw->AddRectFilled(at,at+ImVec2(filled,height),p.primary,round);
+    // (the sweeping light, over the whole track)
+    const float cycle=static_cast<float>(SDL_GetTicks()%1400)/1400.0f,band=width*.18f;
+    const float x=-band+(width+band)*cycle;
+    draw->PushClipRect(at,at+ImVec2(width,height),true);
+    draw->AddRectFilledMultiColor(at+ImVec2(x,0),at+ImVec2(x+band*.5f,height),IM_COL32(255,255,255,0),IM_COL32(255,255,255,110),
+                                  IM_COL32(255,255,255,110),IM_COL32(255,255,255,0));
+    draw->AddRectFilledMultiColor(at+ImVec2(x+band*.5f,0),at+ImVec2(x+band,height),IM_COL32(255,255,255,110),IM_COL32(255,255,255,0),
+                                  IM_COL32(255,255,255,0),IM_COL32(255,255,255,110));
+    draw->PopClipRect();
+    draw->AddRect(at,at+ImVec2(width,height),p.primary,round,ui::px(1.2f));
+    ImGui::Dummy(ImVec2(width,height));
+    ui::request_frames(2); // (keep drawing while it works, not only on input)
+}
