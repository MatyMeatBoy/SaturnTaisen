+// The player's folder for their files: roms/ at the release root (beside the launcher, one level above data/
+// where the program folder is), or the earlier name discos/. Empty when there is none.
+std::filesystem::path DiscsFolder(const std::filesystem::path& program) {
+    std::error_code error;
+    auto here=program;
+    if(here.filename().empty())here=here.parent_path(); // (the program folder comes with a separator at its end)
+    for(const auto& folder:{here.parent_path()/"roms",here/"roms",here.parent_path()/"discos",here/"discos"})
+        if(std::filesystem::is_directory(folder,error))return folder;
+    return {};
+}
+// Whether the folder holds anything that looks like the player's discs or PC edition (two levels deep).
+bool HasGameFiles(const std::filesystem::path& folder) {
+    if(folder.empty())return false;
+    std::error_code error;
+    for(std::filesystem::recursive_directory_iterator it(folder,error),end;!error && it!=end;it.increment(error)) {
+        if(it.depth()>2) {it.disable_recursion_pending();continue;}
+        if(!it->is_regular_file(error))continue;
+        auto ext=it->path().extension().u8string();
+        for(auto& c:ext)c=static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+        if(ext==u8".cue"||ext==u8".bin"||ext==u8".iso"||ext==u8".img"||ext==u8".mdf"||ext==u8".zip"||ext==u8".cab")return true;
+    }
+    return false;
+}
