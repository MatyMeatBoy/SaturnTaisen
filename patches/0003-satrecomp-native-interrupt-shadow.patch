diff --git a/runtime/access.h b/runtime/access.h
index 954c478..72a6b8f 100644
--- a/runtime/access.h
+++ b/runtime/access.h
@@ -96,6 +96,9 @@ struct Access {
     static bool InterruptRaised(SH2 &c) {
         return c.m_intrFlags.pending;
     }
+    static bool InterruptReady(SH2 &c) {
+        return c.m_intrFlags.pending && c.m_intrFlags.allow;
+    }
     static void AddCycles(SH2 &c, uint64_t cycles) {
         c.m_cyclesExecuted += cycles;
     }
diff --git a/runtime/block_native.h b/runtime/block_native.h
index f3fb380..84fdec6 100644
--- a/runtime/block_native.h
+++ b/runtime/block_native.h
@@ -84,6 +84,8 @@ using Native = BlockSet<-1>;
     uint32 pc = entry;                              \
     uint64 base = c.m_cyclesExecuted;               \
     bool hw = false;                                \
+    bool initial_shadow = c.m_intrFlags.pending && !c.m_intrFlags.allow; \
+    (void)initial_shadow;                            \
     (void)hw;                                       \
     (void)target;
 
diff --git a/tools/recomp.py b/tools/recomp.py
