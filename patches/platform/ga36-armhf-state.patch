 // Save states: the sound chip's and its CPU's part (runtime/state.h).
+#include <cstddef>
+
 #include "chip.h"
 #include "m68k.h"
 
@@ -30,7 +32,17 @@
     ar.Mark(0x53435350);
     ar.Pod(m_slots);
     uint8 *ram = m_dsp.m_WRAM;
+#if defined(__arm__) && UINTPTR_MAX == UINT32_MAX
+    // Version 9 states reserve the 64-bit layout for the unsaved WRAM address.
+    // ARMv7 uses a 4-byte host pointer. Preserve the file layout and skip its value.
+    constexpr size_t dspFields = offsetof(Dsp, m_WRAM);
+    static_assert(dspFields == 2076 && sizeof(Dsp) == 2080);
+    ar.Bytes(&m_dsp, dspFields);
+    uint8_t pointerSlot[2088 - dspFields]{};
+    ar.Pod(pointerSlot);
+#else
     ar.Pod(m_dsp);
+#endif
     m_dsp.m_WRAM = ram; // (where sound RAM is does not come from the state)
     ar.Pod(m_soundStack);
     ar.Pod(m_soundStackIndex);
