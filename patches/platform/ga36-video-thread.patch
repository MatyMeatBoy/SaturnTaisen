diff --git b/machine/video_thread.h b/machine/video_thread.h
new file mode 100644
index 0000000..44d5950
--- /dev/null
+++ b/machine/video_thread.h
@@ -0,0 +1,211 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// SaturnTaisen GA36: the renderer on a core of its own (SATRECOMP_VIDEO_THREAD=1).
+//
+// The machine tells the renderer what happens (registers written, lines reached, commands to draw) and never
+// asks it anything back while a frame runs, so those calls can wait in a queue that a second thread works
+// through in order, a few lines behind the CPUs. The renderer then reads its own copies of VDP1 VRAM, VDP2
+// VRAM and colour RAM, which the same queue keeps up to date: whatever a line is drawn with is exactly what
+// the machine had written by then. The VDP1 framebuffers stay shared: only the renderer touches them during a
+// frame, and a CPU access to them first waits for the queue to empty.
+//
+// Outside the machine's own calls (RunFrame, Reset, Serialize) the queue is always empty, and the frame's
+// picture is handed over (EndFrame) on the machine's thread, so the port sees the renderer as before.
+#pragma once
+
+#include "../video/renderer.h"
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace satrecomp::machine::vt {
+
+enum Op : uint8_t {
+    kVdp1Reg, kVdp2Reg, kErase, kSwap, kBeginDrawing, kDraw, kEndDrawing, kResolution, kField, kLatch,
+    kBeginFrame, kLine, kVram1Write8, kVram1Write16, kVram2Write8, kVram2Write16, kCramWrite8, kCramWrite16,
+};
+
+struct Command {
+    uint8_t op;
+    uint8_t flag;
+    uint16_t value;
+    uint32_t a;
+    uint64_t c;
+};
+static_assert(sizeof(Command) == 16);
+
+inline void Put16(uint8_t *p, uint16_t v) {
+    p[0] = static_cast<uint8_t>(v >> 8);
+    p[1] = static_cast<uint8_t>(v);
+}
+
+class VideoThread {
+public:
+    static constexpr uint32_t kSize = 1u << 16; // commands (1 MiB)
+
+    std::vector<uint8_t> vram1, vram2, cram; // the renderer's copies
+    video::Renderer *renderer = nullptr;
+    uint64_t commands = 0, syncs = 0, waitNs = 0, busyNs = 0, fullWaits = 0;
+
+    VideoThread() : vram1(0x80000), vram2(0x80000), cram(0x1000), m_ring(kSize) {}
+    ~VideoThread() { Stop(); }
+
+    void Start(video::Renderer &r) {
+        renderer = &r;
+        m_thread = std::thread([this] { Work(); });
+    }
+    void Stop() {
+        if (!m_thread.joinable()) return;
+        Sync();
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_stop.store(true);
+        }
+        m_wake.notify_one();
+        m_thread.join();
+    }
+
+    void Push(uint8_t op, uint32_t a = 0, uint64_t c = 0, uint16_t value = 0, uint8_t flag = 0) {
+        const uint32_t head = m_head.load(std::memory_order_relaxed);
+        if (head - m_tail.load(std::memory_order_acquire) >= kSize) [[unlikely]] {
+            fullWaits++;
+            while (head - m_tail.load(std::memory_order_acquire) >= kSize) Relax();
+        }
+        Command &cmd = m_ring[head & (kSize - 1)];
+        cmd.op = op;
+        cmd.flag = flag;
+        cmd.value = value;
+        cmd.a = a;
+        cmd.c = c;
+        m_head.store(head + 1, std::memory_order_seq_cst);
+        commands++;
+        if (m_sleeping.load(std::memory_order_seq_cst)) [[unlikely]] {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_wake.notify_one();
+        }
+    }
+
+    // Until the renderer has done everything asked of it
+    void Sync() {
+        const uint32_t head = m_head.load(std::memory_order_relaxed);
+        if (m_done.load(std::memory_order_acquire) == head) return;
+        syncs++;
+        const auto start = std::chrono::steady_clock::now();
+        for (unsigned spins = 0; m_done.load(std::memory_order_acquire) != head; spins++) {
+            if (spins < 20000) Relax();
+            else std::this_thread::yield();
+        }
+        waitNs += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now() - start).count());
+    }
+
+    // The machine's video memory as it is now becomes the renderer's (after a reset or a loaded state)
+    void CopyFrom(const uint8_t *v1, const uint8_t *v2, const uint8_t *c) {
+        Sync();
+        std::memcpy(vram1.data(), v1, vram1.size());
+        std::memcpy(vram2.data(), v2, vram2.size());
+        std::memcpy(cram.data(), c, cram.size());
+    }
+
+private:
+    std::vector<Command> m_ring;
+    alignas(64) std::atomic<uint32_t> m_head{0};
+    alignas(64) std::atomic<uint32_t> m_tail{0};
+    alignas(64) std::atomic<uint32_t> m_done{0};
+    std::atomic<bool> m_sleeping{false}, m_stop{false};
+    std::mutex m_mutex;
+    std::condition_variable m_wake;
+    std::thread m_thread;
+
+    static void Relax() {
+#if defined(__arm__) || defined(__aarch64__)
+        __asm__ __volatile__("yield");
+#elif defined(__x86_64__) || defined(__i386__)
+        __builtin_ia32_pause();
+#endif
+    }
+
+    void Execute(const Command &cmd) {
+        video::Renderer &r = *renderer;
+        switch (cmd.op) {
+        case kVdp1Reg: r.WriteVdp1Reg(cmd.a, cmd.value); break;
+        case kVdp2Reg: r.WriteVdp2Reg(cmd.a, cmd.value); break;
+        case kErase: r.EraseFramebuffer(cmd.c); break;
+        case kSwap: r.SwapFramebuffer(); break;
+        case kBeginDrawing: r.BeginDrawing(); break;
+        case kDraw: r.DrawCommand(cmd.a); break;
+        case kEndDrawing: r.EndDrawing(); break;
+        case kResolution: r.SetResolution(cmd.a, static_cast<uint32_t>(cmd.c), cmd.flag != 0); break;
+        case kField: r.SetField(cmd.flag != 0); break;
+        case kLatch: r.LatchDisplayMode(); break;
+        case kBeginFrame: r.BeginFrame(); break;
+        case kLine: r.RenderLine(cmd.a); break;
+        case kVram1Write8: vram1[cmd.a] = static_cast<uint8_t>(cmd.value); break;
+        case kVram1Write16: Put16(&vram1[cmd.a], cmd.value); break;
+        case kVram2Write8: vram2[cmd.a] = static_cast<uint8_t>(cmd.value); r.NoteVideoMemoryWrite(); break;
+        case kVram2Write16: Put16(&vram2[cmd.a], cmd.value); r.NoteVideoMemoryWrite(); break;
+        case kCramWrite8: cram[cmd.a] = static_cast<uint8_t>(cmd.value); r.NoteVideoMemoryWrite(); break;
+        case kCramWrite16: Put16(&cram[cmd.a], cmd.value); r.NoteVideoMemoryWrite(); break;
+        default: break;
+        }
+    }
+
+    void Work() {
+        uint32_t tail = 0;
+        for (;;) {
+            uint32_t head = m_head.load(std::memory_order_acquire);
+            if (head == tail) {
+                // (a short wait in place first: the next line is usually a few microseconds away)
+                for (unsigned spins = 0; spins < 4000 && head == tail; spins++) {
+                    Relax();
+                    head = m_head.load(std::memory_order_acquire);
+                }
+                if (head == tail) {
+                    std::unique_lock<std::mutex> lock(m_mutex);
+                    m_sleeping.store(true, std::memory_order_seq_cst);
+                    m_wake.wait(lock, [&] {
+                        return m_head.load(std::memory_order_seq_cst) != tail || m_stop.load();
+                    });
+                    m_sleeping.store(false, std::memory_order_seq_cst);
+                    if (m_stop.load() && m_head.load() == tail) return;
+                    continue;
+                }
+            }
+            const auto start = std::chrono::steady_clock::now();
+            while (tail != head) {
+                Execute(m_ring[tail & (kSize - 1)]);
+                tail++;
+                m_tail.store(tail, std::memory_order_release);
+                if ((tail & 63) == 0) m_done.store(tail, std::memory_order_release);
+            }
+            m_done.store(tail, std::memory_order_release);
+            busyNs += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                std::chrono::steady_clock::now() - start).count());
+        }
+    }
+};
+
+// The machine's renderer thread, if it has one (one machine a process)
+extern VideoThread *g_thread;
+inline void SyncNow() {
+    if (g_thread) g_thread->Sync();
+}
+
+} // namespace satrecomp::machine::vt
+
+// A call to the renderer: queued when it has a thread of its own, made here and now otherwise
+#define SATRECOMP_VIDEO(PUSH, DIRECT)                                         \
+    do {                                                                      \
+        if (auto *vt_ = ::satrecomp::machine::vt::g_thread) {                 \
+            vt_->Push PUSH;                                                   \
+        } else {                                                              \
+            m_video->DIRECT;                                                  \
+        }                                                                     \
+    } while (0)
+// The renderer as it is after everything asked of it so far (before anything reads from it)
+#define SATRECOMP_VIDEO_SYNC() ::satrecomp::machine::vt::SyncNow()
