diff --git b/machine/sound_thread.h b/machine/sound_thread.h
new file mode 100644
index 0000000..b89bebd
--- /dev/null
+++ b/machine/sound_thread.h
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// SaturnTaisen GA36: the sound side (68000 and SCSP) on a core of its own (SATRECOMP_SOUND_THREAD=1).
+//
+// The sound side's samples are due at fixed times; the main side only meets it through its memory and
+// registers (0x05A00000-0x05BFFFFF), the SMPC's sound commands, the CD music it mixes in, and its interrupt
+// line to the SCU. So the machine queues "make the next n samples" and its own writes to the sound side, in
+// the order they happen, and a second thread works through them a little behind. Before the main side reads
+// anything there (or changes what the music source plays, or saves a state, or hands a frame to the port) it
+// waits for the queue to empty, which leaves the sound side exactly where it would be running in line. The
+// one thing that cannot wait is the interrupt line to the SCU: Sakura Taisen never raises it; if a game does,
+// the machine notices on its next turn (and reports it), a little later than the hardware would.
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace satrecomp::machine::st {
+
+enum Op : uint8_t { kSamples, kRamWrite8, kRamWrite16, kRegWrite8, kRegWrite16 };
+
+struct Command {
+    uint8_t op;
+    uint8_t pad;
+    uint16_t value;
+    uint32_t a;
+};
+static_assert(sizeof(Command) == 8);
+
+class SoundThread {
+public:
+    static constexpr uint32_t kSize = 1u << 16;
+    uint64_t commands = 0, syncs = 0, waitNs = 0, busyNs = 0, fullWaits = 0;
+    std::function<void(const Command &)> execute;
+
+    SoundThread() : m_ring(kSize) {}
+    ~SoundThread() { Stop(); }
+
+    void Start() { m_thread = std::thread([this] { Work(); }); }
+    void Stop() {
+        if (!m_thread.joinable()) return;
+        Sync();
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_stop.store(true);
+        }
+        m_wake.notify_one();
+        m_thread.join();
+    }
+    bool OnWorker() const { return std::this_thread::get_id() == m_thread.get_id(); }
+
+    void Push(uint8_t op, uint32_t a = 0, uint16_t value = 0) {
+        const uint32_t head = m_head.load(std::memory_order_relaxed);
+        if (head - m_tail.load(std::memory_order_acquire) >= kSize) [[unlikely]] {
+            fullWaits++;
+            while (head - m_tail.load(std::memory_order_acquire) >= kSize) Relax();
+        }
+        Command &cmd = m_ring[head & (kSize - 1)];
+        cmd.op = op;
+        cmd.value = value;
+        cmd.a = a;
+        m_head.store(head + 1, std::memory_order_seq_cst);
+        commands++;
+        if (m_sleeping.load(std::memory_order_seq_cst)) [[unlikely]] {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_wake.notify_one();
+        }
+    }
+
+    void Sync() {
+        const uint32_t head = m_head.load(std::memory_order_relaxed);
+        if (m_done.load(std::memory_order_acquire) == head) return;
+        syncs++;
+        const auto start = std::chrono::steady_clock::now();
+        for (unsigned spins = 0; m_done.load(std::memory_order_acquire) != head; spins++) {
+            if (spins < 20000) Relax();
+            else std::this_thread::yield();
+        }
+        waitNs += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now() - start).count());
+    }
+
+private:
+    std::vector<Command> m_ring;
+    alignas(64) std::atomic<uint32_t> m_head{0};
+    alignas(64) std::atomic<uint32_t> m_tail{0};
+    alignas(64) std::atomic<uint32_t> m_done{0};
+    std::atomic<bool> m_sleeping{false}, m_stop{false};
+    std::mutex m_mutex;
+    std::condition_variable m_wake;
+    std::thread m_thread;
+
+    static void Relax() {
+#if defined(__arm__) || defined(__aarch64__)
+        __asm__ __volatile__("yield");
+#elif defined(__x86_64__) || defined(__i386__)
+        __builtin_ia32_pause();
+#endif
+    }
+
+    void Work() {
+        uint32_t tail = 0;
+        for (;;) {
+            uint32_t head = m_head.load(std::memory_order_acquire);
+            if (head == tail) {
+                for (unsigned spins = 0; spins < 4000 && head == tail; spins++) {
+                    Relax();
+                    head = m_head.load(std::memory_order_acquire);
+                }
+                if (head == tail) {
+                    std::unique_lock<std::mutex> lock(m_mutex);
+                    m_sleeping.store(true, std::memory_order_seq_cst);
+                    m_wake.wait(lock, [&] { return m_head.load(std::memory_order_seq_cst) != tail || m_stop.load(); });
+                    m_sleeping.store(false, std::memory_order_seq_cst);
+                    if (m_stop.load() && m_head.load() == tail) return;
+                    continue;
+                }
+            }
+            const auto start = std::chrono::steady_clock::now();
+            while (tail != head) {
+                execute(m_ring[tail & (kSize - 1)]);
+                tail++;
+                m_tail.store(tail, std::memory_order_release);
+                if ((tail & 15) == 0) m_done.store(tail, std::memory_order_release);
+            }
+            m_done.store(tail, std::memory_order_release);
+            busyNs += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                std::chrono::steady_clock::now() - start).count());
+        }
+    }
+};
+
+// The machine's sound thread, if it has one (one machine a process)
+extern SoundThread *g_thread;
+inline void SyncNow() {
+    if (g_thread) g_thread->Sync();
+}
+
+} // namespace satrecomp::machine::st
