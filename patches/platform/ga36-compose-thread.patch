+// ---------------------------------------------------------------------------------------------------------
+// GA36: the lean composition of a line (no HD presentation capture), on this thread or, with
+// SATRECOMP_COMPOSE_THREAD=1, on a core of its own a few lines behind. A queued line carries copies of all it
+// reads (the layers' and the sprites' lines, the colour calculation window, the registers it uses), so the
+// pixels are the same whichever thread makes them. Whatever reads or resizes the picture waits for the queue.
+namespace {
+struct LeanLine {
+    uint32 *out = nullptr;
+    uint32 width = 0, back = 0, count = 0;
+    uint32 enabled[5] = {};
+    bool spritesOn = false, calcExtended = false, calcAdd = false, secondRatio = false, spriteLineColor = false,
+         spriteWindow = false;
+    bool layerCalc[8] = {}, layerShadow[8] = {}, offsetOn[8] = {};
+    uint8 calcRatio[8] = {};
+    sint32 offset[8][3] = {};
+    const uint32 *color[8] = {};
+    const uint8 *priority[8] = {};
+    const uint32 *spriteColor = nullptr;
+    const uint8 *spritePriority = nullptr, *spriteSpecial = nullptr, *spriteSow = nullptr, *spriteCalcEnable = nullptr,
+                *spriteCalcRatio = nullptr, *calcWindow = nullptr;
+    // (a queued line's buffers: swapped with the renderer's, so nothing is copied)
+    std::vector<uint32> layerColor[6], spriteColorLine;
+    std::vector<uint8> layerPriority[6], spriteBytes[5], calcWindowLine;
+};
+
+void LeanCompose(const LeanLine &L) {
+    constexpr uint32 kSprites = 0, kBack = 6;
+    const auto normal = static_cast<uint8>(SpriteSpecial::Normal);
+    const auto shadowDot = static_cast<uint8>(SpriteSpecial::Shadow);
+    const Color888 back{.u32 = L.back};
+    for (uint32 x = 0; x < L.width; x++) {
+        uint32 top = kBack, topPriority = 0, second = kBack, secondPriority = 0;
+        for (uint32 i = 0; i < L.count; i++) {
+            const uint32 layer = L.enabled[i];
+            const uint8 priority = L.priority[layer][x];
+            if (priority > topPriority) {
+                second = top;
+                secondPriority = topPriority;
+                top = layer;
+                topPriority = priority;
+            } else if (priority > secondPriority) {
+                second = layer;
+                secondPriority = priority;
+            }
+        }
+        const uint8 special = L.spriteSpecial[x];
+        if (L.spritesOn && special == normal) {
+            const uint32 priority = L.spritePriority[x];
+            if (priority && priority >= topPriority) {
+                second = top;
+                top = kSprites;
+            } else if (priority && priority >= secondPriority) {
+                second = kSprites;
+            }
+        }
+        Color888 color = top == kBack ? back : top == kSprites ? Color888{.u32 = L.spriteColor[x]} : Color888{.u32 = L.color[top][x]};
+        const bool calcTop = top == kSprites ? L.spriteCalcEnable[x] && !L.spriteLineColor : L.layerCalc[top];
+        if (calcTop && !L.calcExtended && !L.calcWindow[x]) {
+            const Color888 below = second == kBack ? back : second == kSprites ? Color888{.u32 = L.spriteColor[x]} : Color888{.u32 = L.color[second][x]};
+            const uint32 ratioLayer = L.secondRatio ? second : top;
+            const uint32 ratio = ratioLayer == kSprites ? L.spriteCalcRatio[x] : L.calcRatio[ratioLayer];
+            const bool add = L.calcAdd;
+            auto mix = [&](uint32 a, uint32 b) {
+                return add ? std::min(a + b, 255u) : (a * (31u - ratio) + b * (ratio + 1u)) >> 5;
+            };
+            color.u32 = mix(color.r, below.r) | (mix(color.g, below.g) << 8) | (mix(color.b, below.b) << 16);
+        }
+        if (L.offsetOn[top]) {
+            auto shift = [](uint32 channel, sint32 by) { return static_cast<uint32>(std::clamp<sint32>(static_cast<sint32>(channel) + by, 0, 255)); };
+            color.u32 = shift(color.r, L.offset[top][0]) | (shift(color.g, L.offset[top][1]) << 8) | (shift(color.b, L.offset[top][2]) << 16);
+        }
+        if (special == shadowDot || (!L.spriteWindow && L.spriteSow[x])) {
+            const bool takesShadow = top == kSprites ? static_cast<bool>(L.spriteSow[x]) : L.layerShadow[top];
+            if (takesShadow) {
+                color.u32 = (color.u32 >> 1) & 0x7F7F7F7F;
+            }
+        }
+        L.out[x] = color.u32;
+    }
+}
+
+class LeanWorker {
+public:
+    static constexpr uint32 kJobs = 512;
+    uint64_t lines = 0, drains = 0, drainNs = 0, fullWaits = 0;
+
+    LeanWorker() : m_jobs(kJobs) { m_thread = std::thread([this] { Work(); }); }
+    ~LeanWorker() {
+        Drain();
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_stop.store(true);
+        }
+        m_wake.notify_one();
+        m_thread.join();
+    }
+    // A free slot for the next line (filled by the caller, then Commit)
+    LeanLine &Slot() {
+        const uint32 head = m_head.load(std::memory_order_relaxed);
+        if (head - m_tail.load(std::memory_order_acquire) >= kJobs) [[unlikely]] {
+            fullWaits++;
+            while (head - m_tail.load(std::memory_order_acquire) >= kJobs) Relax();
+        }
+        return m_jobs[head & (kJobs - 1)];
+    }
+    void Commit() {
+        m_head.store(m_head.load(std::memory_order_relaxed) + 1, std::memory_order_seq_cst);
+        lines++;
+        if (m_sleeping.load(std::memory_order_seq_cst)) [[unlikely]] {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_wake.notify_one();
+        }
+    }
+    void Drain() {
+        const uint32 head = m_head.load(std::memory_order_relaxed);
+        if (m_tail.load(std::memory_order_acquire) == head) return;
+        drains++;
+        const auto start = std::chrono::steady_clock::now();
+        for (unsigned spins = 0; m_tail.load(std::memory_order_acquire) != head; spins++) {
+            if (spins < 20000) Relax();
+            else std::this_thread::yield();
+        }
+        drainNs += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now() - start).count());
+    }
+
+private:
+    std::vector<LeanLine> m_jobs;
+    alignas(64) std::atomic<uint32> m_head{0};
+    alignas(64) std::atomic<uint32> m_tail{0};
+    std::atomic<bool> m_sleeping{false}, m_stop{false};
+    std::mutex m_mutex;
+    std::condition_variable m_wake;
+    std::thread m_thread;
+
+    static void Relax() {
+#if defined(__arm__) || defined(__aarch64__)
+        __asm__ __volatile__("yield");
+#elif defined(__x86_64__) || defined(__i386__)
+        __builtin_ia32_pause();
+#endif
+    }
+    void Work() {
+        uint32 tail = 0;
+        for (;;) {
+            uint32 head = m_head.load(std::memory_order_acquire);
+            if (head == tail) {
+                for (unsigned spins = 0; spins < 4000 && head == tail; spins++) {
+                    Relax();
+                    head = m_head.load(std::memory_order_acquire);
+                }
+                if (head == tail) {
+                    std::unique_lock<std::mutex> lock(m_mutex);
+                    m_sleeping.store(true, std::memory_order_seq_cst);
+                    m_wake.wait(lock, [&] { return m_head.load(std::memory_order_seq_cst) != tail || m_stop.load(); });
+                    m_sleeping.store(false, std::memory_order_seq_cst);
+                    if (m_stop.load() && m_head.load() == tail) return;
+                    continue;
+                }
+            }
+            while (tail != head) {
+                LeanCompose(m_jobs[tail & (kJobs - 1)]);
+                tail++;
+                m_tail.store(tail, std::memory_order_release);
+            }
+        }
+    }
+};
+
+LeanWorker *g_leanWorker = nullptr;
+bool g_leanWorkerChecked = false;
+
+inline void LeanDrain() {
+    if (g_leanWorker) g_leanWorker->Drain();
+}
+} // namespace
+
+// (the machine stops it when it goes away: queued lines point into a renderer)
+void StopComposeThread() {
+    if (g_leanWorker) {
+        if (std::getenv("SATRECOMP_VIDEO_THREAD_STATS")) {
+            fprintf(stderr, "compose thread: %llu lines, %llu waits for it (%.1f ms), %llu times full\n",
+                    static_cast<unsigned long long>(g_leanWorker->lines), static_cast<unsigned long long>(g_leanWorker->drains),
+                    g_leanWorker->drainNs / 1e6, static_cast<unsigned long long>(g_leanWorker->fullWaits));
+        }
+        delete g_leanWorker;
+        g_leanWorker = nullptr;
+    }
+}
