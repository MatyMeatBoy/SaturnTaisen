diff --git a/port/window_policy.h b/port/window_policy.h
new file mode 100644
index 0000000..e9cae66
--- /dev/null
+++ b/port/window_policy.h
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: GPL-3.0-only
+#pragma once
+namespace port {
+// Whether the game window opens borderless over the display (SDL3 fullscreen at the desktop's own mode, the picture
+// still at an integer scale, F11 toggles). It does by default; --windowed, headless runs and the hidden test
+// windows keep an ordinary window, and --fullscreen (or launcher.ini's video fullscreen, which passes it) always asks.
+inline bool StartsBorderless(bool fullscreenRequested, bool windowedRequested, bool testOrHeadless) {
+    if (fullscreenRequested) return true;
+    return !windowedRequested && !testOrHeadless;
+}
+}
