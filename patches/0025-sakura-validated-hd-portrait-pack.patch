     uint64_t BackgroundPaletteFingerprint() const {
         const auto& bg=m_regs2.bgParams[4];
         const uint32 name=bg.twoWordChar?Vram2Long(bg.pageBaseAddresses[0]):Vram2Word(bg.pageBaseAddresses[0]);
