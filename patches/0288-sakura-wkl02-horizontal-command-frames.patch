+inline constexpr int kHorizontalCommandMaskStride = 120;
+inline constexpr int kHorizontalCommandHeight = 32;
+
+inline constexpr int HorizontalCommandPixel(int x, int y, int width) {
+    return x >= 0 && x < width && width <= kHorizontalCommandMaskStride &&
+        y >= 0 && y < kHorizontalCommandHeight ? y * kHorizontalCommandMaskStride + x : -1;
+}
