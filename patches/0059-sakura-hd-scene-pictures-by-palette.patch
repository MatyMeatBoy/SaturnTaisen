 #include <map>
@@ -570,6 +572,10 @@ int RunWindowed(Port &port) {
     // The software picture through the SDL renderer, fitted as the Display page says
     ParallelRows parallelRows;
     struct HeldZoom {bool valid=false;int x=0,width=0,lines=0,group=0,shadowRows=0;} heldZoom;
+    // T74: the PC picture of a recognised Saturn scene picture (palette fingerprint -> PC SPR), loaded once.
+    struct SceneHd {uint64_t palette=0;SDL_Texture* texture=nullptr;bool tried=false;};
+    std::vector<SceneHd> sceneHd(kSceneBgCount);
+    std::vector<uint32_t> sceneHdForeground;
     auto showSoftware = [&]() {
         ProfileScope presentScope(frameProfile.present);
         if (!renderer) {
@@ -1113,8 +1119,55 @@ int RunWindowed(Port &port) {
                             SDL_RenderFillRect(renderer,&shadow);
                             SDL_SetRenderDrawBlendMode(renderer,SDL_BLENDMODE_NONE);
                         }
-                        if(!uploadLayer(pictureMixTexture,pictureMixWidth,pictureMixHeight,pictureMixPixels,zoom.picture,imageCrop,zoomForeground))
-                            SDL_RenderTexture(renderer,content,&imageCrop,&imageTarget);
+                        if(!uploadLayer(pictureMixTexture,pictureMixWidth,pictureMixHeight,pictureMixPixels,zoom.picture,imageCrop,zoomForeground)) {
+                            // T74: when the picture on screen is a recognised Saturn scene picture and nothing
+                            // blends over it, draw the PC picture under the native overlays (actors, clock).
+                            bool drewHd=false;
+                            if(!port.opt.pcAssetsPath.empty() && satrecomp::FeatureValue("pc_hd_backgrounds")==0 && port.videoRenderer &&
+                               planes.source.size()==320*224) {
+                                for(const uint32_t layer:{2u,4u}) {
+                                    if(drewHd)break;
+                                    const uint64_t fingerprint=port.videoRenderer->BackgroundPaletteFingerprint(layer);
+                                    unsigned slot=kSceneBgCount;
+                                    for(unsigned i=0;i<kSceneBgCount;i++)if(kSceneBg[i].palette==fingerprint) {slot=i;break;}
+                                    if(slot==kSceneBgCount)continue;
+                                    const auto offset=port.videoRenderer->BackgroundColorOffset(layer);
+                                    if(offset[0]||offset[1]||offset[2])continue;
+                                    unsigned visible=0;
+                                    for(int y=8;y<152;y++)for(int x=16;x<304;x++)visible+=planes.source[size_t(y)*320+x]==layer;
+                                    if(visible<12000)continue;
+                                    auto& hd=sceneHd[slot];
+                                    if(!hd.tried) {
+                                        hd.tried=true;
+                                        const auto& entry=kSceneBg[slot];
+                                        std::vector<uint8_t> bytes;
+                                        if(ReadPcBackdropFile(std::filesystem::u8path(port.opt.pcAssetsPath)/entry.file,bytes,64u<<20)) {
+                                            std::vector<PcSprite> images;std::string error;
+                                            if(DecodePcSprites(bytes,images,error))
+                                                for(const auto& image:images)if(image.index==entry.index && image.width && image.height) {
+                                                    if(auto* texture=SDL_CreateTexture(renderer,SDL_PIXELFORMAT_ABGR8888,SDL_TEXTUREACCESS_STATIC,int(image.width),int(image.height))) {
+                                                        if(SDL_UpdateTexture(texture,nullptr,image.pixels.data(),int(image.width*4))) {
+                                                            SDL_SetTextureScaleMode(texture,SDL_SCALEMODE_LINEAR);hd.texture=texture;
+                                                        } else SDL_DestroyTexture(texture);
+                                                    }
+                                                    break;
+                                                }
+                                        }
+                                        if(std::getenv("SATRECOMP_BACKGROUND_STATS")){fprintf(stderr,"scene picture: %s usable=%d",entry.file,hd.texture!=nullptr);fputc(10,stderr);}
+                                    }
+                                    if(!hd.texture)continue;
+                                    sceneHdForeground=zoomForeground;
+                                    for(int y=8;y<152;y++)for(int x=16;x<304;x++)
+                                        if(planes.source[size_t(y)*320+x]==layer)sceneHdForeground[size_t(y)*320+x]=0;
+                                    SDL_RenderTexture(renderer,hd.texture,nullptr,&imageTarget);
+                                    SDL_UpdateTexture(content,nullptr,sceneHdForeground.data(),320*sizeof(uint32_t));
+                                    SDL_RenderTexture(renderer,content,&imageCrop,&imageTarget);
+                                    SDL_UpdateTexture(content,nullptr,zoomForeground.data(),320*sizeof(uint32_t));
+                                    drewHd=true;
+                                }
+                            }
+                            if(!drewHd)SDL_RenderTexture(renderer,content,&imageCrop,&imageTarget);
+                        }
                         crop.x=float(zoomX);crop.w=float(zoomW);crop.y=153;crop.h=float(zoomLines);fit=zoom.dialogue;
                         if(std::getenv("SATRECOMP_PRESENTATION_TRACE")) {
                             static bool logged=false;if(!logged) {logged=true;fprintf(stderr,"scene zoom: image=%dx%d scale=%d dialogue=%dx%d scale=%d y=%d shadow=%d\n",zoom.picture.w,zoom.picture.h,zoom.picture.scale,fit.w,fit.h,fit.scale,fit.y,zoom.shadow);}
